    exact (Nat.mul_le_mul_right _ hprevM).trans_eq (Nat.mul_comm _ _)
  let A := 2 ^ (4 * M * Nat.size (M + 1))
  let Astep := 2 ^ (4 * n * Nat.size (n + 1))
  have hH : 4 * n * Nat.size (n + 1) ≤ 4 * M * Nat.size (M + 1) :=
