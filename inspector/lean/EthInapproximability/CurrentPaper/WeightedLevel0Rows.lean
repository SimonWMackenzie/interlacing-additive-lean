/-- Phase-1 exit (raw words + vertex word) on the combined bank. -/
def C1def (G : EndpointGraph V E) (n c : ℕ) : CStack → List Bool :=
  bank rawEmb (startC (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G))))
