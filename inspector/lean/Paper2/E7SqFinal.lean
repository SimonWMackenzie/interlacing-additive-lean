/-!
# Paper A (lock v12), lane `owner:a-eth-7`, segment 6f: the square power-of-two option of T24, class level

Lock v12 `sections/06-reduction.tex:115-116` (`thm:quantitative`): "The conclusion also holds when the inputs are
square matrices of power-of-two side length." Proof `:143-148`: "To obtain a square power-of-two table, let $S$ be
the least power of two at least $m_Y$, and repeat rows and columns until both dimensions are $S$. Every original
row and column is retained, so these repetitions preserve communication complexity exactly."

Text of the frozen a-eth-owner-6 `E6Final` (from `cutN` to `T24_class_effective_final_discharged`), generated by
`make_sqfinal.py`: the composite decider is the SQUARE decider `decAlgSq` (header tail with the admitted square
post machine `Paper2.ASquare.Post.squareMachine`), the error transfer is `decider_error_joinAt_sq`, the estimator
hypothesis is the a-eth-owner-2 `Paper2.AEth2.EstimatesGrowingSelSq` (required ONLY on square power-of-two
words), and the clock is `decTimeSq_budget` (which needs no cutoff on `N₁`, so the clock term of `cutN` is
dropped). The T03 variant is not stated: `intro:quantitative` (T03) has no square sentence.

* `growDecSq_sparse`: for every estimator with `EstimatesGrowingSelSq E c` and EVERY density `cs`, the ONE fixed
  square composite decider is an R20 sparse decider at density `cs`.
* **`T24_square_class_final`**: under `hETH : RandomizedSparseETH_R20`, no selected-tape estimator with
  `EstimatesGrowingSelSq E c` (`0 ≤ c < 1/12`); premises exactly those of `Paper2.AEth6.T24_class_final`.
* `T24_square_class_effective_final_discharged`: the conclusion of a-eth-owner-2
  `Paper2.AEth2.T24_square_class_effective_final` WITHOUT its `hAsm` premise.

No ledger row is closed. Nothing here is admitted.
-/

noncomputable section

namespace Paper2.AEth7

open EthInapproximability.CurrentPaper
open EthInapproximability.CurrentPaper.EncodedETHSource
open EthInapproximability.CurrentPaper.EncodedETHSourceComposition
open Paper2 Paper2.Unit4Shell.T10Finite Paper2.Unit4Shell.Asymptotics
open Paper2.AEth Paper2.AEth2 Paper2.AEth4 Paper2.AEth5 Paper2.AEth6

variable (D : DinurReduction) (B : BOTReduction (booleanOccurrence D))

/-- The internal cutoff of the composite decider for estimator `E`, density `cs`, gap constant `c`. -/
def cutNSq (E : SelectedTape.Algorithm) (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) : ℕ :=
  max 1 (max (N0Sq D B (Paper2.HeaderStrip.selectedClassifier E) (cs + 2))
    (Classical.choose (decider_error_joinAt_sq D B (cs + 2) c hc0 hc)))

theorem cutNSq_pos (E : SelectedTape.Algorithm) (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    1 ≤ cutNSq D B E cs c hc0 hc := le_max_left _ _

theorem cutNSq_N0 (E : SelectedTape.Algorithm) (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    N0Sq D B (Paper2.HeaderStrip.selectedClassifier E) (cs + 2) ≤ cutNSq D B E cs c hc0 hc :=
  le_trans (le_max_left _ _) (le_max_right _ _)

theorem cutNSq_K (E : SelectedTape.Algorithm) (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    2 ≤ (cs + 2) * cutNSq D B E cs c hc0 hc := by
  have := cutNSq_pos D B E cs c hc0 hc
  nlinarith

/-- **THE composite SQUARE growing-gap decider** (R20 carrier; header tail `hdTailSq` with the admitted square
post machine `Paper2.ASquare.Post.squareMachine`) for estimator `E` and density `cs`. -/
def growDecSq (E : SelectedTape.Algorithm) (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    ETape.Algorithm :=
  decAlgSq D B (Paper2.HeaderStrip.selectedClassifier E) (cs + 2) (cutNSq D B E cs c hc0 hc)
    (cutNSq_pos D B E cs c hc0 hc) (cutNSq_N0 D B E cs c hc0 hc) (cutNSq_K D B E cs c hc0 hc)

set_option maxHeartbeats 1000000 in
/-- **Segment 6f: the square composite decider is an R20 sparse decider at density `cs`.** -/
theorem growDecSq_sparse (E : SelectedTape.Algorithm) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12)
    (hE : EstimatesGrowingSelSq E c) (cs : ℕ) :
    SparseDeciderR20 cs (growDecSq D B E cs c hc0 hc) := by
  have hN₁ := cutNSq_pos D B E cs c hc0 hc
  have hN := cutNSq_N0 D B E cs c hc0 hc
  have hK := cutNSq_K D B E cs c hc0 hc
  have herr := Classical.choose_spec (decider_error_joinAt_sq D B (cs + 2) c hc0 hc)
  have hNerr : Classical.choose (decider_error_joinAt_sq D B (cs + 2) c hc0 hc) ≤ cutNSq D B E cs c hc0 hc :=
    le_trans (le_max_right _ _) (le_max_right _ _)
  refine ⟨fun input hwf hsp => ?_, fun ε hε => ?_⟩
  · obtain ⟨Φ, rfl⟩ := hwf
    rw [ADecider.cnfClauseCount_encode, ADecider.variableCount_encode] at hsp
    have hspK : Φ.val.clauses.length ≤ (cs + 2) * Φ.val.variables :=
      le_trans hsp (Nat.mul_le_mul_right _ (by omega))
    set Φ' := routedV (cs + 2) (cutNSq D B E cs c hc0 hc) hN₁ (EncodedCNF.encode Φ.val) with hΦ'
    have hJ := decAlgSq_joinAt D B E (cs + 2) (cutNSq D B E cs c hc0 hc) hN₁ hN hK (EncodedCNF.encode Φ.val)
    have hsp' : Φ'.val.clauses.length ≤ (cs + 2) * Φ'.val.variables :=
      routed4_sparse (cs + 2) (cutNSq D B E cs c hc0 hc) hK _
    have hv' : cutNSq D B E cs c hc0 hc ≤ Φ'.val.variables := routed4_variables _ _ _
    have h := herr Φ' hsp' (le_trans hNerr hv') E (growDecSq D B E cs c hc0 hc)
      (EncodedCNF.encode Φ.val) hE hJ
    have hlang : EncodedCNF.encode Φ'.val ∈ EncodedCNF.Language ↔
        EncodedCNF.encode Φ.val ∈ EncodedCNF.Language := by
      rw [EncodedCNF.encode_mem_iff Φ'.val Φ'.property]
      exact routed4_sat_iff (cs + 2) hN₁ Φ.val Φ.property hspK
    exact ⟨fun hin => h.1 (hlang.2 hin), fun hout => h.2 (fun h' => hout (hlang.1 h'))⟩
  · obtain ⟨C', d, N₂, hb⟩ := decTimeSq_budget D B (Paper2.HeaderStrip.selectedClassifier E) (cs + 2)
      (cutNSq D B E cs c hc0 hc) hN₁ hK ε hε
    refine ⟨C', d, N₂, fun input hwf hsp hN2 => ?_⟩
    obtain ⟨Φ, rfl⟩ := hwf
    rw [ADecider.cnfClauseCount_encode, ADecider.variableCount_encode] at hsp
    rw [ADecider.variableCount_encode] at hN2 ⊢
    have hspK : Φ.val.clauses.length ≤ (cs + 2) * Φ.val.variables :=
      le_trans hsp (Nat.mul_le_mul_right _ (by omega))
    exact hb Φ hspK hN2

include D B in
/-- **T24, square power-of-two option, class level, R20 carrier, final** (`0 ≤ c < 1/12`; lock v12
`thm:quantitative`, `06-reduction.tex:115-116`). Under randomized sparse ETH (R20 carrier, D-A6) there is NO
selected-tape estimator (R19 carrier) with additive error `c log T / log log T` on every square power-of-two
matrix word (`Paper2.AEth2.EstimatesGrowingSelSq`: required only on `Paper2.ADecider.SquareWord` words).
Remaining premises: the records `D : DinurReduction`, `B : BOTReduction (booleanOccurrence D)` (D-A7);
D-A2 is the language `EncodedCNF.Language`; D-A6 is the shape of `RandomizedSparseETH_R20`. -/
theorem T24_square_class_final (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12)
    (hETH : RandomizedSparseETH_R20) :
    ¬ ∃ E : SelectedTape.Algorithm, EstimatesGrowingSelSq E c := by
  rintro ⟨E, hE⟩
  exact (not_R20_iff.2 (fun cs => ⟨growDecSq D B E cs c hc0 hc, growDecSq_sparse D B E c hc0 hc hE cs⟩)) hETH

include D B in
/-- T24 (square option) in contrapositive form: a square-word estimator refutes randomized sparse ETH in the R20 carrier, the
a-eth-owner-1 carrier, the prefix carrier and the DRAFT shape. -/
theorem T24_square_refutes (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12)
    (hE : ∃ E : SelectedTape.Algorithm, EstimatesGrowingSelSq E c) :
    ¬ RandomizedSparseETH_R20 ∧ ¬ Paper2.AEth.RandomizedSparseETH_effective ∧
      ¬ Paper2.AModel.RandomizedSparseETH ∧
      ¬ Paper2.Unit4Shell.Definitions.RandomizedSparseETH EncodedCNF.Language
        Paper2.AModel.WellFormedCNF EncodedETHTail.variableCount Paper2.AModel.cnfClauseCount
        (1 / 3) true := by
  have h : ¬ RandomizedSparseETH_R20 := fun hETH => T24_square_class_final D B c hc0 hc hETH hE
  exact ⟨h, not_old_of_not_R20 h, not_prefix_of_not_R20 h, not_draft_of_not_R20 h⟩

include D B in
/-- The conclusion of a-eth-owner-2 `Paper2.AEth2.T24_square_class_effective_final` WITHOUT its `hAsm` premise (the composite
decider replaces the assembly statement); an alias of `T24_square_refutes`. -/
theorem T24_square_class_effective_final_discharged (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12)
    (hE : ∃ E : SelectedTape.Algorithm, EstimatesGrowingSelSq E c) :
    ¬ RandomizedSparseETH_R20 ∧ ¬ Paper2.AEth.RandomizedSparseETH_effective ∧
      ¬ Paper2.AModel.RandomizedSparseETH ∧
      ¬ Paper2.Unit4Shell.Definitions.RandomizedSparseETH EncodedCNF.Language
        Paper2.AModel.WellFormedCNF EncodedETHTail.variableCount Paper2.AModel.cnfClauseCount
        (1 / 3) true :=
  T24_square_refutes D B c hc0 hc hE

end Paper2.AEth7

