variable {K : Type} [DecidableEq K]

def pushN (a : K) (k : ℕ) (q : TM2.Stmt (fun _ : K => Bool) Unit Bool) :
    TM2.Stmt (fun _ : K => Bool) Unit Bool :=
  match k with
  | 0 => q
  | k + 1 => TM2.Stmt.push a (fun _ => true) (pushN a k q)

def pushP (a : K) (k : ℕ) : Unit → TM2.Stmt (fun _ : K => Bool) Unit Bool := fun _ =>
  pushN a k TM2.Stmt.halt

theorem pushN_step (a : K) (k : ℕ) (q : TM2.Stmt (fun _ : K => Bool) Unit Bool) (v : Bool)
    (S : K → List Bool) :
    TM2.stepAux (pushN a k q) v S =
      TM2.stepAux q v (Function.update S a (List.replicate k true ++ S a)) := by
  induction k generalizing S with
  | zero => simp [pushN]
  | succ k ih =>
      show TM2.stepAux (pushN a k q) v (Function.update S a (true :: S a)) = _
      rw [ih, Function.update_self, Function.update_idem]
      congr 2
      rw [List.replicate_succ', List.append_assoc]
      rfl

theorem pushS (a : K) (k : ℕ) (S : K → List Bool) (v : Bool) (h : S a = []) :
    ((advance (pushP a k))^[1]) (⟨some (), v, S⟩ : TM2.Cfg (fun _ : K => Bool) Unit Bool) =
      ⟨none, v, Function.update S a (u k)⟩ := by
  show Option.getD (some (TM2.stepAux (pushN a k TM2.Stmt.halt) v S))
    (⟨some (), v, S⟩ : TM2.Cfg (fun _ : K => Bool) Unit Bool) = _
  rw [pushN_step, h, List.append_nil]
  rfl

def maxProgram (ι : Fin 5 ↪ K) :
    ETHParameterScaleMachineMax.Label →
      TM2.Stmt (fun _ : K => Bool) ETHParameterScaleMachineMax.Label
        ETHParameterScaleMachineMax.Control :=
  fun l => stackStmt ι (ETHParameterScaleMachineMax.program l)

theorem max_lift (ι : Fin 5 ↪ K) (S : K → List Bool) (x y : ℕ)
    (h0 : S (ι 0) = u x) (h1 : S (ι 1) = u y) (h2 : S (ι 2) = []) (h3 : S (ι 3) = [])
    (h4 : S (ι 4) = []) :
    ((advance (maxProgram ι))^[max x y + x + y + 3])
        (⟨some .scan, (none, none), S⟩ : TM2.Cfg (fun _ : K => Bool)
          ETHParameterScaleMachineMax.Label ETHParameterScaleMachineMax.Control) =
      ⟨none, (none, none), Function.update S (ι 4) (u (max x y))⟩ := by
  let c := ETHParameterScaleMachineMax.cfg (some .scan) (none, none)
    (List.replicate x true) (List.replicate y true) [] [] []
  have hstart : stackCfg ι S c =
      (⟨some .scan, (none, none), S⟩ : TM2.Cfg (fun _ : K => Bool)
        ETHParameterScaleMachineMax.Label ETHParameterScaleMachineMax.Control) := by
    dsimp [stackCfg, c, ETHParameterScaleMachineMax.cfg]
    congr 1
    apply bank_eq_self
    intro k
    fin_cases k <;> simp [h0, h1, h2, h3, h4, u]
  have hrun := BitMachineStackRun.run ι S ETHParameterScaleMachineMax.program c
    (max x y + x + y + 3)
  rw [hstart] at hrun
  change _ = stackCfg ι S (ETHParameterScaleMachineMax.run (max x y + x + y + 3) c) at hrun
  have hm := ETHParameterScaleMachineMax.max_run (List.replicate x true) (List.replicate y true)
  simp only [List.length_replicate] at hm
  rw [show c = ETHParameterScaleMachineMax.cfg (some .scan) (none, none)
      (List.replicate x true) (List.replicate y true) [] [] [] from rfl, hm] at hrun
  refine hrun.trans ?_
  dsimp [stackCfg, ETHParameterScaleMachineMax.cfg]
  congr 1
  have hloc : (![List.replicate x true, List.replicate y true, [], [],
      List.replicate (max x y) true] : Fin 5 → List Bool) =
      Function.update (fun k : Fin 5 => S (ι k)) 4 (u (max x y)) := by
    funext k
    fin_cases k <;> simp [h0, h1, h2, h3, u]
  rw [hloc, bank_update, bank_restrict]

theorem mulS (c : Fin 6 → K) (hc : Function.Injective c) (S : K → List Bool) (r w : ℕ)
    (h0 : S (c 0) = u r) (h1 : S (c 1) = u w) (h2 : S (c 2) = []) (h3 : S (c 3) = [])
    (h4 : S (c 4) = []) (h5 : S (c 5) = []) :
    ((advance (MatrixStage4ScalarPreparationOps.multiplyProgram ⟨c, hc⟩))^[
        MatrixAddressMachine.exactTime r w 0])
      (⟨some .outer, false, S⟩ : TM2.Cfg (fun _ : K => Bool) MatrixAddressMachine.Label Bool) =
      ⟨none, false, Function.update S (c 5) (u (r * w))⟩ := by
  have h := MatrixStage4ScalarPreparationOps.multiply_run ⟨c, hc⟩ S r w h0 h1 h2 h3 h4
  rw [h]
  change (⟨none, false, Function.update S (c 5) (List.replicate (r * w) true ++ S (c 5))⟩ :
    TM2.Cfg (fun _ : K => Bool) MatrixAddressMachine.Label Bool) = _
  rw [h5, List.append_nil]
  rfl

theorem maxS (c : Fin 5 → K) (hc : Function.Injective c) (S : K → List Bool) (x y : ℕ)
    (h0 : S (c 0) = u x) (h1 : S (c 1) = u y) (h2 : S (c 2) = []) (h3 : S (c 3) = [])
    (h4 : S (c 4) = []) :
    ((advance (maxProgram ⟨c, hc⟩))^[max x y + x + y + 3])
        (⟨some .scan, (none, none), S⟩ : TM2.Cfg (fun _ : K => Bool)
          ETHParameterScaleMachineMax.Label ETHParameterScaleMachineMax.Control) =
      ⟨none, (none, none), Function.update S (c 4) (u (max x y))⟩ :=
  max_lift ⟨c, hc⟩ S x y h0 h1 h2 h3 h4

theorem powS (c : MatrixUnaryPower.Stack → K) (hc : Function.Injective c) (S : K → List Bool)
    (a : ℕ) (ha : S (c (.inr ())) = u a) (h0 : S (c (.inl 0)) = []) (h1 : S (c (.inl 1)) = [])
    (h2 : S (c (.inl 2)) = []) :
    ∃ t ≤ 4 * 2 ^ a + 5 * a + 7,
      ((advance (MatrixStage4ScalarPreparationOps.unaryPowerProgram ⟨c, hc⟩))^[t])
        (⟨some (.inr false), ((false, false), none), S⟩ :
          TM2.Cfg (fun _ : K => Bool) MatrixUnaryPower.Label MatrixUnaryPower.Control) =
        ⟨none, ((false, false), none), Function.update S (c (.inl 0)) (u (2 ^ a))⟩ :=
  MatrixStage4ScalarPreparationOps.unary_power_run ⟨c, hc⟩ S a ha h0 h1 h2

