/-- **Square header transport** along `O = S` (used with `experiment_output_eq_select`). -/
theorem hw_transport_sq (O S : TotalFiniteConstructorScratch.SelectedOutput) (hOS : O = S)
    (hinj : Function.Injective O.tapeBits) (k : ℕ) (b : O.Tape) (t' : S.Tape)
    (hb : O.tapeBits b = S.tapeBits t') :
    EncodedCommunication.natField (2 * O.budget + k) ++
        Paper2.AModel.matrixWord (SquarePadding.side O.rows O.cols) (SquarePadding.side O.rows O.cols)
          (MatrixMaterialization.rowMajor (Paper2.ASquare.squareTable O b)) =
      EncodedCommunication.natField (2 * S.budget + k) ++
        AFront.Projection.matrixWord (SquarePadding.side S.rows S.cols) (SquarePadding.side S.rows S.cols)
          (MatrixMaterialization.rowMajor (Paper2.ASquare.squareFun S.rows S.cols (S.table t').bits)) := by
  subst hOS
  have := hinj hb
  subst this
  rfl

theorem len_transport_sq (O S : TotalFiniteConstructorScratch.SelectedOutput) (hOS : O = S) (k : ℕ)
    (b : O.Tape) :
    (EncodedCommunication.natField (2 * O.budget + k) ++
        Paper2.AModel.matrixWord (SquarePadding.side O.rows O.cols) (SquarePadding.side O.rows O.cols)
          (MatrixMaterialization.rowMajor (Paper2.ASquare.squareTable O b))).length =
      (EncodedCommunication.natField (2 * S.budget + k)).length +
        ((EncodedCommunication.natField (SquarePadding.side S.rows S.cols)).length +
          (EncodedCommunication.natField (SquarePadding.side S.rows S.cols)).length +
          SquarePadding.side S.rows S.cols * SquarePadding.side S.rows S.cols) := by
  subst hOS
  simp only [Paper2.AModel.matrixWord, List.length_append, MatrixMaterialization.rowMajor_length]

