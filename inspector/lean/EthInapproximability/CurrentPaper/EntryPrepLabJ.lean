  obtain ⟨tb, htb, v₁, hb⟩ := hF F Q P hf
  obtain ⟨t, ht, hr⟩ := BitMachineRawSequence.runs progL W _ w₀ _ _ v₀ v₁ _ _ _ ta tb ha hb
  exact ⟨t, by omega, _, hr⟩

