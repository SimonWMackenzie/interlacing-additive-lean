          (sourceGap D B) (kOf Φ.val.variables) ∧
      SquarePadding.entries (SEL Φ (kOf Φ.val.variables)).rows
          (SEL Φ (kOf Φ.val.variables)).cols =
        printedTsq (t10Graph D B Φ).vertices (t10Graph D B Φ).edges.length B.degreeBound
