info: papers/randomized-additive-hardness/formalization/current-v27/lean/CurrentAdditive/V39FiveBlocks.lean:200:0: theorem Paper2.V38SmallBlocks.five_block_C_of_profile.{u_1, u_2} : ∀ {X : Type u_1} {Y : Type u_2} [inst : Fintype X]
  [inst_1 : Fintype Y] (F : X → Y → Bool) (μ : FiniteLaw X) (ν : PositiveRationalLaw Y) (θ : ℝ) (C : ℕ),
  3 ≤ C →
    0 < θ →
      V38RestrictionProfiles.TwoThresholdProfile F μ ν.toFiniteLaw θ (↑C - 1) →
        ∀ (U : Set (Fin 5 × X)) (V : Set (Fin 5 → Y)),
          (∀ (i : Fin 5), 8 * θ ≤ μ.prob fun x ↦ (i, x) ∈ U) →
            (9 / 25 ≤ (ν.toFiniteLaw.iid 5).prob fun x ↦ x ∈ V) →
              C + 2 ≤ Compression.restrictionD (fullInterlace F 5) U V :=
fun {X} {Y} [Fintype X] [Fintype Y] F μ ν θ C hC hθ hp U V hrow hcol ↦
  have hp' :=
    Eq.mpr
      (id
        (congrArg (V38RestrictionProfiles.TwoThresholdProfile F μ ν.toFiniteLaw θ)
          (Eq.trans
            ((fun x_0 x_1 ↦
                (fun x_0 x_1 ↦
                    Nat.cast_sub (Decidable.byContradiction fun a ↦ five_block_C_of_profile._proof_1_1 C hC a))
                  x_0 x_1)
              ℤ Int.instRing.toAddGroupWithOne)
            (congrArg (HSub.hSub ↑C) Nat.cast_one))))
      hp;
  have h :=
    five_block_high F μ ν θ (C - 1) (Decidable.byContradiction fun a ↦ five_block_C_of_profile._proof_1_2 C hC a) hθ hp'
      U V hrow hcol;
  Decidable.byContradiction fun a ↦ five_block_C_of_profile._proof_1_3 F C hC U V h a
