import Paper2.SourceSupportFrontier
import Paper2.SourceSupportStopping
import Paper2.SourceSupportSchedule

/-!
# Live stops in the actual source protocol

Frozen v12 Section 4, `src:near-full`, the exclusion of premature leaves
and the last Bob-only depth. This module applies the one-coordinate lower
bound to states generated by the actual Bob-query recursion. The row
carrier remains unchanged, and every retained word is its literal diagonal
input. No prefix-free or stopping-correctness certificate is a premise.
-/

namespace Paper2.SourceSupportLiveStops

open SourceMatrix SourceSupportFrontier Workspace.Types.Protocol

variable {X Y I : Type*} [Fintype X] [Fintype Y] [Fintype I]
variable {q₁ q₂ s : ℕ} [NeZero q₁] [NeZero s]

/-- Every generated stop carrying a support is an actual first-Alice node,
at depth at most `ell`. Empty-support stops are not silently discarded;
they are excluded only from this conclusion's explicit live-node premise. -/
theorem run_live_stops
    (μ : PositiveRationalLaw X) (ν : PositiveRationalLaw Y)
    (R : X → Y → Bool) (activity : I → Fin q₂ → Option (Fin s)) (ξ₀ : Tail s Y)
    (H ell : ℕ) (hH : 0 < H) (hq : q₂ = 2 ^ ell) (x : ℝ) (hx : 0 ≤ x)
    (hprofile : RestrictionProfile (fun (γ : Word q₁ s Y) j => M₁ R j γ)
      (ν.iid (q₁ + s + 1)).toFiniteLaw
      ((PositiveRationalLaw.uniform (Fin q₁)).prod μ).toFiniteLaw x (H : ℤ))
    (p : Fin s) (A : Set (Template q₁ q₂ X)) (V : Set (RawRow q₁ q₂ s X I))
    (hA : ∀ z ∈ A, Sum.inl (p, z) ∈ V)
    (hAmass : (3 / 5 : ℝ) ≤ (SourceLaws.templateLaw μ q₁ q₂).toFiniteLaw.prob (· ∈ A))
    (initial : State V (TaggedColumn q₁ q₂ s Y) (Fin q₂) (Word q₁ s Y))
    (hP : ∀ v : V, ∀ z ∈ initial.columns,
      initial.protocol.eval v z = N R activity ξ₀ z v.val)
    (hcost : initial.protocol.cost ≤ H + ell)
    (hZ : initial.attachments ⊆ initial.coordinates)
    (hmass : ∀ α ∈ initial.coordinates, SourceSupportSchedule.floor q₂ x 0 ≤
      SourceSupportStep.mass (ν.iid (q₁ + s + 1)).toFiniteLaw (initial.support α))
    (hreaches : ∀ α ∈ initial.coordinates, ∀ word ∈ initial.support α,
      TaggedColumn.diagonal (α, word) ∈ initial.columns) :
    let T := run (ν.iid (q₁ + s + 1)).toFiniteLaw
      (fun α word => TaggedColumn.diagonal (α, word))
      (SourceSupportSchedule.floor q₂ x) 0 (ell + 1) initial
    ∀ v : T.Leaves, (T.state v).coordinates.Nonempty →
      H ≤ (T.state v).protocol.cost ∧ (T.route v).length ≤ ell ∧
      ∃ query left right, (T.state v).protocol = Protocol.aNode query left right := by
  classical
  let law := (ν.iid (q₁ + s + 1)).toFiniteLaw
  let input : Fin q₂ → Word q₁ s Y → TaggedColumn q₁ q₂ s Y :=
    fun α word => TaggedColumn.diagonal (α, word)
  let floor := SourceSupportSchedule.floor q₂ x
  let T := run law input floor 0 (ell + 1) initial
  change ∀ v : T.Leaves, (T.state v).coordinates.Nonempty →
    H ≤ (T.state v).protocol.cost ∧ (T.route v).length ≤ ell ∧
    ∃ query left right, (T.state v).protocol = Protocol.aNode query left right
  intro v hv
  obtain ⟨α, hα⟩ := hv
  have hp := run_bobPath law input floor 0 (ell + 1) initial v
  have hs := run_stopping law input floor 0 (ell + 1) initial v
  change (T.route v).length ≤ ell + 1 ∧
    ((T.route v).length = ell + 1 ∨ NonBob (T.state v).protocol) at hs
  have hm := run_mass_floors law input floor
    (fun r => (SourceSupportSchedule.twice_next q₂ x r).symm) 0
    0 (ell + 1) initial hmass
    (fun i hi => by simpa only [zero_add] using hmass i (hZ hi)) v
  have hr := run_support_reaches law input floor 0 (ell + 1) initial hreaches v
  have hfloor : x ≤ floor (T.route v).length := by
    have hf := SourceSupportSchedule.threshold_le_floor hx hs.1
    have he := congrArg (fun q => SourceSupportSchedule.floor q x (T.route v).length) hq
    exact hf.trans_eq he.symm
  have hw : x ≤ law.prob (fun word => word ∈ (T.state v).support α) := by
    have hmα := hm.1 α hα
    simp only [zero_add] at hmα
    exact hfloor.trans hmα
  let P := Workspace.UpperBound.Protocol.comap id
    (fun z : (T.state v).columns => z.val) (T.state v).protocol
  have hPc : P.Computes (fun (row : V) (z : (T.state v).columns) =>
      N R activity ξ₀ z.val row.val) := by
    intro row z
    rw [Workspace.UpperBound.Protocol.comap_eval]
    exact (hp.eval_eq row z.val z.property).trans
      (hP row z.val (hp.columns_subset z.property))
  have hl := SourceSupportStopping.coordinate_protocol_cost μ ν R activity ξ₀ H x hprofile
    p α A ((T.state v).support α : Set _) (T.state v).columns V hA
    (fun word hword => hr α hα word hword) hAmass hw P hPc
  have hlower : H ≤ (T.state v).protocol.cost := by
    simpa only [P, Workspace.UpperBound.Protocol.comap_cost] using hl
  have hdepth : (T.route v).length ≤ ell := by
    have hb : (T.state v).protocol.cost + (T.route v).length ≤ initial.protocol.cost :=
      hp.cost_add_length
    omega
  have hnb : NonBob (T.state v).protocol := hs.2.resolve_left (by omega)
  refine ⟨hlower, hdepth, ?_⟩
  cases he : (T.state v).protocol with
  | leaf value =>
    simp only [he, Protocol.cost] at hlower
    omega
  | aNode query left right => exact ⟨query, left, right, rfl⟩
  | bNode query left right => simp only [he, NonBob] at hnb

end Paper2.SourceSupportLiveStops

#print axioms Paper2.SourceSupportLiveStops.run_live_stops
