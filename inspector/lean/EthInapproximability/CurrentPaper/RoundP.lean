/-- The level-`(j+1)` cost word from the level-`j` data (owner-5 `cost_word_succ` at `j`). -/
theorem level_cost_word_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (hP : Pj G c b yb j Mx = EffectiveIteration.runParameters G c b (Iteration.seedState b) j) (hb : 1 ≤ b) (hc : 1 ≤ c) :
    List.replicate (costTarget (Parameters.scale ((Pj G c b yb j Mx))) b c (Parameters.bins ((Pj G c b yb j Mx)))
        (Fintype.card E) ((Pj G c b yb j Mx)).cost) true =
      ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 2 := by
  have hw := NextCostWords.cost_word_succ G c b j hb hc
  have hrp : EffectiveIteration.runParameters G c b (Iteration.seedState b) j = (Pj G c b yb j Mx) := hP.symm
  rw [hrp] at hw
  rw [hw]
  unfold costTarget
  rfl

