(`firstLength a s - 1`), cw 11 (row table). -/
def Family4SpecJ {LW VW : Type} (W : LW → TM2.Stmt (fun _ : HStack => Bool) LW VW) (w₀ : LW)
    (v₀ : VW) (T : ℕ) (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool) : Prop :=
  ∀ F Q P, levelFactsJ G c bJ yb lv Mx mS F Q P →
    ∃ t ≤ T, ∃ v₁ : VW,
      ((advance W)^[t]) ⟨some w₀, v₀, midBank4_j G c bJ yb lv Mx mS F Q P⟩ =
        ⟨none, v₁, EntryTailJ.tailStartJ G c bJ yb lv Mx mS F Q P⟩

