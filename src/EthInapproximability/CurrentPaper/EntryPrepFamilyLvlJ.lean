/-- The admitted start bank, cell by cell (`WeightedRawWords.consumer_chain`), with the values
the sources hold at `midBank4_j`. -/
theorem SF_eqJ (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) :
    SFJ G c bJ yb lv Mx =
      Function.update (Function.update (Function.update (Function.update
        (Function.update (Function.update
          (Function.update (fun _ => []) pInF (true :: EncodedGraph.encode (gP G)))
          (rawF 1) (List.replicate bJ true)) (rawF 2) (List.replicate (yb + lv) true))
          (rawF 4) (EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).cy))
          (rawF 3) (EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).rx))
          (rawF 5) (List.replicate (Fintype.card E) true)) (rawF 0) (List.replicate c true) := by
  have h := WeightedRawWords.consumer_chain (iP_j G c bJ yb lv Mx) (gP G)
  show Sum.elim (Sum.elim (WeightedRawRowsSource.initialBank (iP_j G c bJ yb lv Mx) (gP G)
    WeightedRawWords.noW) (fun _ => [])) EntryFamilyLevel.blankA = _
  rw [h]
  simp only [← Sum.update_elim_inl]
  have e : (Sum.elim (Sum.elim (fun _ : WeightedRawWords.Cons => ([] : List Bool))
      (fun _ : Fin 7 => [])) EntryFamilyLevel.blankA) = fun _ => [] := by
    funext x
    rcases x with (x | x) | x <;> rfl
  rw [e]
  have w0 : WeightedRawWords.W6 (iP_j G c bJ yb lv Mx) 0 = List.replicate c true := rfl
  have w1 : WeightedRawWords.W6 (iP_j G c bJ yb lv Mx) 1 = List.replicate bJ true := rfl
  have w2 : WeightedRawWords.W6 (iP_j G c bJ yb lv Mx) 2 = List.replicate (yb + lv) true := rfl
  have w3 : WeightedRawWords.W6 (iP_j G c bJ yb lv Mx) 3 = EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).rx := by
    simp only [WeightedRawWords.W6, ETHParameterScaleMachineInput.words, EntryLayout.rep,
      EntryLevelJBank.wJ, EntryLevelWords.levelWords, TemplateEntry.actualWords,
      Iteration.stepParameters, Iteration.parameters, Matrix.cons_val]
  have w4 : WeightedRawWords.W6 (iP_j G c bJ yb lv Mx) 4 = EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).cy := by
    simp only [WeightedRawWords.W6, ETHParameterScaleMachineInput.words, EntryLayout.rep,
      EntryLevelJBank.wJ, EntryLevelWords.levelWords, TemplateEntry.actualWords,
      Iteration.stepParameters, Iteration.parameters, Matrix.cons_val]
  have w5 : WeightedRawWords.W6 (iP_j G c bJ yb lv Mx) 5 = List.replicate (Fintype.card E) true := rfl
  rw [w0, w1, w2, w3, w4, w5]
  rfl

theorem tail_cell_gap_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) :
    EntryRunsRaw.cellBank (EntryLevelJBank.wJ G c bJ yb lv Mx) =
      Function.update (Function.update (Function.update (Function.update
        (EntryRunsRaw.cellBank (wMid4_j G c bJ yb lv Mx))
        (EntryRunsRaw.eo (.inl 4)) (EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).qOne))
        (EntryRunsRaw.eo (.inl 5)) (EntryLevelJBank.wJ G c bJ yb lv Mx).firstTable)
        (EntryRunsRaw.eo (.inl 8)) (EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).firstExp))
        (EntryRunsRaw.eo (.inl 11)) (EntryLevelJBank.wJ G c bJ yb lv Mx).rowTable := by
  funext k
  obtain ⟨o, rfl⟩ := EntryRunsRaw.eo.surjective k
  rcases o with i | r
  · simp only [EntryRunsRaw.cellBank, Equiv.symm_apply_apply, Sum.elim_inl, Function.update_apply,
      EmbeddingLike.apply_eq_iff_eq, Sum.inl.injEq]
    fin_cases i <;> simp [EntryLayout.common, wMid4_j, wordB_eq_j]
  · simp only [EntryRunsRaw.cellBank, Equiv.symm_apply_apply, Sum.elim_inr, Function.update_apply,
      EmbeddingLike.apply_eq_iff_eq, reduceCtorEq, if_false]

theorem tail_gap_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool) :
    EntryTailJ.tailStartJ G c bJ yb lv Mx mS F Q P =
      Function.update (Function.update (Function.update (Function.update
        (midBank4_j G c bJ yb lv Mx mS F Q P)
        (tailEmb (tj 4)) (EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).qOne))
        (tailEmb (tj 5)) (EntryLevelJBank.wJ G c bJ yb lv Mx).firstTable)
        (tailEmb (tj 8)) (EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).firstExp))
        (tailEmb (tj 11)) (EntryLevelJBank.wJ G c bJ yb lv Mx).rowTable := by
  unfold EntryTailJ.tailStartJ midBank4_j
  have h : EntryTailJ.bnkJ G c bJ yb lv Mx = EntryRunsRaw.cellBank (EntryLevelJBank.wJ G c bJ yb lv Mx) := rfl
  rw [h, tail_cell_gap_j, start_update, start_update, start_update, start_update]
  simp only [← bank_update]
  rfl

theorem mid4_out_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (i : Fin 19) (hi : i = 4 ∨ i = 5 ∨ i = 8 ∨ i = 11) :
    midBank4_j G c bJ yb lv Mx mS F Q P (tailEmb (tj i)) = [] := by
  rw [mid4_tail_j]
  simp only [tj, RawTableTail.startBank, RawTableTail.glob, MatrixTableWriter.Data.contents,
    MatrixTableWriter.Data.cell, MatrixTableWriter.ready, EntryRunsRaw.cellBank, Sum.elim_inl,
    Equiv.symm_apply_apply, common_wMid4_j G c bJ yb lv Mx]
  rcases hi with rfl | rfl | rfl | rfl <;> rfl

theorem firstExp_eq_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) :
    EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).s ++ EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).qOne =
      EntryLayout.rep (EntryLevelJBank.wJ G c bJ yb lv Mx).firstExp := by
  simp only [EntryLayout.rep, List.replicate_append_replicate]
  congr 1
  simp only [EntryLevelJBank.wJ, EntryLevelWords.levelWords, TemplateEntry.actualWords,
    Construction.firstLength]
  omega

noncomputable def bnd_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : EntryFamilyLevel.Stack → ℕ :=
  Sum.elim (fun j => (WeightedLevelColumnSave.initialBank (iP_j G c bJ yb lv Mx) (gP G)
      WeightedRawWords.noW j).length + growB_j G c bJ yb lv Mx)
    (fun x => (exA_j G c bJ yb lv Mx x).length)

open scoped Classical in
/-- Length allowance of workspace code `x` at the clear (0 for codes outside `range enc`). -/
noncomputable def lenF_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (x : FamIdx) : ℕ :=
  if h : ∃ y, enc y = x then bnd_j G c bJ yb lv Mx (Classical.choose h) else 0

noncomputable def clearB_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  ∑ i : Fin nF, lenF_j G c bJ yb lv Mx ((Fintype.equivFin FamIdx).symm i)

noncomputable def costC_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  (2 * c + 2) + ((2 * Fintype.card E + 2) + ((2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).rx + 2) +
    ((2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).cy + 2) + ((2 * (yb + lv) + 2) + ((2 * bJ + 2) + 0)))))

noncomputable def costE_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  (2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).firstTable.length + 2) +
    ((2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).rowTable.length + 2) +
      ((2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).qOne + 2) + ((2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).qOne + 2) + 0)))

/-- The clock of `progF`. -/
noncomputable def TFJ (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  (costA G + 1) + (1 + ((costC_j G c bJ yb lv Mx + 1) + (famBound_j G c bJ yb lv Mx + ((costE_j G c bJ yb lv Mx + 1) +
    ((2 * (EntryLevelJBank.wJ G c bJ yb lv Mx).s + 2) + (clearB_j G c bJ yb lv Mx + nF + 2) + 1) + 1) + 1) + 1) + 1) + 1

