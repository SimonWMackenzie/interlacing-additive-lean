              (kOf Φ.val.variables) x) ≤ (1 / 2) ^ 11 + 1 / 100 ∧
          (1 / 2 : ℝ) ^ 11 + 1 / 100 < 1 / 3) :=
  T24_endpoint D B L hDA2
