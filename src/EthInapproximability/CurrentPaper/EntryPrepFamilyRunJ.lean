theorem bnd_inl_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (j : WeightedLevelColumnSave.Stack) :
    bnd_j G c bJ yb lv Mx (Sum.inl j) =
      (WeightedLevelColumnSave.initialBank (iP_j G c bJ yb lv Mx) (gP G) WeightedRawWords.noW j).length +
        growB_j G c bJ yb lv Mx := by
  unfold bnd_j; rw [Sum.elim_inl]

theorem bnd_inr_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (x : EntryFamilyAssembly.ACell) :
    bnd_j G c bJ yb lv Mx (Sum.inr x) = (exA_j G c bJ yb lv Mx x).length := by
  unfold bnd_j; rw [Sum.elim_inr]

theorem len_bound_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (Z : WeightedLevelColumnSave.Stack → List Bool)
    (hg : ∀ j, (Z j).length ≤
      (WeightedLevelColumnSave.initialBank (iP_j G c bJ yb lv Mx) (gP G) WeightedRawWords.noW j).length +
        growB_j G c bJ yb lv Mx)
    (y : EntryFamilyLevel.Stack) : (Sum.elim Z (exA_j G c bJ yb lv Mx) y).length ≤ bnd_j G c bJ yb lv Mx y := by
  rcases y with j | x
  · rw [bnd_inl_j, Sum.elim_inl]; exact hg j
  · rw [bnd_inr_j, Sum.elim_inr]

