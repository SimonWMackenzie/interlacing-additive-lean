def B13 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B12 n a am bd b6 s w L Q) (Sum.inr 12 : AK) (u (1))
def B14 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B13 n a am bd b6 s w L Q) (Sum.inr 13 : AK) (u (2 ^ (L)))
def B15 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B14 n a am bd b6 s w L Q) (Sum.inr 14 : AK) (u (10))
def B16 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B15 n a am bd b6 s w L Q) (Sum.inr 15 : AK) (u ((10) * (L)))
