pth n)).matrix).rows)) (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).binBase (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).rawWidth (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).s) +
        (9 * (BitMachineStackGrowth.perStep WeightedLevelFields15.program * (WeightedLevelFields15.publicBound15 (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix) (EncodedETHSource.serializeGraph G) (Fintype.card E) WeightedRawWords.noW (Parameters.firstExponent (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix)) (Parameters.bins (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix)) (ParameterizedNP.GuardedSourceSlab.q2 G (Parameters.bins (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix))) (PrimeSampler.size (ParameterizedNP.GuardedSourceSlab.q2 G (Parameters.bins (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix))) (Parameters.balanceOrder (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix)) (Construction.qOne (Parameters.firstExponent (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix)) * (Iteration.stepParameters G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).rows)) (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).binBase (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).rawWidth (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).s)) + 9 + 2) +
        WeightedRowFields.rowTime (Fintype.card V) (4 * Iteration.s G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix) (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).nb (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).stagePrefixRows (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).rx (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).binBase (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).rawWidth (ProtectedFullBankBridgeScratch.actualD G c (EffectiveIteration.sourceDepth n) (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0 (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).uniform + 3

/-- The fixed program: the frozen level-0 composite, one charged handoff, the clear. -/
def cleanProgram (c : ℕ) :=
  BitMachineRawSequence.program (level0RowsProgram M c) (WeightedRawWords.clearProgram clearCells)
    (0 : Fin (nClear + 2))
    (((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)))
    ((), none)

theorem level0_clean (G : EndpointGraph V E) (n c : ℕ) :
    ∃ F : ETHBinsJoinedScratch.Stack → List Bool,
    ∃ Q : WeightedGraphQJoined.Stack → List Bool,
    ∃ P : ChosenPrimeRaw.Stack → List Bool,
    ∃ t ≤ bound0 M G n c +
        (nClear * (BitMachineStackGrowth.perStep (level0RowsProgram M c) * bound0 M G n c) +
          nClear + 2) + 1,
      ((advance (cleanProgram M c))^[t])
        ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (.inl (.scan 0)))))),
          ((((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))), ((), none)),
          startC (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G)))⟩ =
        ⟨none, ((((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))), ((), none)),
          BitMachineClearBank.cleared clearCells (level0RowsBank M G n c F Q P)⟩ ∧
      level0Facts M G n c F Q P := by
  obtain ⟨F, Q, P, t0, ht0, hrun, hfacts⟩ := level0_rows_persist M G n c
  have ht0' : t0 ≤ bound0 M G n c := ht0
  have grow : ∀ i, (level0RowsBank M G n c F Q P (clearCells i)).length ≤
      BitMachineStackGrowth.perStep (level0RowsProgram M c) * bound0 M G n c := by
    intro i
    have h := BitMachineStackGrowth.run_growth (level0RowsProgram M c)
      ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (.inl (.scan 0))))),
        (((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))),
        startC (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G)))⟩ t0 (clearCells i)
    rw [hrun] at h
    have hz := startC_clear (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G))) i
    simp only [hz, List.length_nil, Nat.zero_add] at h
    exact h.trans (Nat.mul_le_mul_left _ ht0')
  have hsum : (∑ i, (level0RowsBank M G n c F Q P (clearCells i)).length) ≤
      nClear * (BitMachineStackGrowth.perStep (level0RowsProgram M c) * bound0 M G n c) := by
    calc (∑ i, (level0RowsBank M G n c F Q P (clearCells i)).length)
        ≤ ∑ _i : Fin nClear,
            BitMachineStackGrowth.perStep (level0RowsProgram M c) * bound0 M G n c :=
          Finset.sum_le_sum (fun i _ => grow i)
      _ = _ := by simp
  have s2 := WeightedRawWords.clear_run clearCells clearCells_inj (level0RowsBank M G n c F Q P)
  obtain ⟨v, hv, q⟩ := BitMachineRawSequence.runs (level0RowsProgram M c)
    (WeightedRawWords.clearProgram clearCells) _ _ _ _ _ _
    (startC (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G))))
    (level0RowsBank M G n c F Q P)
    (BitMachineClearBank.cleared clearCells (level0RowsBank M G n c F Q P)) _ _ hrun s2
  refine ⟨F, Q, P, v, ?_, q, hfacts⟩
  generalize (∑ i, (level0RowsBank M G n c F Q P (clearCells i)).length) = S at hsum hv
  generalize nClear * (BitMachineStackGrowth.perStep (level0RowsProgram M c) * bound0 M G n c) = X
    at hsum ⊢
  omega

