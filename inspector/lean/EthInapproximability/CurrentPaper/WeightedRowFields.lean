/-- The exit values: the eight inputs unchanged, the eleven outputs written,
every scratch cell zero. -/
def rowVals (V FS NB SL RX W29 W21 W1 : ℕ) : LStack → ℕ :=
  Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (Function.update (st0 V FS NB SL RX W29 W21 W1) (8 : LStack) V) (9 : LStack) (FS * V)) (10 : LStack) (4194300 * (((NB * RX) + (((FS * V) * RX) + SL)) * (SL * (((FS * V) * RX) * (NB * RX)))))) (11 : LStack) (2 * (((NB * RX) + (((FS * V) * RX) + SL)) * (SL * (((FS * V) * RX) * (NB * RX)))))) (12 : LStack) (((NB * RX) + (((FS * V) * RX) + SL)) * (SL * (((FS * V) * RX) * (NB * RX))))) (13 : LStack) (4194300 * (SL * (((FS * V) * RX) * (NB * RX))))) (14 : LStack) (2 * (((NB * RX) + (((FS * V) * RX) + SL)) * (((FS * V) * RX) * (NB * RX))))) (15 : LStack) ((((NB * RX) + (((FS * V) * RX) + SL)) * SL) * (NB * RX))) (16 : LStack) ((((NB * RX) + (((FS * V) * RX) + SL)) * SL) * ((FS * V) * RX))) (17 : LStack) (184 * ((W21 * W29) * W1))) (18 : LStack) (4194304 * (((NB * RX) + (((FS * V) * RX) + SL)) * (SL * (((FS * V) * RX) * (NB * RX)))))

theorem st41_eq (V FS NB SL RX W29 W21 W1 : ℕ) : st41 V FS NB SL RX W29 W21 W1 = rowVals V FS NB SL RX W29 W21 W1 := by
  funext i
  fin_cases i <;> rfl

/-- The row-field program run inside ANY bank through an injection of its 36
local cells; every cell outside the image is untouched (`bank`). -/
theorem rowFields_embedded {K : Type*} [DecidableEq K] (ι : LStack ↪ K)
    (S : K → List Bool) (V FS NB SL RX W29 W21 W1 : ℕ)
    (hS : ∀ i, S (ι i) = List.replicate (st0 V FS NB SL RX W29 W21 W1 i) true) :
    ∃ t ≤ rowTime V FS NB SL RX W29 W21 W1,
      ((advance (fun l => stackStmt ι (rowProgram l)))^[t])
        ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)))))), rowInit, S⟩ =
        ⟨none, rowInit, bank ι S (uBank (rowVals V FS NB SL RX W29 W21 W1))⟩ := by
  obtain ⟨t, ht, h⟩ := row_run V FS NB SL RX W29 W21 W1
  rw [st41_eq] at h
  exact ⟨t, ht, WeightedRawWords.region_run ι rowProgram _ _ t h S (fun k => (hS k).symm)⟩

#print axioms rowFields_embedded

