import Paper2.YaoMaterialization
import Paper2.YaoResourceBounds

/-!
# Polynomial lengths for the actual serialized Yao output

Frozen v12 Appendix B, `yao:dimensions` and `yao:materialization`.
The polynomial bounds are applied here to the very lists produced and read
by `materialize`, and to the counters generated by its explicit output loop.
They hold for every correctly sized bit list, independently of all promises.
These are length and loop-call bounds, not a complete machine-time theorem.
-/

namespace Paper2.YaoMaterialization

open Paper2.YaoLookup Paper2.YaoLowerBound Paper2.YaoLowerBound.Materialization
open Paper2.YaoResources

theorem dimension_product_eq (vertices t b lambda : ℕ) :
    rowCount vertices t b lambda * columnCount t b lambda =
      tableEntryCount vertices t b lambda := by
  simp only [rowCount, columnCount, tableEntryCount, Nat.mul_assoc]

/-- The exact output length is the resource bound's actual indexed-entry
count; no distinct-row or distinct-column assumption is introduced. -/
theorem materialize_length_eq_count {vertices edgeCount : ℕ} (t lambda : ℕ)
    (edges : Fin edgeCount → Fin (2 ^ t * 2 ^ t) ↪ Fin vertices)
    (bits : SerializedTape t (paddedEdgeBits edgeCount) lambda) :
    (materialize t lambda edges bits).bits.length =
      tableEntryCount vertices t (paddedEdgeBits edgeCount) lambda := by
  exact (materialize t lambda edges bits).length.trans (dimension_product_eq _ _ _ _)

/-- Every actual printed Boolean list has the stated quartic source-size
bound, including sources with no edges. -/
theorem materialize_length_le {vertices edgeCount : ℕ}
    (t lambda : ℕ) (ht : 1 ≤ t)
    (edges : Fin edgeCount → Fin (2 ^ t * 2 ^ t) ↪ Fin vertices)
    (bits : SerializedTape t (paddedEdgeBits edgeCount) lambda) :
    (materialize t lambda edges bits).bits.length ≤
      vertices * (16 * entryCoefficient t lambda) * (max 1 edgeCount) ^ 4 := by
  rw [materialize_length_eq_count]
  exact padded_tableEntryCount_le vertices t edgeCount lambda ht

/-- The literal input bit list has a cubic bound in the source edge count.
It is fixed before the list is sampled and is valid on every tape. -/
theorem serializedTape_length_le (t edgeCount lambda : ℕ) (ht : 1 ≤ t)
    (bits : SerializedTape t (paddedEdgeBits edgeCount) lambda) :
    bits.val.length ≤ (8 * bitCoefficient t lambda) * (max 1 edgeCount) ^ 3 := by
  rw [bits.property]
  exact padded_tapeBitCount_le t edgeCount lambda ht

/-- The actual recursive output loop makes exactly one entry call and
constructs exactly one output cell for every printed bit. -/
theorem countedMaterialize_counts_eq_length {vertices edgeCount : ℕ}
    (t lambda : ℕ)
    (edges : Fin edgeCount → Fin (2 ^ t * 2 ^ t) ↪ Fin vertices)
    (bits : SerializedTape t (paddedEdgeBits edgeCount) lambda) :
    (countedMaterialize t lambda edges bits).entryCalls =
      (materialize t lambda edges bits).bits.length ∧
    (countedMaterialize t lambda edges bits).consCells =
      (materialize t lambda edges bits).bits.length := by
  rw [(materialize t lambda edges bits).length]
  exact countedMaterialize_counts t lambda edges bits

/-- An explicit polynomial bound on the two proved output-loop counters.
In particular this is not obtained by postulating a polynomial-time oracle. -/
theorem countedMaterialize_counts_le {vertices edgeCount : ℕ}
    (t lambda : ℕ) (ht : 1 ≤ t)
    (edges : Fin edgeCount → Fin (2 ^ t * 2 ^ t) ↪ Fin vertices)
    (bits : SerializedTape t (paddedEdgeBits edgeCount) lambda) :
    (countedMaterialize t lambda edges bits).entryCalls ≤
      vertices * (16 * entryCoefficient t lambda) * (max 1 edgeCount) ^ 4 ∧
    (countedMaterialize t lambda edges bits).consCells ≤
      vertices * (16 * entryCoefficient t lambda) * (max 1 edgeCount) ^ 4 := by
  obtain ⟨he, hc⟩ := countedMaterialize_counts_eq_length t lambda edges bits
  rw [he, hc]
  exact ⟨materialize_length_le t lambda ht edges bits,
    materialize_length_le t lambda ht edges bits⟩

end Paper2.YaoMaterialization
