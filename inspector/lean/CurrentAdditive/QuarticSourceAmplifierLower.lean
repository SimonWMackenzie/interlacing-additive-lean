import CurrentAdditive.QuarticAlignment
import Paper2.RestorationBridgeRational
import Paper2.RecursiveSampling

/-!
# Finite NO successor cost and profile on the literal graph source

This is the lower/profile half of frozen-v12 `thm:amplifier`. The public
finite guards remain premises. No runtime or complete T6 consequence is
claimed.
-/

namespace Paper2.SourceAmplifierLower

open SourceMatrix SourceLawBinding SourceProfileParameters SourceDeficiency
  SourceSurvivingCollisions Workspace.Types.CommComplexity

local instance (L : ℕ) : NeZero (width L) := ⟨by unfold width; positivity⟩
local instance (L : ℕ) : NeZero (outerWidth L) := ⟨by unfold outerWidth; positivity⟩
local instance (L : ℕ) : NeZero (width L - 2) := ⟨by
  have h := width_admissible L
  omega⟩

/-- At one source step, the finite laws in the successor theorem are
exactly those generated by `RecursiveSampling.laws`, on its own carriers. -/
theorem successor_laws_match_recursive27
    {V X Y : Type} [Fintype V] [Nonempty V] [Fintype X] [Fintype Y]
    (μ : PositiveRationalLaw X) (ν : PositiveRationalLaw Y)
    (L w Q : ℕ) [NeZero w] [NeZero Q] :
    (RecursiveSampling.laws (V := V) (q₁ := width L - 2)
      (q₂ := outerWidth L) (s := width L) (w := w) (Q := Q)
      (SourceProfiles.width_ge_four L) μ ν 1).1.toFiniteLaw =
        ((FiniteLaw.uniformFin w (NeZero.pos w)).prod
          (matrixRowLaw ν (width L - 2) (outerWidth L) (width L)).toFiniteLaw).iid Q ∧
    (RecursiveSampling.laws (V := V) (q₁ := width L - 2)
      (q₂ := outerWidth L) (s := width L) (w := w) (Q := Q)
      (SourceProfiles.width_ge_four L) μ ν 1).2.toFiniteLaw =
        (FiniteLaw.uniformFin Q (NeZero.pos Q)).prod
          ((matrixColumnLaw (V := V) μ (width L - 2) (outerWidth L)
            (width L) (SourceProfiles.width_ge_four L)).toFiniteLaw.iid w) := by
  classical
  letI : Nonempty (Fin w) := Fin.pos_iff_nonempty.mp (NeZero.pos w)
  letI : Nonempty (Fin Q) := Fin.pos_iff_nonempty.mp (NeZero.pos Q)
  have hwlaw : (PositiveRationalLaw.uniform (Fin w)).toFiniteLaw =
      FiniteLaw.uniformFin w (NeZero.pos w) := by
    apply FiniteLaw.eq_of_weight_eq
    funext i
    simp [PositiveRationalLaw.toFiniteLaw, PositiveRationalLaw.uniform,
      FiniteLaw.uniformFin, Fintype.card_fin]
  have hQlaw : (PositiveRationalLaw.uniform (Fin Q)).toFiniteLaw =
      FiniteLaw.uniformFin Q (NeZero.pos Q) := by
    apply FiniteLaw.eq_of_weight_eq
    funext i
    simp [PositiveRationalLaw.toFiniteLaw, PositiveRationalLaw.uniform,
      FiniteLaw.uniformFin, Fintype.card_fin]
  constructor
  · change (((PositiveRationalLaw.uniform (Fin w)).prod
      (matrixRowLaw ν (width L - 2) (outerWidth L) (width L))).iid Q).toFiniteLaw = _
    rw [PositiveRationalLaw.toFiniteLaw_iid,
      PositiveRationalLaw.toFiniteLaw_prod, hwlaw]
  · change ((PositiveRationalLaw.uniform (Fin Q)).prod
      ((matrixColumnLaw (V := V) μ (width L - 2) (outerWidth L)
        (width L) (SourceProfiles.width_ge_four L)).iid w)).toFiniteLaw = _
    rw [PositiveRationalLaw.toFiniteLaw_prod,
      PositiveRationalLaw.toFiniteLaw_iid, hQlaw]

variable {V E X Y : Type*} [Fintype V] [Nonempty V] [Fintype E]
  [Fintype X] [Fintype Y]
variable
    (μ : PositiveRationalLaw X) (ν : PositiveRationalLaw Y)
    (F : X → Y → Bool) (L d : ℕ) (hd : 3 ≤ d) (hD : D F = d)
    (hp : RestrictionProfile F μ.toFiniteLaw ν.toFiniteLaw (rho L) (d : ℤ))
    (hinner : (width L : ℝ) * rho L ≤ 1 / 1000)
    (houter : (outerWidth L : ℝ) * x L ≤ 1 / 10000)
    (hwide : (10 * L : ℝ) ≤ (outerWidth L : ℝ) / 4096)
    (href : (width L : ℝ) * x L ≤ 1 / 10000)
    (order : SourceConstruction.Items (width L) V ≃
      Fin (Fintype.card (SourceConstruction.Items (width L) V)))
    (edge : E → Bool → V) (loopless : ∀ e, edge e false ≠ edge e true)
    (rep Δ : ℕ) (hΔ : 0 < Δ)
    (hq : outerWidth L = SourceItems.sourceQ0 (Fin (4 * width L)) E * rep)
    (hdegree : ∀ v, SourceItems.degree edge v ≤ Δ)
    (γ : ℝ) (hγ : 0 < γ) (hE : 0 < Fintype.card E)
    (gap : ∀ colour : V → Fin 3, γ * Fintype.card E ≤
      ((Finset.univ.filter (fun e => colour (edge e false) =
        colour (edge e true))).card : ℝ))
    (hscale : 4 * (width L : ℝ) ^ 2 * rho L ≤ 1)
    (hcountSource : 8 * (width L : ℝ) * (width L - 2 : ℕ) ≤
      witnessDensity γ * outerWidth L / 16)
    (ξ₀ : Tail (width L) Y)
    (w r Q q C : ℕ) (hw : w = 2 ^ r) (hw2 : 2 ≤ w)
    (hQ : Q = 2 ^ q) (hC : 4 ≤ C)
    (hCeq : C - 1 = d + exponent L + outerExponent L + exponent L)
    (ηq : ℚ)
    (hηq : (ηq : ℝ) = deletionAllowance (V := V) (E := E) γ Δ (width L))
    (hquarter : CurrentAdditive.QuarticSchedule.quarterCheck27Prop w Q ηq)
    (hsmall : 2 * (w : ℝ) ^ 2 * x L ≤
      deletionAllowance (V := V) (E := E) γ Δ (width L) /
        (16 * (127 / 128 : ℝ)))
    (hfirst : 4 * (1 / 256 : ℝ) * w * outerWidth L * x L ≤
      deletionAllowance (V := V) (E := E) γ Δ (width L) / 32)
    (hlast : 4 * (1 / 256 : ℝ) * w / outerWidth L ≤
      deletionAllowance (V := V) (E := E) γ Δ (width L) / 32)
    (hKcheck :
      (1024 * (1 / 256 : ℝ) * RestorationCoverParameters.B2 Q *
        (r + 2) * width L) *
      CurrentAdditive.QuarticSchedule.E27 Q ηq ≤
      deletionAllowance (V := V) (E := E) γ Δ (width L) * w / 16)
    (hxsmall : ((w : ℝ) ^ 2 * (outerWidth L : ℝ)) * x L ≤ 1)
    (hstar : 4 * RestorationCoverParameters.tStar Q ≤ w)
    (hsmallwx : (w : ℝ) * x L ≤ 1 / 10000)
    (hmargin : 2 * w * x L +
      deletionAllowance (V := V) (E := E) γ Δ (width L) /
        (16 * (127 / 128 : ℝ)) < 1)
    (hL : 1 ≤ L)
    (hbridge : 80 * (L : ℝ) ≤ (Q : ℝ) *
      (deletionAllowance (V := V) (E := E) γ Δ (width L) /
        (16 * (w : ℝ))))

include hd hD hp hinner houter hwide href loopless hΔ hdegree hγ hE gap
  hscale hcountSource hw hw2 hQ hC hCeq hηq hquarter hsmall hfirst
  hlast hKcheck hxsmall hstar hsmallwx hmargin hL hbridge in
set_option maxRecDepth 4096 in
/-- The literal two-interlace successor has exact NO cost and the
regenerated three-rung profile under the same one-step rational laws
used by `RecursiveSampling.laws`. -/
theorem source_successor_no_cost_profile27 :
    let h := exponent L + outerExponent L + exponent L + r + q
    D (SourceMatrix.successor (q₁ := width L - 2) F
      (SourceConstruction.activity order edge
        (by have := SourceProfiles.width_ge_four L; omega) rep hq)
      ξ₀ w Q) = d + h + 1 ∧
    RestrictionProfile
      (SourceMatrix.successor (q₁ := width L - 2) F
        (SourceConstruction.activity order edge
          (by have := SourceProfiles.width_ge_four L; omega) rep hq)
        ξ₀ w Q)
      (((FiniteLaw.uniformFin w (by rw [hw]; positivity)).prod
        (matrixRowLaw ν (width L - 2) (outerWidth L) (width L)).toFiniteLaw).iid Q)
      ((FiniteLaw.uniformFin Q (by rw [hQ]; positivity)).prod
        ((matrixColumnLaw (V := V) μ (width L - 2) (outerWidth L)
          (width L) (SourceProfiles.width_ge_four L)).toFiniteLaw.iid w))
      (rho L) ((d + h + 1 : ℕ) : ℤ) := by
  classical
  let η := deletionAllowance (V := V) (E := E) γ Δ (width L)
  let δ := η / (16 * (w : ℝ))
  have hQpos : 0 < Q := by rw [hQ]; positivity
  have hwpos : 0 < w := by omega
  have hηpos : 0 < η := by
    exact SourceDeletionParameters.eta_pos (width L) (NeZero.pos _) _ _
      (vertexTolerance_pos (V := V) (E := E) γ Δ hγ hΔ hE)
      (by unfold witnessDensity; positivity)
  have hδpos : 0 < δ := div_pos hηpos (mul_pos (by norm_num) (by exact_mod_cast hwpos))
  have hηwidth := (SourceDeletionParameters.eta_width_bounds
    (width L) (NeZero.pos _) (vertexTolerance (V := V) (E := E) γ Δ)
    (witnessDensity γ)).1
  have hspos : (0 : ℝ) < width L := by exact_mod_cast (NeZero.pos (width L))
  have hηsmall : η ≤ 1 / 65536 := by
    change η * (width L : ℝ) ≤ 1 / 65536 at hηwidth
    have hsone : (1 : ℝ) ≤ width L := by exact_mod_cast (NeZero.pos (width L))
    calc
      η = η * 1 := by ring
      _ ≤ η * width L := mul_le_mul_of_nonneg_left hsone hηpos.le
      _ ≤ 1 / 65536 := hηwidth
  have hδsmall : δ ≤ 1 / 64 := by
    have hwR : (1 : ℝ) ≤ w := by exact_mod_cast hwpos
    have hden : (0 : ℝ) < 16 * w := mul_pos (by norm_num) (by exact_mod_cast hwpos)
    change η / (16 * (w : ℝ)) ≤ 1 / 64
    apply (div_le_iff₀ hden).2
    linarith
  have hθpos := RestorationCoverParameters.theta_pos hQpos
  have hQθ : (2 : ℝ) ^ q * RestorationCoverParameters.theta Q < 1 / 20 := by
    have hQcast : (2 : ℝ) ^ q = Q := by exact_mod_cast hQ.symm
    rw [hQcast]
    have hQr : (0 : ℝ) < Q := by exact_mod_cast hQpos
    calc
      (Q : ℝ) * RestorationCoverParameters.theta Q = 1 / 320 := by
        unfold RestorationCoverParameters.theta
        simp only [Nat.cast_mul, Nat.cast_ofNat]
        field_simp [ne_of_gt hQr]
      _ < 1 / 20 := by norm_num
  have halign := RestorationAlignment.actual_W_alignment27
    μ ν F L d hd hD hp hinner houter hwide href order edge loopless
    rep Δ hΔ hq hdegree γ hγ hE gap hscale hcountSource ξ₀
    w r Q C hw hw2 hQpos hC hCeq ηq hηq hquarter hsmall hfirst hlast
    hKcheck hxsmall hstar hsmallwx hmargin
  let rowW := (matrixColumnLaw (V := V) μ (width L - 2)
    (outerWidth L) (width L) (SourceProfiles.width_ge_four L)).iid w
  letI : Nonempty (Fin w) := Fin.pos_iff_nonempty.mp hwpos
  letI : Nonempty (Fin Q) := Fin.pos_iff_nonempty.mp hQpos
  let colW := (PositiveRationalLaw.uniform (Fin w)).prod
    (matrixRowLaw ν (width L - 2) (outerWidth L) (width L))
  letI : Nonempty (Fin w → RawRow (width L - 2) (outerWidth L) (width L) X
      (SourceConstruction.Items (width L) V)) := rowW.nonempty
  letI : Nonempty (Fin w × TaggedColumn (width L - 2) (outerWidth L)
      (width L) Y) := colW.nonempty
  have hfirstlaw : colW.toFiniteLaw =
      ReferenceInitial.firstRowLaw ν (by exact hwpos) := rfl
  have huniw : (PositiveRationalLaw.uniform (Fin w)).toFiniteLaw =
      FiniteLaw.uniformFin w hwpos := by
    apply FiniteLaw.eq_of_weight_eq
    funext i
    simp [PositiveRationalLaw.toFiniteLaw, PositiveRationalLaw.uniform,
      FiniteLaw.uniformFin, Fintype.card_fin]
  have hcolWlaw : colW.toFiniteLaw =
      (FiniteLaw.uniformFin w hwpos).prod
        (matrixRowLaw ν (width L - 2) (outerWidth L) (width L)).toFiniteLaw := by
    change ((PositiveRationalLaw.uniform (Fin w)).prod
      (matrixRowLaw ν (width L - 2) (outerWidth L) (width L))).toFiniteLaw = _
    rw [PositiveRationalLaw.toFiniteLaw_prod, huniw]
  have hrowlaw : rowW.toFiniteLaw =
      ((matrixColumnLaw (V := V) μ (width L - 2)
        (outerWidth L) (width L) (SourceProfiles.width_ge_four L)).toFiniteLaw.iid w) := by
    exact PositiveRationalLaw.toFiniteLaw_iid _ _
  have hCost : D (RestorationUpper.sourceW F L order edge rep hq ξ₀ w) = C + r :=
    halign.1
  have hnear : RestrictionLowerBound
      (RestorationUpper.sourceW F L order edge rep hq ξ₀ w)
      rowW.toFiniteLaw colW.toFiniteLaw (RestorationCoverParameters.theta Q)
      (1 - δ) ((C + r : ℕ) : ℤ) := by
    simpa only [hrowlaw, hfirstlaw, δ, η] using halign.2.2
  have hprofile : RestrictionProfile
      (RestorationUpper.sourceW F L order edge rep hq ξ₀ w)
      rowW.toFiniteLaw colW.toFiniteLaw (RestorationCoverParameters.theta Q)
      (((C + r : ℕ) : ℤ) - 1) := by
    have hc : ((C + r - 1 : ℕ) : ℤ) = ((C + r : ℕ) : ℤ) - 1 := by omega
    simpa only [hrowlaw, hfirstlaw, hc] using halign.2.1
  have hbridge' : 80 * (L : ℝ) ≤ (2 : ℝ) ^ q * δ := by
    rw [show (2 : ℝ) ^ q = (Q : ℝ) by exact_mod_cast hQ.symm]
    exact hbridge
  have hnearD : RestrictionLowerBound
      (RestorationUpper.sourceW F L order edge rep hq ξ₀ w)
      rowW.toFiniteLaw colW.toFiniteLaw (RestorationCoverParameters.theta Q)
      (1 - δ) ((D (RestorationUpper.sourceW F L order edge rep hq ξ₀ w) : ℕ) : ℤ) := by
    rw [hCost]
    exact hnear
  have hprofileD : RestrictionProfile
      (RestorationUpper.sourceW F L order edge rep hq ξ₀ w)
      rowW.toFiniteLaw colW.toFiniteLaw (RestorationCoverParameters.theta Q)
      ((D (RestorationUpper.sourceW F L order edge rep hq ξ₀ w) : ℤ) - 1) := by
    rw [hCost]
    exact hprofile
  have hrational := RestorationBridge.rational_restoration rowW colW
    (RestorationUpper.sourceW F L order edge rep hq ξ₀ w)
    q L (RestorationCoverParameters.theta Q) δ
    (by rw [hCost]; omega) hL hθpos hδpos hδsmall
    hbridge' hQθ hnearD hprofileD
  subst Q
  have hentry : RestorationBridge.restored
      (RestorationUpper.sourceW F L order edge rep hq ξ₀ w) q =
      SourceMatrix.successor (q₁ := width L - 2) F
        (SourceConstruction.activity order edge
          (by have := SourceProfiles.width_ge_four L; omega) rep hq)
        ξ₀ w (2 ^ q) := by
    rfl
  have hρ : (2 : ℝ) ^ (-(L : ℝ)) = rho L := by
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast]
    unfold rho
    rw [one_div, inv_pow]
  rw [hentry, hCost] at hrational
  have hnum : C + r + q = d + (exponent L + outerExponent L +
      exponent L + r + q) + 1 := by omega
  refine ⟨by simpa only [hnum] using hrational.1, ?_⟩
  simpa only [hρ, hcolWlaw, hrowlaw, hnum] using hrational.2

end Paper2.SourceAmplifierLower

#print axioms Paper2.SourceAmplifierLower.successor_laws_match_recursive27
#print axioms Paper2.SourceAmplifierLower.source_successor_no_cost_profile27
