import EthInapproximability.CurrentPaper.CostUpdateStages

/-! Lane owner:b-weighted-level-6, unit 2, segment 2b, piece 2 (GENERATED by
`gen_machine.py`): ONE fixed cost-word update program `costProgram` on the
local stack `CostUpdateStages.CS`, the sequential composition (charged
handoffs, `BitMachineRawSequence.program`) of the 14 stages of
`CostUpdateStages`:

seed (constants 1, 2256, 10000, 12, 1280) ; T1 += lam*2256 ; y += T1*lam ;
L += clog lam ; T2 += L*10000 ; y += T2*L ; T3 += s*e ; T4 += T3*12 ;
y += clog T4 ; T5 += b*c ; T6 += T5*s ; T7 += T6*1280 ; y += clog T7 ;
clear of the twelve temporaries.

`cost_run`: from the bank with unary `lam, b, c, s, e, y` in cells 0..5 and
everything else blank, the program halts within `costBound` steps on the SAME
bank except cell 5, which holds unary
`y + (2256*lam^2 + 10000*(clog lam)^2 + clog(12*s*e) + clog(1280*b*c*s) + 1)`. -/

namespace EthInapproximability.CurrentPaper.CostUpdateMachine

open Turing BitMachineEncoding BitMachineStackEmbedding CostUpdateStages

noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 16384

/-- The local bank values: 18 named cells, then four blank scratch cells
(multiplier scratch 18, 19, 20 and copy temporary 21). -/
def st (lam b c s e y K1 K2 K3 K4 T1 L T2 T3 T4 T5 T6 T7 : ℕ) : Fin 22 → ℕ :=
  ![lam, b, c, s, e, y, K1, K2, K3, K4, T1, L, T2, T3, T4, T5, T6, T7, 0, 0, 0, 0]

theorem Runs.mono {L V : Type} {P : L → TM2.Stmt (fun _ : CS => Bool) L V} {l : L} {v : V}
    {S T : CS → List Bool} {B B' : ℕ} (h : Runs P l v S T B) (hB : B ≤ B') :
    Runs P l v S T B' := by
  obtain ⟨t, ht, r⟩ := h
  exact ⟨t, le_trans ht hB, r⟩

