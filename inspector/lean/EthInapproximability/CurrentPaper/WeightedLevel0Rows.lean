set_option synthInstance.maxHeartbeats 2000000

abbrev CStack := WeightedScalarComplete.Stack ⊕ (Fin 7 ⊕ WeightedRawWords.Aux)

def rawEmb : WeightedRawWords.Global ↪ CStack :=
  ⟨Sum.elim Sum.inl (fun a => Sum.inr (Sum.inr a)), by
    intro x y h
    cases x <;> cases y <;> simp_all⟩

def levelEmb : WeightedLevelColumnSave.Stack ↪ CStack :=
  ⟨Sum.elim Sum.inl (fun j => Sum.inr (Sum.inl j)), by
    intro x y h
    cases x <;> cases y <;> simp_all⟩

/-- Writer cell `k` in the combined bank. -/
def wc (k : Fin 64) : CStack := levelEmb (WeightedLevelColumnSave.wcell k)
/-- Master cell `a` in the combined bank. -/
def mc (a : WeightedRawWords.Aux) : CStack := Sum.inr (Sum.inr a)

theorem wc_inj {j k : Fin 64} (h : wc j = wc k) : j = k :=
  WeightedColumnActualStage.writerSlots.injective (Sum.inl.inj h)

theorem wc_ne_mc (k : Fin 64) (a : WeightedRawWords.Aux) : wc k ≠ mc a := by
  intro h; cases h

def wtab : Fin 16 → Fin 64 := ![9, 15, 16, 17, 29, 21, 1, 7, 18, 47, 48, 49, 50, 51, 52, 53]

theorem wtab_inj : Function.Injective wtab := by decide

def rowCell : Fin 1 ⊕ (Fin 16 ⊕ Fin 19) → CStack :=
  Sum.elim (fun _ => mc (.w 7))
    (Sum.elim (fun k => wc (wtab k)) (fun m => mc (.nat 3 m.val)))

theorem rowCell_inj : Function.Injective rowCell := by
  refine Function.Injective.sumElim (fun a b _ => Subsingleton.elim a b) ?_ ?_
  · refine Function.Injective.sumElim ?_ ?_ ?_
    · intro a b h
      exact wtab_inj (wc_inj h)
    · intro a b h
      have h' : WeightedRawWords.Aux.nat 3 a.val = WeightedRawWords.Aux.nat 3 b.val :=
        Sum.inr.inj (Sum.inr.inj h)
      injection h' with _ h''
      exact Fin.ext h''
    · intro a b h
      exact wc_ne_mc _ _ h
  · intro a b h
    rcases b with b | b
    · exact wc_ne_mc _ _ h.symm
    · have h' : WeightedRawWords.Aux.w 7 = WeightedRawWords.Aux.nat 3 b.val :=
        Sum.inr.inj (Sum.inr.inj h)
      cases h'

def rowEquiv : WeightedRowFields.LStack ≃ Fin 1 ⊕ (Fin 16 ⊕ Fin 19) :=
  (finSumFinEquiv (m := 1) (n := 35)).symm.trans
    (Equiv.sumCongr (Equiv.refl _) (finSumFinEquiv (m := 16) (n := 19)).symm)

def rowEmb : WeightedRowFields.LStack ↪ CStack :=
  rowEquiv.toEmbedding.trans ⟨rowCell, rowCell_inj⟩

def clr : Fin 9 → Fin 64 := ![7, 18, 47, 48, 49, 50, 51, 52, 53]

def cells9 : Fin 9 → CStack := fun i => wc (clr i)

theorem clr_inj : Function.Injective clr := by decide

theorem cells9_inj : Function.Injective cells9 := by
  intro a b h
  exact clr_inj (wc_inj h)

/-- The combined start bank: the raw-words start bank, all else blank. -/
def startC (packet : List Bool) : CStack → List Bool :=
  Sum.elim (fun x => WeightedRawWords.startBank packet (Sum.inl x))
    (Sum.elim (fun _ => []) (fun a => WeightedRawWords.startBank packet (Sum.inr a)))

variable (M : BitMachine.Machine)

def rawC (c : ℕ) := fun l => stackStmt rawEmb (WeightedVertexWord.rawWordsKVProgram M c l)
def levelC := fun l => stackStmt levelEmb (WeightedLevelFields15.program l)
def clearC := WeightedRawWords.clearProgram cells9
def rowC := fun l => stackStmt rowEmb (WeightedRowFields.rowProgram l)

def p3 := BitMachineRawSequence.program clearC rowC (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)))))) ((), none) WeightedRowFields.rowInit
def p2 := BitMachineRawSequence.program levelC p3 (BitMachineRawSequence.leftLabel (0 : Fin (9 + 2)))
  WeightedLevelFields15.initialControl (((), none), WeightedRowFields.rowInit)
/-- The fixed level-0 program up to the row fields. -/
def level0RowsProgram (c : ℕ) := BitMachineRawSequence.program (rawC M c) p2
  (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan))))))
  ((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl)
  (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))


