import EthInapproximability.CurrentPaper.WeightedLevel0Target

/-! Lane owner:b-weighted-level-4, unit 2, segment 1 (1c-iii), piece 1c-b
(GENERATED by gen_ready.py; start label, control and packet copied literally
from the frozen `WeightedLevel0Rows.level0_rows` statement).

The `MatrixTableWriter.ready` frame of the admitted physical-step writer start.
Global stack `GStack = CStack ⊕ (Fin 3 ⊕ MatrixTableWriter.Extra)`: the level-0
combined bank plus the writer's three index cells and seven extra cells. The
writer stack `MatrixWeightedOrderWriter.Stack = (Fin 64 ⊕ Fin 3) ⊕ Extra` embeds
by `wEmb`, whose `Fin 64` part is the SAME writer region `wc k` the level-0
program wrote (no copy of the writer bank is made).

ONE fixed program `readyProgram M c`: the lifted `cleanProgram M c` (1b); a
charged copy of the `rows` word (master `nat 3 0`) into the writer's `rows`
cell; a charged copy of the `cols` word (master `nat 3 1`) into `cols` (both
with the blank writer index cell 0 as the copy's temporary); a charged pop clear
of the two master sources. Three charged handoffs.

`ready_writer`: at the exit, EVERY writer-stack cell except writer 22 equals the
literal stack of the admitted `ProtectedFullBankBridgeScratch.actualWriterStart`
at level 0 (i.e. `MatrixTableWriter.ready (sourceBank (persistentBank d) |VG|
(s-3) (4s)) rows cols 0 0 0 0 [] []`); `ready_writer22`: writer 22 is blank
(named premise, lane owner:b-stage4-entry-program-2). -/

namespace EthInapproximability.CurrentPaper.WeightedLevel0Ready

open Turing BitMachineEncoding BitMachineStackEmbedding
open EthInapproximability.ParameterizedNP.GuardedSourceGraph
open WeightedLevel0Rows WeightedLevel0Persist WeightedLevel0Clean WeightedLevel0Target

noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 8192
set_option synthInstance.maxSize 200000
set_option synthInstance.maxHeartbeats 2000000

abbrev GStack := CStack ⊕ (Fin 3 ⊕ MatrixTableWriter.Extra)

def cEmb : CStack ↪ GStack := ⟨Sum.inl, Sum.inl_injective⟩

def wMap : MatrixWeightedOrderWriter.Stack → GStack
  | .inl (.inl k) => Sum.inl (wc k)
  | .inl (.inr i) => Sum.inr (Sum.inl i)
  | .inr e => Sum.inr (Sum.inr e)

theorem wMap_inj : Function.Injective wMap := by
  intro a b h
  rcases a with (k | i) | e <;> rcases b with (k' | i') | e'
  · exact congrArg (fun k => Sum.inl (Sum.inl k)) (wc_inj (Sum.inl.inj h))
  · cases h
  · cases h
  · cases h
  · exact congrArg (fun i => Sum.inl (Sum.inr i)) (Sum.inl.inj (Sum.inr.inj h))
  · cases h
  · cases h
  · cases h
  · exact congrArg Sum.inr (Sum.inr.inj (Sum.inr.inj h))

/-- The writer stack inside the global stack. -/
def wEmb : MatrixWeightedOrderWriter.Stack ↪ GStack := ⟨wMap, wMap_inj⟩

def srcR : GStack := Sum.inl (mc (.nat 3 0))
def srcC : GStack := Sum.inl (mc (.nat 3 1))
def dstR : GStack := Sum.inr (Sum.inr .rows)
def dstC : GStack := Sum.inr (Sum.inr .cols)
def tmpI : GStack := Sum.inr (Sum.inl 0)

def iR : Fin 3 ↪ GStack := ⟨![srcR, dstR, tmpI], by
  intro a b h
  fin_cases a <;> fin_cases b <;> first | rfl | (exfalso; cases h)⟩
def iC : Fin 3 ↪ GStack := ⟨![srcC, dstC, tmpI], by
  intro a b h
  fin_cases a <;> fin_cases b <;> first | rfl | (exfalso; cases h)⟩
def cells2 : Fin 2 → GStack := ![srcR, srcC]
theorem cells2_inj : Function.Injective cells2 := by
  intro a b h
  fin_cases a <;> fin_cases b <;> first | rfl | (exfalso; cases h)

variable (M : BitMachine.Machine)

def liftClean (c : ℕ) := fun l => stackStmt cEmb (cleanProgram M c l)
def copyR := MatrixStage4ScalarPreparationOps.copyProgram iR
def copyC := MatrixStage4ScalarPreparationOps.copyProgram iC
def clear2 := WeightedRawWords.clearProgram cells2

def pCD := BitMachineRawSequence.program copyC clear2 (0 : Fin 4) (none : Option Bool) ((), none)
def pBCD := BitMachineRawSequence.program copyR pCD
  (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan) (none : Option Bool)
  ((none : Option Bool), ((), none))
/-- ONE fixed program: level-0 composite, clear, rows/cols into the writer frame. -/
def readyProgram (c : ℕ) := BitMachineRawSequence.program (liftClean M c) pBCD
  (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)
  ((((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))), ((), none))
  ((none : Option Bool), ((none : Option Bool), ((), none)))

variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

/-- Global start bank: the packet in the raw-words input cell, all else blank. -/
def G0 (packet : List Bool) : GStack → List Bool := Sum.elim (startC packet) (fun _ => [])

def G1 (L : CStack → List Bool) : GStack → List Bool :=
  Sum.elim (BitMachineClearBank.cleared clearCells L) (fun _ => [])
def G2 (L : CStack → List Bool) : GStack → List Bool :=
  Function.update (G1 L) (iR 1) (G1 L (iR 0) ++ G1 L (iR 1))
def G3 (L : CStack → List Bool) : GStack → List Bool :=
  Function.update (G2 L) (iC 1) (G2 L (iC 0) ++ G2 L (iC 1))
/-- The exit bank of `readyProgram`, as an exact function of the level-0 exit. -/
def G4 (L : CStack → List Bool) : GStack → List Bool :=
  BitMachineClearBank.cleared cells2 (G3 L)

/-- The clock of `cleanProgram` (1b). -/
def cleanBound (G : EndpointGraph V E) (n c : ℕ) : ℕ :=
  bound0 M G n c +
    (nClear * (BitMachineStackGrowth.perStep (level0RowsProgram M c) * bound0 M G n c) +
      nClear + 2) + 1

theorem bank_cEmb (packet : List Bool) (S : CStack → List Bool) :
    bank cEmb (G0 packet) S = Sum.elim S (fun _ => []) := by
  funext x
  rcases x with x | y
  · exact bank_at cEmb (G0 packet) S x
  · rw [bank_outside _ _ _ _ (by rintro ⟨k, hk⟩; cases hk)]
    rfl

theorem G1_srcR (L : CStack → List Bool) :
    G1 L srcR = L (mc (.nat 3 0)) :=
  clean_master L (.nat 3 0) (by intro h; cases h)
theorem G1_srcC (L : CStack → List Bool) :
    G1 L srcC = L (mc (.nat 3 1)) :=
  clean_master L (.nat 3 1) (by intro h; cases h)

theorem level0_ready (G : EndpointGraph V E) (n c : ℕ) :
    ∃ F : ETHBinsJoinedScratch.Stack → List Bool,
    ∃ Q : WeightedGraphQJoined.Stack → List Bool,
    ∃ P : ChosenPrimeRaw.Stack → List Bool,
    ∃ t ≤ cleanBound M G n c +
        ((2 * ProtectedFullBankBridgeScratch.actualRows G c (EffectiveIteration.sourceDepth n)
            (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
            (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix + 2) +
          ((2 * ProtectedFullBankBridgeScratch.actualCols G c (EffectiveIteration.sourceDepth n)
            (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
            (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix + 2) +
            (ProtectedFullBankBridgeScratch.actualRows G c (EffectiveIteration.sourceDepth n)
              (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
              (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix +
             ProtectedFullBankBridgeScratch.actualCols G c (EffectiveIteration.sourceDepth n)
              (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
              (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix + 4) + 1) + 1) + 1,
      ((advance (readyProgram M c))^[t])
        ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (.inl (.scan 0))))))),
          (((((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))),
          G0 (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G)))⟩ =
        ⟨none, (((((none, ((), ((WeightedRawWords.level0Ctrl, (WeightedRawWords.edgesCtrl, WeightedRawWords.tailCtrl)), WeightedRawWords.kCtrl M))), WeightedVertexWord.vertexCtrl), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit))), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))),
          G4 (level0RowsBank M G n c F Q P)⟩ ∧
      level0Facts M G n c F Q P := by
  obtain ⟨F, Q, P, t1, ht1, h1, hf⟩ := level0_clean M G n c
  have hf' := hf
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hR, hC⟩ := hf'
  -- phase A: the lifted clean program
  have rA := WeightedRawWords.region_run cEmb (cleanProgram M c) _ _ t1 h1
    (G0 (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G)))) (fun k => rfl)
  rw [bank_cEmb] at rA
  -- phase B: copy the rows word into the writer's rows cell
  have tB : G1 (level0RowsBank M G n c F Q P) (iR 2) = [] := rfl
  have sB := MatrixStage4ScalarPreparationOps.copy_run iR (G1 (level0RowsBank M G n c F Q P)) tB
  have lB : (G1 (level0RowsBank M G n c F Q P) (iR 0)).length =
      ProtectedFullBankBridgeScratch.actualRows G c (EffectiveIteration.sourceDepth n)
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix := by
    show (G1 (level0RowsBank M G n c F Q P) srcR).length = _
    rw [G1_srcR, hR, List.length_replicate]
  rw [lB] at sB
  -- phase C: copy the cols word into the writer's cols cell
  have tC : G2 (level0RowsBank M G n c F Q P) (iC 2) = [] := by
    show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ tmpI = []
    rw [Function.update_of_ne (by intro h; cases h)]
    rfl
  have sC := MatrixStage4ScalarPreparationOps.copy_run iC (G2 (level0RowsBank M G n c F Q P)) tC
  have lC : (G2 (level0RowsBank M G n c F Q P) (iC 0)).length =
      ProtectedFullBankBridgeScratch.actualCols G c (EffectiveIteration.sourceDepth n)
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix := by
    show (Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ srcC).length = _
    rw [Function.update_of_ne (by intro h; cases h), G1_srcC, hC, List.length_replicate]
  rw [lC] at sC
  -- phase D: clear the two master sources
  have sD := WeightedRawWords.clear_run cells2 cells2_inj (G3 (level0RowsBank M G n c F Q P))
  have lD : (∑ i, (G3 (level0RowsBank M G n c F Q P) (cells2 i)).length) =
      ProtectedFullBankBridgeScratch.actualRows G c (EffectiveIteration.sourceDepth n)
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix +
      ProtectedFullBankBridgeScratch.actualCols G c (EffectiveIteration.sourceDepth n)
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix := by
    rw [Fin.sum_univ_two]
    have e0 : G3 (level0RowsBank M G n c F Q P) (cells2 0) =
        G1 (level0RowsBank M G n c F Q P) srcR := by
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ srcR = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ srcR = _
      rw [Function.update_of_ne (by intro h; cases h)]
    have e1 : G3 (level0RowsBank M G n c F Q P) (cells2 1) =
        G1 (level0RowsBank M G n c F Q P) srcC := by
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ srcC = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ srcC = _
      rw [Function.update_of_ne (by intro h; cases h)]
    rw [e0, e1, G1_srcR, G1_srcC, hR, hC, List.length_replicate, List.length_replicate]
  rw [lD] at sD
  -- compose (three charged handoffs)
  obtain ⟨v3, hv3, q3⟩ := BitMachineRawSequence.runs copyC clear2 _ _ _ _ _ _
    (G2 (level0RowsBank M G n c F Q P)) (G3 (level0RowsBank M G n c F Q P))
    (G4 (level0RowsBank M G n c F Q P)) _ _ sC sD
  obtain ⟨v2, hv2, q2⟩ := BitMachineRawSequence.runs copyR pCD _ _ _ _ _ _
    (G1 (level0RowsBank M G n c F Q P)) (G2 (level0RowsBank M G n c F Q P))
    (G4 (level0RowsBank M G n c F Q P)) _ _ sB q3
  obtain ⟨v1, hv1, q1⟩ := BitMachineRawSequence.runs (liftClean M c) pBCD _ _ _ _ _ _
    (G0 (SourceOriginalBranchPackets.packet n (EncodedGraph.encode (EncodedETHSource.serializeGraph G)))) (G1 (level0RowsBank M G n c F Q P))
    (G4 (level0RowsBank M G n c F Q P)) _ _ rA q2
  refine ⟨F, Q, P, v1, ?_, q1, hf⟩
  have ht1' : t1 ≤ cleanBound M G n c := ht1
  omega

/-- The writer frame: every writer-stack cell except writer 22 is literally the
admitted level-0 `actualWriterStart` stack. -/
theorem ready_writer (G : EndpointGraph V E) (n c : ℕ)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : level0Facts M G n c F Q P) (w : MatrixWeightedOrderWriter.Stack)
    (hw : w ≠ .inl (.inl 22)) :
    G4 (level0RowsBank M G n c F Q P) (wEmb w) =
      (ProtectedFullBankBridgeScratch.actualWriterStart G c (EffectiveIteration.sourceDepth n)
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).budget 0
        (Iteration.seedState (EffectiveIteration.sourceDepth n)).matrix).stk w := by
  have hf' := hf
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hR, hC⟩ := hf'
  have out4 : ∀ x : GStack, x ≠ srcR → x ≠ srcC →
      G4 (level0RowsBank M G n c F Q P) x = G3 (level0RowsBank M G n c F Q P) x := by
    intro x h0 h1
    apply BitMachineClearBank.cleared_foreign
    intro i hi
    fin_cases i
    · exact h0 hi.symm
    · exact h1 hi.symm
  rcases w with (k | i) | e
  · have hk : k ≠ 22 := fun h => hw (by rw [h])
    have hx : wEmb (.inl (.inl k)) = Sum.inl (wc k) := rfl
    rw [hx, out4 _ (by intro h; exact wc_ne_mc k _ (Sum.inl.inj h))
      (by intro h; exact wc_ne_mc k _ (Sum.inl.inj h))]
    show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inl (wc k)) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inl (wc k)) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show BitMachineClearBank.cleared clearCells (level0RowsBank M G n c F Q P) (wc k) = _
    rw [clean_writer_target M G n c F Q P hf k, actualWriterStart_cells G n c k hk]
  · have hx : wEmb (.inl (.inr i)) = Sum.inr (Sum.inl i) := rfl
    rw [hx, out4 _ (by intro h; cases h) (by intro h; cases h)]
    have e3 : G3 (level0RowsBank M G n c F Q P) (Sum.inr (Sum.inl i)) = [] := by
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inr (Sum.inl i)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inr (Sum.inl i)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    rw [e3]
    fin_cases i <;> rfl
  · have hx : wEmb (.inr e) = Sum.inr (Sum.inr e) := rfl
    rw [hx, out4 _ (by intro h; cases h) (by intro h; cases h)]
    cases e with
    | rows =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ dstR = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ dstR = _
      rw [Function.update_self]
      show G1 (level0RowsBank M G n c F Q P) srcR ++ [] = _
      rw [G1_srcR, hR, List.append_nil]
      rfl
    | cols =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ dstC = _
      rw [Function.update_self]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ srcC ++
        Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ dstC = _
      rw [Function.update_of_ne (by intro h; cases h), Function.update_of_ne (by intro h; cases h),
        G1_srcC, hC]
      show List.replicate _ true ++ [] = _
      rw [List.append_nil]
      rfl
    | rowsLeft =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inr (Sum.inr .rowsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inr (Sum.inr .rowsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | colsLeft =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inr (Sum.inr .colsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inr (Sum.inr .colsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | temp =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inr (Sum.inr .temp)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inr (Sum.inr .temp)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | buffer =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inr (Sum.inr .buffer)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inr (Sum.inr .buffer)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | output =>
      show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inr (Sum.inr .output)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inr (Sum.inr .output)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl

/-- Writer 22 is blank at the exit: the named premise `d.rawBits` is NOT written here. -/
theorem ready_writer22 (G : EndpointGraph V E) (n c : ℕ)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool) :
    G4 (level0RowsBank M G n c F Q P) (wEmb (.inl (.inl 22))) = [] := by
  show BitMachineClearBank.cleared cells2 (G3 (level0RowsBank M G n c F Q P)) (Sum.inl (wc 22)) = []
  rw [BitMachineClearBank.cleared_foreign _ _ _ (by
    intro i hi
    fin_cases i
    · exact wc_ne_mc 22 _ (Sum.inl.inj hi).symm
    · exact wc_ne_mc 22 _ (Sum.inl.inj hi).symm)]
  show Function.update (G2 (level0RowsBank M G n c F Q P)) dstC _ (Sum.inl (wc 22)) = _
  rw [Function.update_of_ne (by intro h; cases h)]
  show Function.update (G1 (level0RowsBank M G n c F Q P)) dstR _ (Sum.inl (wc 22)) = _
  rw [Function.update_of_ne (by intro h; cases h)]
  exact clean_writer _ 22 (by decide)

#print axioms level0_ready
#print axioms ready_writer
#print axioms ready_writer22

end
