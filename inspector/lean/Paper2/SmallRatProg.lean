-- The generated bank identities reduce by kernel computation at fixed cells.
macro "bsimp" : tactic => `(tactic| rfl)

/-- The explicit clock: the nineteen part clocks plus eighteen handoffs. -/
def ratBd (n a am bd b6 s w L Q : ℕ) : ℕ :=
    MatrixAddressMachine.exactTime (a) (am) 0 +
    MatrixAddressMachine.exactTime (bd) (n) 0 +
    MatrixAddressMachine.exactTime (a) (bd * n) 0 +
    MatrixAddressMachine.exactTime (b6) (am) 0 +
    (max (a * am) (a * (bd * n)) + (a * am) + (a * (bd * n)) + 3) +
    (max (max (a * am) (a * (bd * n))) (b6 * am) + (max (a * am) (a * (bd * n))) + (b6 * am) + 3) +
    1 +
    MatrixAddressMachine.exactTime (65536) (s) 0 +
    MatrixAddressMachine.exactTime (65536 * s) (max (max (a * am) (a * (bd * n))) (b6 * am)) 0 +
    1 +
    MatrixAddressMachine.exactTime (16) (w) 0 +
    MatrixAddressMachine.exactTime (65536 * s * (max (max (a * am) (a * (bd * n))) (b6 * am))) (16 * w) 0 +
    1 +
    (4 * 2 ^ (L) + 5 * (L) + 7) +
    1 +
    MatrixAddressMachine.exactTime (10) (L) 0 +
    (4 * 2 ^ (10 * L) + 5 * (10 * L) + 7) +
    1 +
    MatrixAddressMachine.exactTime (320) (Q) 0 + 18

/-
/-- **The run.** From `B0` the program halts within `ratBd` in exactly the bank `B19`. -/
theorem rat_run (n a am bd b6 s w L Q : ℕ) :
    ∃ t ≤ ratBd n a am bd b6 s w L Q, ((advance ratProg)^[t]) (⟨some ratStart, ratCtl, B0 n a am bd b6 s w L Q⟩ :
      TM2.Cfg (fun _ : AK => Bool) _ _) = ⟨none, ratCtl, B19 n a am bd b6 s w L Q⟩ := by
  have h1 : ((advance P1)^[MatrixAddressMachine.exactTime (a) (am) 0]) (⟨some MatrixAddressMachine.Label.outer, false, (B0 n a am bd b6 s w L Q)⟩ :
      TM2.Cfg (fun _ : AK => Bool) MatrixAddressMachine.Label Bool) = ⟨none, false, B1 n a am bd b6 s w L Q⟩ :=
    mulS c1 hc1 (B0 n a am bd b6 s w L Q) (a) (am) (by bsimp) (by bsimp) (by bsimp) (by bsimp) (by bsimp) (by bsimp)
  obtain ⟨t1, ht1⟩ : ∃ t, t = MatrixAddressMachine.exactTime (a) (am) 0 := ⟨_, rfl⟩
  rw [← ht1] at h1
  have h2 : ((advance P2)^[MatrixAddressMachine.exactTime (bd) (n) 0]) (⟨some MatrixAddressMachine.Label.outer, false, (B1 n a am bd b6 s w L Q)⟩ :
      TM2.Cfg (fun _ : AK => Bool) MatrixAddressMachine.Label Bool) = ⟨none, false, B2 n a am bd b6 s w L Q⟩ :=
    mulS c2 hc2 (B1 n a am bd b6 s w L Q) (bd) (n) (by bsimp) (by bsimp) (by bsimp) (by bsimp) (by bsimp) (by bsimp)
  obtain ⟨t2, ht2⟩ : ∃ t, t = MatrixAddressMachine.exactTime (bd) (n) 0 := ⟨_, rfl⟩
  rw [← ht2] at h2
  have h3 : ((advance P3)^[MatrixAddressMachine.exactTime (a) (bd * n) 0]) (⟨some MatrixAddressMachine.Label.outer, false, (B2 n a am bd b6 s w L Q)⟩ :
      TM2.Cfg (fun _ : AK => Bool) MatrixAddressMachine.Label Bool) = ⟨none, false, B3 n a am bd b6 s w L Q⟩ :=
    mulS c3 hc3 (B2 n a am bd b6 s w L Q) (a) (bd * n) (by bsimp) (by bsimp) (by bsimp) (by bsimp) (by bsimp) (by bsimp)
