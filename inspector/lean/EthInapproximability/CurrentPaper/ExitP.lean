noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 8192
set_option synthInstance.maxSize 200000
set_option synthInstance.maxHeartbeats 2000000

variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

theorem exit_blank_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (x : HStack) (hx : ∀ a, x ≠ mcell a) :
    Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) x = [] := by
  unfold Level0CleanRun.blankBridge
  by_cases hb : ∃ y, pEmb y = x
  · rw [if_pos hb]
  rw [if_neg hb]
  have hw22 : x ≠ w22 := fun e => hb ⟨.inl (.inl (.inl 22)), e.symm⟩
  dsimp only [S2J, S22J]
  rw [Function.update_of_ne (hx .Y), Function.update_of_ne hw22]
  rcases x with ((s | i | a) | i | e) | o | sx | u
  · show G4 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P) (Sum.inl (Sum.inl s)) = []
    by_cases hs : s ∈ keepS
    · exfalso
      obtain ⟨k, _, hk⟩ := Finset.mem_map.1 hs
      subst hk
      exact hb ⟨.inl (.inl (.inl k)), rfl⟩
    · rw [G4_comb _ _ (by intro h; cases h) (by intro h; cases h)]
      exact clean_scalar _ s hs
  · show G4 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P) (Sum.inl (Sum.inr (Sum.inl i))) = []
    rw [G4_comb _ _ (by intro h; cases h) (by intro h; cases h)]
    exact clean_save _ i
  · exact absurd rfl (hx a)
  · exact absurd ⟨.inl (.inl (.inr i)), rfl⟩ hb
  · exact absurd ⟨.inl (.inr e), rfl⟩ hb
  · exact absurd ⟨.inr o, rfl⟩ hb
  · rfl
  · rfl

#print axioms exit_blank_j

theorem exit_master_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (a : WeightedRawWords.Aux) (hY : a ≠ .Y) :
    Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell a) =
      BitMachineClearBank.cleared cells2 (G3 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P))
        (Sum.inl (mc a)) := by
  simp only [Level0CleanRun.blankBridge]
  rw [if_neg (mcell_outside a)]
  dsimp only [S2J, S22J]
  rw [Function.update_of_ne (mcell_Y_ne a hY), Function.update_of_ne (w22_ne_mcell a).symm]
  rfl

theorem exit_master_w7_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool) :
    Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell (.w 7)) =
      List.replicate (Fintype.card V) true := by
  rw [exit_master_j G c b yb j Mx mS F Q P (.w 7) (by intro h; cases h)]
  rw [show BitMachineClearBank.cleared cells2 (G3 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P))
      (Sum.inl (mc (.w 7))) = G4 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P) (Sum.inl (mc (.w 7)))
      from rfl]
  rw [G4_comb _ _ (by intro h; cases h) (by intro h; cases h), clean_master _ (.w 7) (by intro h; cases h),
    show mc (.w 7) = rowEmb 0 from rfl, rows_rowcell]
  rfl

theorem exit_master_other_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (a : WeightedRawWords.Aux) (hY : a ≠ .Y) (hN : a ≠ .N) (h7 : a ≠ .w 7) (hn : ∀ m, a ≠ .nat 3 m) :
    Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell a) = mS a := by
  rw [exit_master_j G c b yb j Mx mS F Q P a hY]
  exact ready_master_j G c b (yb) j (Mx) mS F Q P a hN h7 hn

/-- Every `nat 3 m` master is blank after the level composite and the ready frame's clear. -/
theorem exit_master_nat3_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (hN : ∀ m, mS (.nat 3 m) = [])
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool) (m : ℕ) :
    Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell (.nat 3 m)) = [] := by
  rw [exit_master_j G c b yb j Mx mS F Q P (.nat 3 m) (by intro h; cases h)]
  by_cases h0 : m = 0
  · subst h0
    unfold BitMachineClearBank.cleared
    rw [if_pos ⟨0, rfl⟩]
  by_cases h1 : m = 1
  · subst h1
    unfold BitMachineClearBank.cleared
    rw [if_pos ⟨1, rfl⟩]
  rw [show BitMachineClearBank.cleared cells2 (G3 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P))
      (Sum.inl (mc (.nat 3 m))) = G4 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P)
        (Sum.inl (mc (.nat 3 m))) from rfl]
  rw [G4_comb _ _ (by intro h; have := Sum.inr.inj (Sum.inr.inj h); cases this; exact h0 rfl)
      (by intro h; have := Sum.inr.inj (Sum.inr.inj h); cases this; exact h1 rfl),
    clean_master _ (.nat 3 m) (by intro h; cases h)]
  by_cases h19 : m < 19
  · have key : ∀ k (hk : k < 19), 2 ≤ k → mc (.nat 3 k) = rowEmb ⟨17 + k, by omega⟩ := by
      intro k hk h2
      interval_cases k <;> rfl
    rw [key m h19 (by omega), rows_rowcell]
    interval_cases m <;> first | (exfalso; omega) | rfl
  · -- outside the row program's image: the installed master value, blank by `hN`
    unfold levelRowsBankJ
    rw [BitMachineStackEmbedding.bank_outside _ _ _ _ (by
      rintro ⟨r, hr⟩
      change rowCell (rowEquiv r) = mc (.nat 3 m) at hr
      rcases hq : rowEquiv r with z | (k | k)
      · rw [hq] at hr
        have := Sum.inr.inj (Sum.inr.inj hr)
        cases this
      · rw [hq] at hr
        exact wc_ne_mc _ _ hr
      · rw [hq] at hr
        have h' := Sum.inr.inj (Sum.inr.inj hr)
        injection h' with _ h''
        have := k.isLt
        omega)]
    have hn9 : ¬ ∃ i, cells9 i = mc (.nat 3 m) := by
      rintro ⟨i, hi⟩
      exact wc_ne_mc _ _ hi
    show (if ∃ i, cells9 i = mc (.nat 3 m) then [] else C2j G c b (yb) j (Mx) mS F Q P (mc (.nat 3 m))) = []
    rw [if_neg hn9]
    show bank levelEmb (C1j G c b (yb) j (Mx) mS) (Zj G c b (yb) j (Mx) F Q P)
      (Sum.inr (Sum.inr (.nat 3 m))) = []
    rw [bank_outside _ _ _ _ (by
      rintro ⟨k, hk⟩
      rcases k with k | k <;> cases hk)]
    show bank rawEmb _ _ (rawEmb (Sum.inr (.nat 3 m))) = []
    rw [bank_at]
    exact hN m

#print axioms exit_master_j
#print axioms exit_master_w7_j
#print axioms exit_master_other_j
#print axioms exit_master_nat3_j

end
