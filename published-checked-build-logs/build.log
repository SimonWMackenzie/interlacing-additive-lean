| some
  stageOut =>
  have hout : out = stageOut := by
    rw [hcomp] at hrun
    exact (Option.some.inj hrun).symm
  subst out
  obtain ⟨encPrev, hprevBound⟩ := ih (by omega) prev hprev
  let encExtended := appendSource_commonDenominator prev alphabet encPrev ea
  have hn : 0 < n := by simpa [n, F] using generatedFeatures_pos (q + 1) D (alphabet.map Prod.fst)
