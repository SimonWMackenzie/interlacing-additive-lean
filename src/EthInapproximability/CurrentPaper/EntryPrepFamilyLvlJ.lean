theorem mid4_tail_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (j : TSt) :
    midBank4_j G c bJ yb lv Mx mS F Q P (tailEmb j) =
      RawTableTail.startBank (EntryRunsRaw.cellBank (wMid4_j G c bJ yb lv Mx)) (EntryTailJ.r0J G c bJ yb lv Mx) (EntryTailJ.c0J G c bJ yb lv Mx)
        (EntryTailJ.WlvlJ G c bJ yb lv Mx mS F Q P) j := by
  unfold midBank4_j
  rw [bank_at]

theorem mid4_free_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (f : Free) : midBank4_j G c bJ yb lv Mx mS F Q P (fmap f) = [] := by
  rcases f with r | o
  · show midBank4_j G c bJ yb lv Mx mS F Q P (tailEmb (rj r)) = []
    rw [mid4_tail_j]
    simp only [rj, RawTableTail.startBank, RawTableTail.glob, MatrixTableWriter.Data.contents,
      MatrixTableWriter.Data.cell, MatrixTableWriter.ready, EntryRunsRaw.cellBank, Sum.elim_inl,
      Equiv.symm_apply_apply, Sum.elim_inr]
  · show midBank4_j G c bJ yb lv Mx mS F Q P (nwMap o.1) = []
    unfold midBank4_j
    rw [bank_outside _ _ _ _ (fun ⟨j, hj⟩ => by
      rcases j with x | k | i
      · exact o.2 ⟨_, nwMap_inj hj⟩
      · exact nwMap_ne_wcell _ k hj.symm
      · exact o.2 ⟨_, nwMap_inj hj⟩)]
    exact EntryLevelJBank.exit_blank_nw_j G c bJ yb lv Mx _ _

theorem mid4_master_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (a : WeightedRawWords.Aux) (ha : a = .C ∨ a = .B ∨ a = .Y ∨ a = .E ∨ a = .Gw) :
    midBank4_j G c bJ yb lv Mx mS F Q P (mcell a) = mS a := by
  unfold midBank4_j
  rw [bank_outside _ _ _ _ (fun ⟨j, hj⟩ => tail_ne_m j a ha hj)]
  show G4 (levelRowsBankJ G c bJ yb lv Mx mS F Q P) (Sum.inl (mc a)) = _
  rcases ha with rfl | rfl | rfl | rfl | rfl
  · exact LevelJMasters.ready_master_j G c bJ yb lv Mx mS F Q P .C (by decide) (by decide)
      (fun m h => by cases h)
  · exact LevelJMasters.ready_master_j G c bJ yb lv Mx mS F Q P .B (by decide) (by decide)
      (fun m h => by cases h)
  · exact LevelJMasters.ready_master_j G c bJ yb lv Mx mS F Q P .Y (by decide) (by decide)
      (fun m h => by cases h)
  · exact LevelJMasters.ready_master_j G c bJ yb lv Mx mS F Q P .E (by decide) (by decide)
      (fun m h => by cases h)
  · exact LevelJMasters.ready_master_j G c bJ yb lv Mx mS F Q P .Gw (by decide) (by decide)
      (fun m h => by cases h)

abbrev iP_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) := Iteration.stepParameters G c bJ yb lv Mx

abbrev sP_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) := Parameters.bins (iP_j G c bJ yb lv Mx)

abbrev qP_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) := ParameterizedNP.GuardedSourceSlab.q2 G (sP_j G c bJ yb lv Mx)

abbrev aP_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) := Parameters.firstExponent (iP_j G c bJ yb lv Mx)

abbrev tP_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) := Parameters.balanceOrder (iP_j G c bJ yb lv Mx)

abbrev LPJ (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) :=
  PrimeSampler.size (qP_j G c bJ yb lv Mx) (tP_j G c bJ yb lv Mx) (Construction.qOne (aP_j G c bJ yb lv Mx) * (iP_j G c bJ yb lv Mx).rows)

abbrev dP_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) :=
  ProtectedFullBankBridgeScratch.actualD G c bJ yb lv Mx

/-- The admitted level-wired family clock at level 0. -/
noncomputable def famBound_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  WeightedLevelFields15.publicBound15 (iP_j G c bJ yb lv Mx) (gP G) (Fintype.card E) WeightedRawWords.noW
    (aP_j G c bJ yb lv Mx) (sP_j G c bJ yb lv Mx) (qP_j G c bJ yb lv Mx) (LPJ G c bJ yb lv Mx) (dP_j G c bJ yb lv Mx).binBase (dP_j G c bJ yb lv Mx).rawWidth
    (dP_j G c bJ yb lv Mx).s +
  EntryFamilyLevel.copyBound (aP_j G c bJ yb lv Mx) (qP_j G c bJ yb lv Mx) (LPJ G c bJ yb lv Mx) (iP_j G c bJ yb lv Mx).rows (tP_j G c bJ yb lv Mx) +
  EntryFamilyAssembly.assemblyBound (aP_j G c bJ yb lv Mx) (qP_j G c bJ yb lv Mx) (tP_j G c bJ yb lv Mx) (iP_j G c bJ yb lv Mx).rows + 6

/-- The growth allowance of a level-bank cell (admitted `run_growth`). -/
noncomputable def growB_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  BitMachineStackGrowth.perStep WeightedLevelFields15.program *
    WeightedLevelFields15.publicBound15 (iP_j G c bJ yb lv Mx) (gP G) (Fintype.card E) WeightedRawWords.noW
      (aP_j G c bJ yb lv Mx) (sP_j G c bJ yb lv Mx) (qP_j G c bJ yb lv Mx) (LPJ G c bJ yb lv Mx) (dP_j G c bJ yb lv Mx).binBase (dP_j G c bJ yb lv Mx).rawWidth
      (dP_j G c bJ yb lv Mx).s

/-- The exact family-region exit bank of the re-run. -/
noncomputable def exA_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : EntryFamilyAssembly.ACell → List Bool :=
  EntryFamilyAssembly.exitBank (aP_j G c bJ yb lv Mx) (qP_j G c bJ yb lv Mx) (tP_j G c bJ yb lv Mx) (iP_j G c bJ yb lv Mx).rows
    (Iteration.alphabet_pos G c bJ yb lv Mx)

/-- The admitted start bank of the re-run. -/
noncomputable def SFJ (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) : EntryFamilyLevel.Stack → List Bool :=
  Sum.elim (WeightedLevelColumnSave.initialBank (iP_j G c bJ yb lv Mx) (gP G) WeightedRawWords.noW)
    EntryFamilyLevel.blankA

set_option maxHeartbeats 1000000 in
theorem level_family_j (G : EndpointGraph V E) (c bJ yb lv : ℕ) (Mx : Iteration.Matrix) :
    ∃ Z : WeightedLevelColumnSave.Stack → List Bool, ∃ nn ≤ famBound_j G c bJ yb lv Mx,
      ((advance EntryFamilyLevel.program)^[nn])
          (⟨some (BitMachineRawSequence.leftLabel
              (BitMachineRawSequence.leftLabel
                (BitMachineRawSequence.leftLabel
                  (BitMachineRawSequence.leftLabel
                    (BitMachineRawSequence.leftLabel
                      (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)))))),
            EntryFamilyLevel.initialControl, SFJ G c bJ yb lv Mx⟩ :
            TM2.Cfg (fun _ : EntryFamilyLevel.Stack => Bool) _ _) =
          ⟨none, EntryFamilyLevel.initialControl, Sum.elim Z (exA_j G c bJ yb lv Mx)⟩ ∧
      (∀ j, (Z j).length ≤
        (WeightedLevelColumnSave.initialBank (iP_j G c bJ yb lv Mx) (gP G) WeightedRawWords.noW j).length +
          growB_j G c bJ yb lv Mx) ∧
      exA_j G c bJ yb lv Mx (EntryFamilyAssembly.cell .first) = MatrixStage4FamilyData.fieldTable
        (MatrixStage4FamilyData.familyFirst (Iteration.secondFamily G c bJ yb lv Mx)) ∧
      exA_j G c bJ yb lv Mx (EntryFamilyAssembly.cell .row) = MatrixStage4FamilyData.fieldTable
        (MatrixStage4FamilyData.familyRow (Iteration.secondFamily G c bJ yb lv Mx)) := by
  obtain ⟨F, Q, P, h⟩ := level_family_growth G c bJ yb lv Mx WeightedRawWords.noW
    rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl
  obtain ⟨nn, hnn, hr, hg, h1, h2⟩ := h
  exact ⟨_, nn, hnn, hr, hg, h1, h2⟩

