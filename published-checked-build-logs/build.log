  have hAstep : Astep ≤ A := Nat.pow_le_pow_right (by omega) hH
  have hApow : Astep ^ extended.size ≤ A ^ (alphabet.size * M) :=
    (Nat.pow_le_pow_left hAstep _).trans (Nat.pow_le_pow_right (by positivity) hfuel)
