/-- `actualD_row_fields` at the exact arguments used by `level0RowsBank`
(`d.stagePrefixRows = s*L`, `d.rx = M.rows`, both `rfl`). -/
theorem level_args_row_fields {VG EG : Type} [Fintype VG] [DecidableEq VG] [Fintype EG]
    [DecidableEq EG] (G : EndpointGraph VG EG) (c b y lvl : ℕ) (M : Iteration.Matrix) :
    let d := ProtectedFullBankBridgeScratch.actualD G c b y lvl M
    let f := WeightedRowFields.rowVals (Fintype.card VG) (4 * Iteration.s G c b y lvl M) d.nb
      d.stagePrefixRows d.rx d.binBase d.rawWidth d.uniform
    f 8 = Fintype.card VG ∧ f 9 = d.nv ∧
    f 10 = d.rowBoundary₁ ∧ f 11 = d.rowBoundary₂ ∧ f 12 = d.rowBoundary₃ ∧
    f 13 = d.rowDivisor₀ ∧ f 14 = d.rowDivisor₁ ∧ f 15 = d.rowDivisor₂ ∧
    f 16 = d.rowDivisor₃ ∧
    f 17 = ProtectedFullBankBridgeScratch.actualRows G c b y lvl M ∧
    f 18 = ProtectedFullBankBridgeScratch.actualCols G c b y lvl M := by
  intro d f
  have h1 : d.stagePrefixRows = Iteration.s G c b y lvl M * Iteration.labels G c b y lvl M := rfl
  have h2 : d.rx = M.rows := rfl
  have hf : f = WeightedRowFields.rowVals (Fintype.card VG) (4 * Iteration.s G c b y lvl M) d.nb
      (Iteration.s G c b y lvl M * Iteration.labels G c b y lvl M) M.rows d.binBase d.rawWidth
      d.uniform := by
    show WeightedRowFields.rowVals (Fintype.card VG) (4 * Iteration.s G c b y lvl M) d.nb
      d.stagePrefixRows d.rx d.binBase d.rawWidth d.uniform = _
    rw [h1, h2]
  rw [hf]
  exact WeightedRowFields.actualD_row_fields G c b y lvl M

/-- The row-program image misses every writer cell outside `wtab`. -/
theorem rowEmb_ne_wc (k : Fin 64) (hk : ∀ i, wtab i ≠ k) (j : WeightedRowFields.LStack) :
    rowEmb j ≠ wc k := by
  intro h
  change rowCell (rowEquiv j) = wc k at h
  rcases hr : rowEquiv j with z | (i | m)
  · rw [hr] at h
    exact wc_ne_mc k (.w 7) h.symm
  · rw [hr] at h
    exact hk i (wc_inj (j := wtab i) (k := k) h)
  · rw [hr] at h
    exact wc_ne_mc k (.nat 3 m.val) h.symm

