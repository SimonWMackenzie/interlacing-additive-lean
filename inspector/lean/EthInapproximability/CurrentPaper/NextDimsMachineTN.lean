/-- The exact exit bank values. -/
def Sfin (x : DimIn) : Fin 64 → ℕ :=
  Function.update (Function.update (S0 x) (9 : Fin 64) (rowsOut x)) (10 : Fin 64) (colsOut x)

theorem final_vals (x : DimIn) : clearVals 11 (S63 x) = Sfin x := by
  funext k
  fin_cases k <;> rfl

def startOf {LA LB : Type} (_ : LB) (a : LA) : BitMachineRawSequence.Label LA LB :=
  BitMachineRawSequence.leftLabel a

theorem nkeep_le : 11 ≤ 64 := by decide

def l64 : Fin (64 - 11 + 2) := 0
def c64 : Unit × Option Bool := ((), none)
