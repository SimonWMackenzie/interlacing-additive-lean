import EthInapproximability.CurrentPaper.LevelJMasters
import EthInapproximability.CurrentPaper.OuterLevel0Run

/-! Lane owner:b-weighted-level-8, unit 2, segment 2d, piece 6 (GENERATED by `gen_levelj_prep.py`
from the frozen owner-5 `OuterLevel0Prep.lean` and `OuterLevel0Run.lean`, shas pinned in
RECEIPT): owner-5's prep at an ARBITRARY level. ONE fixed program `prepJProgram` on owner-5's
`HStack`: the lifted `LevelJReady.readyJProgram` ; owner-5's `p27` (the admitted scale controller
`ETHScaleActualComplete.program` aliased onto the six raw-word cells, four charged copies of
`lam`, `b`, `c`, `s` into the outer inputs, charged clear of the scale scratch), reused by exact
name. Start bank `H0J (C1j ...)`; exit bank `exitBankJ … (G4 (levelRowsBankJ …))`. The level-0
literal masters are replaced by the hypotheses `hmC hmB hmY hmE` on `mS` (with `hV hN`). -/

namespace EthInapproximability.CurrentPaper.LevelJPrep

open Turing BitMachineEncoding BitMachineStackEmbedding
open EthInapproximability.ParameterizedNP.GuardedSourceGraph
open WeightedLevel0Rows WeightedLevel0Persist WeightedLevel0Clean WeightedLevel0Target
open WeightedLevel0Ready WeightedLevel0WriterRun LevelJRows LevelJPersist LevelJClean LevelJReady
open LevelJMasters OuterLevel0Prep OuterLevel0Run

noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 8192
set_option synthInstance.maxSize 200000
set_option synthInstance.maxHeartbeats 2000000

def liftReadyJ := fun l => stackStmt hG (readyJProgram l)

/-- ONE fixed program: level ready frame, scale, four charged copies, clear. -/
def prepJProgram := BitMachineRawSequence.program liftReadyJ p27
  (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel ETHScaleActualComplete.oldStart))
  (((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))) ctrl27

variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

/-- The level parameter record (the physical step's `stepParameters`). -/
abbrev Pj (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) : Parameters.Input :=
  Iteration.stepParameters G c b yb lv Mx

def H0J (S : CStack → List Bool) : HStack → List Bool := Sum.elim (G0J S) (fun _ => [])

theorem bank_hGJ (S0 : CStack → List Bool) (S : GStack → List Bool) :
    bank hG (H0J S0) S = K1 S := by
  funext x
  rcases x with x | y
  · exact bank_at hG (H0J S0) S x
  · rw [bank_outside _ _ _ _ (by rintro ⟨k, hk⟩; cases hk)]
    rfl

/-- The exact exit bank of `prepProgram`. -/
def exitBankJ (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (L : GStack → List Bool) : HStack → List Bool :=
  Sum.elim L (Sum.elim (OuterStartBank.outerTarget b c
    (Parameters.bins (Pj G c b yb lv Mx)) (Parameters.scale (Pj G c b yb lv Mx))) (fun _ => []))

/-- The clock of `readyProgram` (literally the bound of owner-4 `level0_ready`). -/
def readyBoundJ (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool) : ℕ :=
  cleanBoundJ G c b yb lv Mx mS +
        ((2 * ProtectedFullBankBridgeScratch.actualRows G c b
            yb lv Mx + 2) +
          ((2 * ProtectedFullBankBridgeScratch.actualCols G c b
            yb lv Mx + 2) +
            (ProtectedFullBankBridgeScratch.actualRows G c b
              yb lv Mx +
             ProtectedFullBankBridgeScratch.actualCols G c b
              yb lv Mx + 4) + 1) + 1) + 1

/-- The clock of the scale stage, the four copies and the clear. -/
def outerBoundJ (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx) +
    ((2 * Parameters.scale (Pj G c b yb lv Mx) + 2) +
      ((2 * b + 2) +
        ((2 * c + 2) +
          ((2 * Parameters.bins (Pj G c b yb lv Mx) + 2) +
            (nS * (ETHParameterScaleMachineInput.wordSize (Pj G c b yb lv Mx) +
                BitMachineStackGrowth.perStep ETHScaleActualComplete.program *
                  ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx)) + nS + 2) + 1) + 1) + 1) + 1) + 1

def prepBoundJ (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool) : ℕ :=
  readyBoundJ G c b yb lv Mx mS + outerBoundJ G c b yb lv Mx + 1

/-- The six level-0 raw words sit in the six aliased source cells. -/
theorem raw_words_j (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (hmC : mS .C = List.replicate c true) (hmB : mS .B = List.replicate b true)
    (hmY : mS .Y = List.replicate (yb + lv) true) (hmE : mS .E = List.replicate (Fintype.card E) true)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b yb lv Mx mS F Q P) (j : Fin 6) :
    K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P)) (rawSrc j) =
      ETHParameterScaleMachineInput.words (Pj G c b yb lv Mx) j := by
  fin_cases j
  · show G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (mc .C)) = _
    rw [ready_master_j G c b yb lv Mx mS F Q P .C
      (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
    exact hmC
  · show G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (mc .B)) = _
    rw [ready_master_j G c b yb lv Mx mS F Q P .B
      (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
    exact hmB
  · show G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (mc .Y)) = _
    rw [ready_master_j G c b yb lv Mx mS F Q P .Y
      (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
    exact hmY
  · have h := ready_writer_j G c b yb lv Mx mS F Q P hf (.inl (.inl 17)) (by decide)
    have h' : G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (wc 17)) = _ := h
    show G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (wc 17)) = _
    rw [h']
    show MatrixWeightedOrderPreparation.sourceBank _ _ _ _ 17 = _
    rw [WeightedLevel0Target.sb_other _ _ _ _ 17 (by decide)]
    simp [MatrixWeightedEntryController.persistentBank, ETHParameterScaleMachineInput.words,
      Iteration.parameters]
    rfl
  · have h := ready_writer_j G c b yb lv Mx mS F Q P hf (.inl (.inl 27)) (by decide)
    have h' : G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (wc 27)) = _ := h
    show G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (wc 27)) = _
    rw [h']
    show MatrixWeightedOrderPreparation.sourceBank _ _ _ _ 27 = _
    rw [WeightedLevel0Target.sb_other _ _ _ _ 27 (by decide)]
    simp [MatrixWeightedEntryController.persistentBank, ETHParameterScaleMachineInput.words,
      Iteration.parameters]
    rfl
  · show G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (mc .E)) = _
    rw [ready_master_j G c b yb lv Mx mS F Q P .E
      (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
    exact hmE

/-- Writer 28 holds unary `bins P0`. -/
theorem writer28_j (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b yb lv Mx mS F Q P) :
    G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (wc 28)) =
      List.replicate (Parameters.bins (Pj G c b yb lv Mx)) true := by
  have h := ready_writer_j G c b yb lv Mx mS F Q P hf (.inl (.inl 28)) (by decide)
  have h' : G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) (Sum.inl (wc 28)) = _ := h
  rw [h']
  show MatrixWeightedOrderPreparation.sourceBank _ _ _ _ 28 = _
  rw [WeightedLevel0Target.sb_other _ _ _ _ 28 (by decide)]
  simp [MatrixWeightedEntryController.persistentBank]
  rfl

/-- The scale controller's initial bank is exactly the global bank seen through `sEmb`. -/
theorem scale_initial_j (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (hmC : mS .C = List.replicate c true) (hmB : mS .B = List.replicate b true)
    (hmY : mS .Y = List.replicate (yb + lv) true) (hmE : mS .E = List.replicate (Fintype.card E) true)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b yb lv Mx mS F Q P) (x : SStack) :
    ETHScaleActualComplete.initialBank (Pj G c b yb lv Mx) x =
      K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P)) (sEmb x) := by
  rcases x with (j | y) | y
  · show _ = K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P)) (rawSrc j)
    rw [raw_words_j G c b yb lv Mx mS hmC hmB hmY hmE F Q P hf j]
    exact bank_at ETHScaleActualComplete.oldEmbed (fun _ => [])
      (ETHScaleGlobalLog.initial (Pj G c b yb lv Mx)) (.inl j)
  · show _ = []
    exact bank_at ETHScaleActualComplete.oldEmbed (fun _ => [])
      (ETHScaleGlobalLog.initial (Pj G c b yb lv Mx)) (.inr y)
  · show _ = []
    rw [ETHScaleActualComplete.initialBank, bank_outside _ _ _ _ (by rintro ⟨k, hk⟩; cases hk)]

theorem level_prep_run_j (G : EndpointGraph V E) (c b yb lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (hV : mS (.w 7) = List.replicate (Fintype.card V) true) (hN : ∀ m, mS (.nat 3 m) = [])
    (hmC : mS .C = List.replicate c true) (hmB : mS .B = List.replicate b true)
    (hmY : mS .Y = List.replicate (yb + lv) true) (hmE : mS .E = List.replicate (Fintype.card E) true) :
    ∃ F : ETHBinsJoinedScratch.Stack → List Bool,
    ∃ Q : WeightedGraphQJoined.Stack → List Bool,
    ∃ P : ChosenPrimeRaw.Stack → List Bool,
    ∃ t ≤ prepBoundJ G c b yb lv Mx mS,
      ((advance (prepJProgram))^[t])
        ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan))))))))),
          ((((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))), ctrl27),
          H0J (C1j G c b yb lv Mx mS)⟩ =
        ⟨none, ((((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))), ctrl27),
          exitBankJ G c b yb lv Mx (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))⟩ ∧
      levelFactsJ G c b yb lv Mx mS F Q P := by
  obtain ⟨F, Q, P, t1, ht1, h1, hf⟩ := level_ready_j G c b yb lv Mx mS hV hN
  -- phase 1: owner-4 readyProgram, lifted
  have r1 := WeightedRawWords.region_run hG (readyJProgram) _ _ t1 h1
    (H0J (C1j G c b yb lv Mx mS)) (fun k => rfl)
  rw [bank_hGJ] at r1
  -- phase 2: the admitted scale controller, aliased onto the six raw words
  obtain ⟨t2, ht2, Fs, h2, hans, _, hraw⟩ := ETHScaleActualComplete.actual_scale_run (Pj G c b yb lv Mx)
  have r2 := WeightedRawWords.region_run sEmb ETHScaleActualComplete.program _ _ t2 h2
    (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) (scale_initial_j G c b yb lv Mx mS hmC hmB hmY hmE F Q P hf)
  -- facts about the bank after the scale stage
  have hK2G : ∀ g : GStack,
      bank sEmb (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) Fs (.inl g) =
        G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) g := by
    intro g
    by_cases hx : ∃ x, sEmb x = (.inl g : HStack)
    · obtain ⟨x, hx⟩ := hx
      rw [← hx, bank_at]
      rcases x with (j | y) | y
      · have e1 : Fs (.inl (.inl j)) = ETHParameterScaleMachineInput.words (Pj G c b yb lv Mx) j := hraw j
        rw [e1, ← raw_words_j G c b yb lv Mx mS hmC hmB hmY hmE F Q P hf j]
        have e2 : rawSrc j = (.inl g : HStack) := hx
        rw [e2]
        rfl
      · cases hx
      · cases hx
    · rw [bank_outside _ _ _ _ hx]
      rfl
  have hK2O : ∀ o : OStk,
      bank sEmb (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) Fs (oc o) = [] := by
    intro o
    rw [bank_outside _ _ _ _ (by
      rintro ⟨x, hx⟩
      rcases x with ((j | y) | y)
      · fin_cases j <;> cases hx
      · cases hx
      · cases hx)]
    rfl
  have hK2T : bank sEmb (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) Fs tmpH = [] := by
    rw [bank_outside _ _ _ _ (by
      rintro ⟨x, hx⟩
      rcases x with ((j | y) | y)
      · fin_cases j <;> cases hx
      · cases hx
      · cases hx)]
    rfl
  have hK2A : bank sEmb (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) Fs
      (fresh (.inr ScaleFinalScratch.answerKey)) =
      List.replicate (Parameters.scale (Pj G c b yb lv Mx)) true := by
    rw [← sEmb_answer, bank_at]
    exact hans
  have hK2F : ∀ x : SStack,
      (bank sEmb (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) Fs (fresh x)).length ≤
        ETHParameterScaleMachineInput.wordSize (Pj G c b yb lv Mx) +
          BitMachineStackGrowth.perStep ETHScaleActualComplete.program *
            ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx) := by
    intro x
    have hg := scale_growth (Pj G c b yb lv Mx) t2 Fs h2 x
    have hm : BitMachineStackGrowth.perStep ETHScaleActualComplete.program * t2 ≤
        BitMachineStackGrowth.perStep ETHScaleActualComplete.program *
          ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx) := Nat.mul_le_mul_left _ ht2
    rw [fresh_bank]
    rcases x with (j | y) | y
    · show ([] : List Bool).length ≤ _
      exact Nat.zero_le _
    · exact le_trans hg (by omega)
    · exact le_trans hg (by omega)
  -- phase 3: four charged copies
  let K2 := bank sEmb (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) Fs
  let K3 := Function.update K2 (iL 1) (K2 (iL 0) ++ K2 (iL 1))
  let K4 := Function.update K3 (iB 1) (K3 (iB 0) ++ K3 (iB 1))
  let K5 := Function.update K4 (OuterLevel0Prep.iC 1) (K4 (OuterLevel0Prep.iC 0) ++ K4 (OuterLevel0Prep.iC 1))
  let K6 := Function.update K5 (iS 1) (K5 (iS 0) ++ K5 (iS 1))
  have hK2G' : ∀ g : GStack, K2 (.inl g) = G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) g := hK2G
  have hK2O' : ∀ o : OStk, K2 (oc o) = [] := hK2O
  have hK2T' : K2 tmpH = [] := hK2T
  have hK2A' : K2 (fresh (.inr ScaleFinalScratch.answerKey)) =
      List.replicate (Parameters.scale (Pj G c b yb lv Mx)) true := hK2A
  have hK2F' : ∀ x : SStack, (K2 (fresh x)).length ≤
      ETHParameterScaleMachineInput.wordSize (Pj G c b yb lv Mx) +
        BitMachineStackGrowth.perStep ETHScaleActualComplete.program *
          ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx) := hK2F
  have hK6G : ∀ g : GStack, K6 (.inl g) = G4 (levelRowsBankJ G c b yb lv Mx mS F Q P) g := by
    intro g
    show Function.update K5 (oc (rIn 2)) _ (.inl g) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K4 (oc (rIn 1)) _ (.inl g) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K3 (oc (rIn 0)) _ (.inl g) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K2 (oc oIn) _ (.inl g) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    exact hK2G' g
  have hK6F : ∀ x : SStack, K6 (fresh x) = K2 (fresh x) := by
    intro x
    show Function.update K5 (oc (rIn 2)) _ (fresh x) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K4 (oc (rIn 1)) _ (fresh x) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K3 (oc (rIn 0)) _ (fresh x) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K2 (oc oIn) _ (fresh x) = _
    rw [Function.update_of_ne (by intro h; cases h)]
  have hK6T : K6 tmpH = [] := by
    show Function.update K5 (oc (rIn 2)) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K4 (oc (rIn 1)) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K3 (oc (rIn 0)) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K2 (oc oIn) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    exact hK2T'
  have hB : K3 (mcell .B) = List.replicate b true := by
    show Function.update K2 (oc oIn) _ (mcell .B) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show K2 (.inl (Sum.inl (mc .B))) = _
    rw [hK2G', ready_master_j G c b yb lv Mx mS F Q P .B
      (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
    exact hmB
  have hC : K4 (mcell .C) = List.replicate c true := by
    show Function.update K3 (oc (rIn 0)) _ (mcell .C) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K2 (oc oIn) _ (mcell .C) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show K2 (.inl (Sum.inl (mc .C))) = _
    rw [hK2G', ready_master_j G c b yb lv Mx mS F Q P .C
      (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
    exact hmC
  have hS : K5 (wcell 28) = List.replicate (Parameters.bins (Pj G c b yb lv Mx)) true := by
    show Function.update K4 (oc (rIn 1)) _ (wcell 28) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K3 (oc (rIn 0)) _ (wcell 28) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update K2 (oc oIn) _ (wcell 28) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show K2 (.inl (Sum.inl (wc 28))) = _
    rw [hK2G']
    exact writer28_j G c b yb lv Mx mS F Q P hf
  have s3 := MatrixStage4ScalarPreparationOps.copy_run iL K2 hK2T'
  have l3 : (K2 (iL 0)).length = Parameters.scale (Pj G c b yb lv Mx) := by
    show (K2 (fresh (.inr ScaleFinalScratch.answerKey))).length = _
    rw [hK2A', List.length_replicate]
  rw [l3] at s3
  have t4 : K3 (iB 2) = [] := by
    show Function.update K2 (oc oIn) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    exact hK2T'
  have s4 := MatrixStage4ScalarPreparationOps.copy_run iB K3 t4
  have l4 : (K3 (iB 0)).length = b := by
    show (K3 (mcell .B)).length = _
    rw [hB, List.length_replicate]
  rw [l4] at s4
  have t5 : K4 (OuterLevel0Prep.iC 2) = [] := by
    show Function.update K3 (oc (rIn 0)) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    exact t4
  have s5 := MatrixStage4ScalarPreparationOps.copy_run OuterLevel0Prep.iC K4 t5
  have l5 : (K4 (OuterLevel0Prep.iC 0)).length = c := by
    show (K4 (mcell .C)).length = _
    rw [hC, List.length_replicate]
  rw [l5] at s5
  have t6 : K5 (iS 2) = [] := by
    show Function.update K4 (oc (rIn 1)) _ tmpH = _
    rw [Function.update_of_ne (by intro h; cases h)]
    exact t5
  have s6 := MatrixStage4ScalarPreparationOps.copy_run iS K5 t6
  have l6 : (K5 (iS 0)).length = Parameters.bins (Pj G c b yb lv Mx) := by
    show (K5 (wcell 28)).length = _
    rw [hS, List.length_replicate]
  rw [l6] at s6
  -- phase 4: clear the fresh scale region
  have s7 := WeightedRawWords.clear_run cellsS cellsS_inj K6
  have l7 : (∑ i, (K6 (cellsS i)).length) ≤
      nS * (ETHParameterScaleMachineInput.wordSize (Pj G c b yb lv Mx) +
        BitMachineStackGrowth.perStep ETHScaleActualComplete.program *
          ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx)) := by
    have hb : ∀ i ∈ (Finset.univ : Finset (Fin nS)), (K6 (cellsS i)).length ≤
        ETHParameterScaleMachineInput.wordSize (Pj G c b yb lv Mx) +
          BitMachineStackGrowth.perStep ETHScaleActualComplete.program *
            ETHScaleActualComplete.totalBound (Pj G c b yb lv Mx) := by
      intro i _
      show (K6 (fresh _)).length ≤ _
      rw [hK6F]
      exact hK2F' _
    have := Finset.sum_le_card_nsmul (Finset.univ : Finset (Fin nS)) _ _ hb
    simpa [Finset.card_univ, Fintype.card_fin, smul_eq_mul] using this
  -- compose (six charged handoffs)
  obtain ⟨u6, hu6, q6⟩ := BitMachineRawSequence.runs cpS clearS _ _ _ _ _ _ K5 K6
    (BitMachineClearBank.cleared cellsS K6) _ _ s6 s7
  obtain ⟨u5, hu5, q5⟩ := BitMachineRawSequence.runs cpC p67 _ _ _ _ _ _ K4 K5
    (BitMachineClearBank.cleared cellsS K6) _ _ s5 q6
  obtain ⟨u4, hu4, q4⟩ := BitMachineRawSequence.runs cpB p57 _ _ _ _ _ _ K3 K4
    (BitMachineClearBank.cleared cellsS K6) _ _ s4 q5
  obtain ⟨u3, hu3, q3⟩ := BitMachineRawSequence.runs cpL p47 _ _ _ _ _ _ K2 K3
    (BitMachineClearBank.cleared cellsS K6) _ _ s3 q4
  obtain ⟨u2, hu2, q2⟩ := BitMachineRawSequence.runs liftScale p37 _ _ _ _ _ _
    (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P))) K2
    (BitMachineClearBank.cleared cellsS K6) _ _ r2 q3
  obtain ⟨u1, hu1, q1⟩ := BitMachineRawSequence.runs (liftReadyJ) p27 _ _ _ _ _ _
    (H0J (C1j G c b yb lv Mx mS))
    (K1 (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P)))
    (BitMachineClearBank.cleared cellsS K6) _ _ r1 q2
  -- the exit bank is exactly `exitBank`
  have hexit : BitMachineClearBank.cleared cellsS K6 =
      exitBankJ G c b yb lv Mx (G4 (levelRowsBankJ G c b yb lv Mx mS F Q P)) := by
    funext z
    rcases z with g | (o | (x | u))
    · rw [BitMachineClearBank.cleared_foreign _ _ _ (by intro i h; cases h)]
      exact hK6G g
    · rw [BitMachineClearBank.cleared_foreign _ _ _ (by intro i h; cases h)]
      show K6 (oc o) = OuterStartBank.outerTarget _ _ _ _ o
      rw [outerTarget_cells]
      by_cases e0 : o = oIn
      · subst e0
        rw [if_pos rfl]
        show Function.update K5 (oc (rIn 2)) _ (oc oIn) = _
        rw [Function.update_of_ne (oc_ne (oIn_ne_rIn 2))]
        show Function.update K4 (oc (rIn 1)) _ (oc oIn) = _
        rw [Function.update_of_ne (oc_ne (oIn_ne_rIn 1))]
        show Function.update K3 (oc (rIn 0)) _ (oc oIn) = _
        rw [Function.update_of_ne (oc_ne (oIn_ne_rIn 0))]
        show Function.update K2 (oc oIn) _ (oc oIn) = _
        rw [Function.update_self]
        show K2 (fresh (.inr ScaleFinalScratch.answerKey)) ++ K2 (oc oIn) = _
        rw [hK2A', hK2O', List.append_nil]
      rw [if_neg e0]
      by_cases e1 : o = rIn 0
      · subst e1
        rw [if_pos rfl]
        show Function.update K5 (oc (rIn 2)) _ (oc (rIn 0)) = _
        rw [Function.update_of_ne (oc_ne (rIn_ne (by decide)))]
        show Function.update K4 (oc (rIn 1)) _ (oc (rIn 0)) = _
        rw [Function.update_of_ne (oc_ne (rIn_ne (by decide)))]
        show Function.update K3 (oc (rIn 0)) _ (oc (rIn 0)) = _
        rw [Function.update_self]
        show K3 (mcell .B) ++ K3 (oc (rIn 0)) = _
        rw [hB]
        show _ ++ Function.update K2 (oc oIn) _ (oc (rIn 0)) = _
        rw [Function.update_of_ne (oc_ne (oIn_ne_rIn 0)).symm, hK2O', List.append_nil]
      rw [if_neg e1]
      by_cases e2 : o = rIn 1
      · subst e2
        rw [if_pos rfl]
        show Function.update K5 (oc (rIn 2)) _ (oc (rIn 1)) = _
        rw [Function.update_of_ne (oc_ne (rIn_ne (by decide)))]
        show Function.update K4 (oc (rIn 1)) _ (oc (rIn 1)) = _
        rw [Function.update_self]
        show K4 (mcell .C) ++ K4 (oc (rIn 1)) = _
        rw [hC]
        show _ ++ Function.update K3 (oc (rIn 0)) _ (oc (rIn 1)) = _
        rw [Function.update_of_ne (oc_ne (rIn_ne (by decide)))]
        show _ ++ Function.update K2 (oc oIn) _ (oc (rIn 1)) = _
        rw [Function.update_of_ne (oc_ne (oIn_ne_rIn 1)).symm, hK2O', List.append_nil]
      rw [if_neg e2]
      by_cases e3 : o = rIn 2
      · subst e3
        rw [if_pos rfl]
        show Function.update K5 (oc (rIn 2)) _ (oc (rIn 2)) = _
        rw [Function.update_self]
        show K5 (wcell 28) ++ K5 (oc (rIn 2)) = _
        rw [hS]
        show _ ++ Function.update K4 (oc (rIn 1)) _ (oc (rIn 2)) = _
        rw [Function.update_of_ne (oc_ne (rIn_ne (by decide)))]
        show _ ++ Function.update K3 (oc (rIn 0)) _ (oc (rIn 2)) = _
        rw [Function.update_of_ne (oc_ne (rIn_ne (by decide)))]
        show _ ++ Function.update K2 (oc oIn) _ (oc (rIn 2)) = _
        rw [Function.update_of_ne (oc_ne (oIn_ne_rIn 2)).symm, hK2O', List.append_nil]
      rw [if_neg e3]
      show Function.update K5 (oc (rIn 2)) _ (oc o) = _
      rw [Function.update_of_ne (oc_ne e3)]
      show Function.update K4 (oc (rIn 1)) _ (oc o) = _
      rw [Function.update_of_ne (oc_ne e2)]
      show Function.update K3 (oc (rIn 0)) _ (oc o) = _
      rw [Function.update_of_ne (oc_ne e1)]
      show Function.update K2 (oc oIn) _ (oc o) = _
      rw [Function.update_of_ne (oc_ne e0)]
      exact hK2O' o
    · have e : cellsS (Fintype.equivFin SStack x) = fresh x := by
        show fresh ((Fintype.equivFin SStack).symm (Fintype.equivFin SStack x)) = _
        rw [Equiv.symm_apply_apply]
      show BitMachineClearBank.cleared cellsS K6 (fresh x) = []
      rw [← e]
      exact BitMachineClearBank.cleared_bank cellsS K6 _
    · rw [BitMachineClearBank.cleared_foreign _ _ _ (by intro i h; cases h)]
      exact hK6T
  rw [hexit] at q1
  refine ⟨F, Q, P, u1, ?_, q1, hf⟩
  have ht1' : t1 ≤ readyBoundJ G c b yb lv Mx mS := ht1
  unfold prepBoundJ outerBoundJ
  omega

