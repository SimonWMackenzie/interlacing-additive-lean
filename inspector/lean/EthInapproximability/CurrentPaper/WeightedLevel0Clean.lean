import EthInapproximability.CurrentPaper.WeightedLevel0Persist

/-! Lane owner:b-weighted-level-4, unit 2, segment 1 (1c-iii), piece 1b
(GENERATED by gen_clean.py; the level-0 clock, start label, control and packet
are copied literally from the frozen `WeightedLevel0Rows.level0_rows` statement).

The charged clearing of every non-persistent cell after the level-0 composite,
as ONE fixed program `cleanProgram M c = level0RowsProgram M c ; clearProgram clearCells`
(one charged handoff, `BitMachineRawSequence.runs`), with the pop clear of the
production-backed `WeightedRawWords.clear_run` (`BitMachineClearBank.clear_bank_run`).

`clearCells` is ONE fixed finite injective enumeration (a fixed classical
`Fintype.equivFin` renaming, no input dependence) of
* every cell of the scalar/writer region `WeightedScalarComplete.Stack` EXCEPT the
  23 writer cells `keepW = {1,3,4,6,7,8,9,15,16,17,18,21,26,27,28,29,47..53}`
  (this contains the existential scalar scratch `F, Q, P` of the frozen level
  controller, writer 22, writer 60, writers 54/56/57, and every other writer cell),
* the seven cells of the level controller's retained `save` region,
* the raw-words master cell `N` (unary `n`, not used after level 0).
The master cells `Gw, C, B, E, Y, Jc, K, w 7` and the rows/cols words in
`nat 3 0/1` are kept for later phases. Each cleared cell is blank in the start
bank, so its length at the level-0 exit is bounded by the admitted
`BitMachineStackGrowth.run_growth` of the SAME level-0 run; the clear is charged
the sum of those lengths plus `nClear + 2`. -/

namespace EthInapproximability.CurrentPaper.WeightedLevel0Clean

open Turing BitMachineEncoding BitMachineStackEmbedding
open EthInapproximability.ParameterizedNP.GuardedSourceGraph
open WeightedLevel0Rows WeightedLevel0Persist

noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 8192
set_option synthInstance.maxSize 200000
set_option synthInstance.maxHeartbeats 2000000

/-- The writer cells kept nonblank (the physical step's writer start cells;
writer 22 is excluded: it is the named premise of the entry-program lane). -/
def keepW : Finset (Fin 64) :=
  {1, 3, 4, 6, 7, 8, 9, 15, 16, 17, 18, 21, 26, 27, 28, 29, 47, 48, 49, 50, 51, 52, 53}

def keepS : Finset WeightedScalarComplete.Stack :=
  keepW.map WeightedColumnActualStage.writerSlots

/-- Index type of the cleared cells. -/
abbrev ClearIdx := {x : WeightedScalarComplete.Stack // x ∉ keepS} ⊕ (Fin 7 ⊕ Unit)

noncomputable instance : Fintype ClearIdx := by
  classical
  exact inferInstance

def clearMap : ClearIdx → CStack
  | .inl x => Sum.inl x.1
  | .inr (.inl j) => Sum.inr (Sum.inl j)
  | .inr (.inr _) => mc .N

theorem clearMap_inj : Function.Injective clearMap := by
  intro a b h
  rcases a with x | j | u <;> rcases b with y | k | v
  · exact congrArg Sum.inl (Subtype.ext (Sum.inl.inj h))
  · cases h
  · cases h
  · cases h
  · exact congrArg (fun j => Sum.inr (Sum.inl j)) (Sum.inl.inj (Sum.inr.inj h))
  · cases h
  · cases h
  · cases h
  · cases u; cases v; rfl

/-- Number of cleared cells (a fixed natural number). -/
def nClear : ℕ := Fintype.card ClearIdx

/-- The fixed injective enumeration of the cleared cells. -/
def clearCells : Fin nClear → CStack :=
  fun i => clearMap ((Fintype.equivFin ClearIdx).symm i)

theorem clearCells_inj : Function.Injective clearCells :=
  clearMap_inj.comp (Fintype.equivFin ClearIdx).symm.injective

theorem clearCells_iff (x : CStack) : (∃ i, clearCells i = x) ↔ ∃ z, clearMap z = x := by
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨_, hi⟩
  · rintro ⟨z, hz⟩
    refine ⟨Fintype.equivFin ClearIdx z, ?_⟩
    simp only [clearCells, Equiv.symm_apply_apply]
    exact hz

theorem startC_clear (packet : List Bool) (i : Fin nClear) : startC packet (clearCells i) = [] := by
  obtain ⟨z, hz⟩ : ∃ z, clearMap z = clearCells i := (clearCells_iff _).1 ⟨i, rfl⟩
  rw [← hz]
  rcases z with x | j | u
  · show Function.update (fun _ => []) (WeightedRawWords.aux .input) packet (Sum.inl x.1) = []
    rw [Function.update_of_ne (fun h => by cases h)]
  · rfl
  · show Function.update (fun _ => []) (WeightedRawWords.aux .input) packet
      (Sum.inr WeightedRawWords.Aux.N) = []
    exact Function.update_of_ne (show (Sum.inr WeightedRawWords.Aux.N : WeightedRawWords.Global) ≠
      WeightedRawWords.aux .input from fun h => by cases h) _ _

/-! ## Cell facts of the cleared bank (generic in the bank) -/

theorem clean_keep (L : CStack → List Bool) (k : Fin 64) (hk : k ∈ keepW) :
    BitMachineClearBank.cleared clearCells L (wc k) = L (wc k) := by
  apply BitMachineClearBank.cleared_foreign
  intro i hi
  obtain ⟨z, hz⟩ := (clearCells_iff _).1 ⟨i, hi⟩
  rcases z with x | j | u
  · have hx : x.1 = WeightedColumnActualStage.writerSlots k := Sum.inl.inj hz
    exact x.2 (by rw [hx]; exact Finset.mem_map_of_mem _ hk)
  · cases hz
  · cases hz

theorem clean_scalar (L : CStack → List Bool) (x : WeightedScalarComplete.Stack)
    (hx : x ∉ keepS) : BitMachineClearBank.cleared clearCells L (Sum.inl x) = [] := by
  obtain ⟨i, hi⟩ := (clearCells_iff (Sum.inl x)).2 ⟨.inl ⟨x, hx⟩, rfl⟩
  rw [← hi]
  exact BitMachineClearBank.cleared_bank _ _ _

theorem clean_writer (L : CStack → List Bool) (k : Fin 64) (hk : k ∉ keepW) :
    BitMachineClearBank.cleared clearCells L (wc k) = [] := by
  apply clean_scalar
  intro hm
  obtain ⟨k', hk', he⟩ := Finset.mem_map.1 hm
  exact hk (WeightedColumnActualStage.writerSlots.injective he ▸ hk')

theorem clean_save (L : CStack → List Bool) (j : Fin 7) :
    BitMachineClearBank.cleared clearCells L (Sum.inr (Sum.inl j)) = [] := by
  obtain ⟨i, hi⟩ := (clearCells_iff (Sum.inr (Sum.inl j))).2 ⟨.inr (.inl j), rfl⟩
  rw [← hi]
  exact BitMachineClearBank.cleared_bank _ _ _

theorem clean_N (L : CStack → List Bool) :
    BitMachineClearBank.cleared clearCells L (mc .N) = [] := by
  obtain ⟨i, hi⟩ := (clearCells_iff (mc .N)).2 ⟨.inr (.inr ()), rfl⟩
  rw [← hi]
  exact BitMachineClearBank.cleared_bank _ _ _

theorem clean_master (L : CStack → List Bool) (a : WeightedRawWords.Aux) (ha : a ≠ .N) :
    BitMachineClearBank.cleared clearCells L (mc a) = L (mc a) := by
  apply BitMachineClearBank.cleared_foreign
  intro i hi
  obtain ⟨z, hz⟩ := (clearCells_iff _).1 ⟨i, hi⟩
  rcases z with x | j | u
  · cases hz
  · cases hz
  · exact ha (Sum.inr.inj (Sum.inr.inj hz)).symm

variable (M : BitMachine.Machine)
variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

