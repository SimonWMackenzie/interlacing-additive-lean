/-- The fresh region after the dims run. -/
def DJ (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mw : List Bool) : Fin 57 → List Bool :=
  Function.update (Function.update (Dmw mw) 0
      (List.replicate (EffectiveIteration.nextRows ((Pj G c b yb j Mx))) true)) 1
    (List.replicate (EffectiveIteration.nextColumns ((Pj G c b yb j Mx)) (Fintype.card V)) true)

theorem rp_succ_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (hP : Pj G c b yb j Mx = EffectiveIteration.runParameters G c b (Iteration.seedState b) j) :
    EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1) =
      EffectiveIteration.nextInput ((Pj G c b yb j Mx)) (Fintype.card V) :=
  by rw [EffectiveIteration.runParameters_succ G c b (Iteration.seedState b) j, hP]

theorem DJ_rows (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (hP : Pj G c b yb j Mx = EffectiveIteration.runParameters G c b (Iteration.seedState b) j) (mw : List Bool) :
    DJ G c b yb j Mx mw 0 = ETHParameterScaleMachineInput.words
      (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 3 := by
  show _ = List.replicate (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)).rows true
  rw [rp_succ_j G c b yb j Mx hP]
  unfold DJ
  rw [Function.update_of_ne (show (0 : Fin 57) ≠ 1 by decide), Function.update_self] <;> rfl

theorem DJ_cols (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (hP : Pj G c b yb j Mx = EffectiveIteration.runParameters G c b (Iteration.seedState b) j) (mw : List Bool) :
    DJ G c b yb j Mx mw 1 = ETHParameterScaleMachineInput.words
      (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 4 := by
  show _ = List.replicate (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)).columns true
  rw [rp_succ_j G c b yb j Mx hP]
  unfold DJ
  rw [Function.update_self] <;> rfl

theorem DJ_out (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mw : List Bool) : DJ G c b yb j Mx mw 55 = mw := by
  unfold DJ Dmw
  rw [Function.update_of_ne (show (55 : Fin 57) ≠ 1 by decide),
    Function.update_of_ne (show (55 : Fin 57) ≠ 0 by decide), Function.update_self]

/-- ONE fixed level-`j` round program: prep ; writer 22 ; cost update ; dims recompute ;
physical step. -/
def round4JProgram {LW VW : Type} (W : LW → TM2.Stmt (fun _ : H4 => Bool) LW VW)
    (w₀ : LW) (v₀ : VW) :=
  BitMachineRawSequence.program (lift4 prepJProgram)
    (BitMachineRawSequence.program W
      (BitMachineRawSequence.program (costOn costEmb4)
        (BitMachineRawSequence.program (NextDimsEmbedTN.dimsOn dimsEmb) (lift4 bridgeH)
          MatrixTableInterlaceProtectedBridge.start NextDimsMachineTN.dimsCtrl bridgeCtrl)
        (BitMachineRawSequence.leftLabel NextDimsMachineTN.dimsStart) costCtrl
        (NextDimsMachineTN.dimsCtrl, bridgeCtrl))
      (BitMachineRawSequence.leftLabel costStart) v₀
      (costCtrl, (NextDimsMachineTN.dimsCtrl, bridgeCtrl)))
    (BitMachineRawSequence.leftLabel w₀)
    ((((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))), ctrl27)
    (v₀, (costCtrl, (NextDimsMachineTN.dimsCtrl, bridgeCtrl)))

theorem level_dims_round_j [Fintype MatrixTableInterlaceProtectedBridge.Label]
    (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (hP : Pj G c b yb j Mx = EffectiveIteration.runParameters G c b (Iteration.seedState b) j) (hb : 1 ≤ b) (hc : 1 ≤ c)
    (mS : WeightedRawWords.Aux → List Bool)
    (hV : mS (.w 7) = List.replicate (Fintype.card V) true) (hN : ∀ m, mS (.nat 3 m) = [])
    (hmC : mS .C = List.replicate c true) (hmB : mS .B = List.replicate b true)
    (hmY : mS .Y = List.replicate (yb + j) true)
    (hmE : mS .E = List.replicate (Fintype.card E) true) (mw : List Bool)
