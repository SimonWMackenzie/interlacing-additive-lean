theorem rep_u (k : ℕ) : List.replicate k true = u k := rfl
theorem cons_u (k : ℕ) : true :: u k = u (k + 1) := rfl
theorem u_app (a b : ℕ) : u a ++ u b = u (a + b) := (List.replicate_add a b true).symm
theorem tail_u (a : ℕ) : (u a).tail = u (a - 1) := List.tail_replicate
theorem C0_def (L s w : ℕ) : L * w * s * 2 ^ 24 * 5 = C0 L s w := rfl
theorem A2_def (a b Δ n m L s w : ℕ) :
    (a * m + C0 L s w * (2 * b * Δ) * n - 1) / (a * m) = A2 a b Δ n m L s w := rfl
theorem A3_def (a b L s w : ℕ) : (a - 1 + C0 L s w * (6144 * b)) / a = A3 a b L s w := rfl

/-- The explicit clock (sum of the twenty-three part clocks and twenty-two handoffs). -/
def qBd (a b Δ n m L s w : ℕ) : ℕ :=
  1 + (4 * 2 ^ 24 + 5 * 24 + 7) + MatrixAddressMachine.exactTime L w 0 +
    MatrixAddressMachine.exactTime (L * w) s 0 + MatrixAddressMachine.exactTime (L * w * s) (2 ^ 24) 0 +
    1 + MatrixAddressMachine.exactTime (L * w * s * 2 ^ 24) 5 0 + 1 +
    MatrixAddressMachine.exactTime (C0 L s w) (2 * b * Δ) 0 + MatrixAddressMachine.exactTime ((C0 L s w) * (2 * b * Δ)) n 0 + 1 +
    MatrixAddressMachine.exactTime a m 0 + (2 * (a * m) + 2) + 1 +
    MatrixUnaryDivision.totalTime (a * m + C0 L s w * (2 * b * Δ) * n - 1) (a * m) + 1 + MatrixAddressMachine.exactTime (C0 L s w) (6144 * b) 0 + 1 +
    MatrixUnaryDivision.totalTime (a - 1 + C0 L s w * (6144 * b)) a +
    (max (C0 L s w) (A2 a b Δ n m L s w) + (C0 L s w) + (A2 a b Δ n m L s w) + 3) + (max (max (C0 L s w) (A2 a b Δ n m L s w)) (A3 a b L s w) + (max (C0 L s w) (A2 a b Δ n m L s w)) + (A3 a b L s w) + 3) +
    logBd (max (max (C0 L s w) (A2 a b Δ n m L s w)) (A3 a b L s w)) + (4 * 2 ^ Nat.clog 2 (max (max (C0 L s w) (A2 a b Δ n m L s w)) (A3 a b L s w)) + 5 * Nat.clog 2 (max (max (C0 L s w) (A2 a b Δ n m L s w)) (A3 a b L s w)) + 7) + 22

