variable (D : DinurReduction) (B : BOTReduction (booleanOccurrence D))

set_option hygiene false in
local notation "EXP" Φ:max k:max => TotalFiniteConstructorScratch.experiment (t10_vertices_pos D B Φ)
  (CanonicalEdgeTape.graphEdge (t10Graph D B Φ) (t10Graph_valid D B Φ)) B.degreeBound (sourceGap D B) k

/-- Square power-of-two variant of the estimator hypothesis (verbatim from a-eth-owner-1
`AEthClass.EstimatesGrowingSelSq`). -/
def EstimatesGrowingSelSq (E : SelectedTape.Algorithm) (c : ℝ) : Prop :=
  ∀ w (d : ℕ), AModel.targetD w = some d → ADecider.SquareWord w →
    2 / 3 ≤ E.prob w (fun out => ∃ v, AModel.decodeDyadic out = some v ∧
      |v - d| ≤ ADecider.accT c w)

theorem estimatesGrowingSelSq_of (E : SelectedTape.Algorithm) (c : ℝ)
    (h : EstimatesGrowingSel E c) : EstimatesGrowingSelSq E c :=
  fun w d hd _ => h w d hd

/-- **The growing gap exceeds twice the accuracy at every square printed word.** -/
theorem gap_at_mwSq (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    ∃ N₀ : ℕ, ∀ Φ : ValidFormula, Φ.val.clauses.length ≤ cs * Φ.val.variables →
      N₀ ≤ Φ.val.variables → ∀ b : (EXP Φ (kOf Φ.val.variables)).output.Tape,
      2 * ADecider.accT c (ADecider.mwSqOf D B Φ (kOf Φ.val.variables) b) <
        (kOf Φ.val.variables : ℝ) := by
  obtain ⟨N₁, hN₁⟩ := gap_exceeds_twice_error_square B.degreeBound (sourceGap D B)
    (source_gap_pos D B) (by have := B.degreeBound_pos; omega) (D.sizeExponent + 2)
    c hc0 hc
  obtain ⟨M, hM⟩ := A3CloseEndpoints.T24_final D B EncodedCNF.Language AEndpoint.DA2_recommended
    cs c hc0 hc true
  obtain ⟨N₂, hN₂⟩ := hM 1 one_pos
  refine ⟨max (max N₁ N₂) (2 ^ (2 ^ (D.sizeExponent + 1) * Paper2.Unit4Shell.T10Size.t45C D B cs)),
    ?_⟩
  intro Φ hsp hN b
  have h1 : N₁ ≤ Φ.val.variables := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hN
  have h2 : N₂ ≤ Φ.val.variables := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hN
  have h4 : 2 ^ (2 ^ (D.sizeExponent + 1) * Paper2.Unit4Shell.T10Size.t45C D B cs) ≤
      Φ.val.variables := le_trans (le_max_right _ _) hN
  haveI : NeZero (t10Graph D B Φ).vertices := ⟨(t10_vertices_pos D B Φ).ne'⟩
  obtain ⟨_, _, hinc, hdeg, _, _, _⟩ := t10_source D B Φ
  obtain ⟨hNm, hmn, _⟩ := Paper2.Unit4Shell.T10Size.t45_relations D B Φ
  have hsize := Paper2.Unit4Shell.T10Size.t45_shell_form D B cs Φ hsp h4
  have hgap := hN₁ Φ.val.variables h1 _ _
    (CanonicalEdgeTape.graphEdge (t10Graph D B Φ) (t10Graph_valid D B Φ)) hinc hdeg hNm hmn hsize
  obtain ⟨_, _, _, _, hent, _⟩ := hN₂ Φ hsp h2
  have hentE : SquarePadding.entries (EXP Φ (kOf Φ.val.variables)).output.rows
      (EXP Φ (kOf Φ.val.variables)).output.cols =
      printedTsq (t10Graph D B Φ).vertices (t10Graph D B Φ).edges.length B.degreeBound
        (sourceGap D B) (kOf Φ.val.variables) := by
    rw [TotalFiniteConstructorScratch.experiment_output_eq_select]; exact hent
  rw [ADecider.accT_mwSqOf, hentE]
  linarith [hgap]

/-- The headered square printed word at reduction tape `b`. -/
def headerWordSq (Φ : ValidFormula) (k : ℕ) (b : (EXP Φ k).output.Tape) : List Bool :=
  natField (2 * (EXP Φ k).output.budget + k) ++ ADecider.mwSqOf D B Φ k b

/-- **Per-tape classifier bounds at the growing gap, square words.** -/
theorem classifier_per_tape_sq (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    ∃ N₀ : ℕ, ∀ Φ : ValidFormula, Φ.val.clauses.length ≤ cs * Φ.val.variables →
      N₀ ≤ Φ.val.variables → ∀ E : SelectedTape.Algorithm, EstimatesGrowingSelSq E c →
      ∀ b : (EXP Φ (kOf Φ.val.variables)).output.Tape,
      (Workspace.Types.CommComplexity.D
          ((EXP Φ (kOf Φ.val.variables)).output.table b).matrix ≤
          (EXP Φ (kOf Φ.val.variables)).output.budget →
        99 / 100 ≤ (Paper2.HeaderStrip.selectedClassifier E).prob
          (headerWordSq D B Φ (kOf Φ.val.variables) b) (· = [true])) ∧
      ((EXP Φ (kOf Φ.val.variables)).output.budget + kOf Φ.val.variables ≤
          Workspace.Types.CommComplexity.D
            ((EXP Φ (kOf Φ.val.variables)).output.table b).matrix →
        (Paper2.HeaderStrip.selectedClassifier E).prob
          (headerWordSq D B Φ (kOf Φ.val.variables) b) (· = [true]) ≤ 1 / 100) := by
  obtain ⟨N₀, hN₀⟩ := gap_at_mwSq D B cs c hc0 hc
  refine ⟨N₀, fun Φ hsp hN E hE b => ?_⟩
  have hk : 2 * ADecider.accT c (ADecider.mwSqOf D B Φ (kOf Φ.val.variables) b) <
      ((kOf Φ.val.variables : ℕ) : ℝ) := hN₀ Φ hsp hN b
  have hA := hE _ _ (ADecider.targetD_mwSqOf D B Φ (kOf Φ.val.variables) b)
    (ADecider.squareWord_mwSqOf D B Φ (kOf Φ.val.variables) b)
  exact ⟨fun hle => selectedClassifier_yes_at E _ _ _ _ _ hA hk hle,
    fun hge => selectedClassifier_no_at E _ _ _ _ _ hA hk hge⟩

/-- **Route-B output identity** (a deterministic machine statement with the tape pushforward):
one classifier tape length `s` for all reduction tapes, a split `π` of the decider tape whose
pushforward is (reduction law) × (uniform length-`s` tape), and the decider prints what the A27
classifier prints on the headered printed word with the second component. -/
def JoinRealisesSq (Φ : ValidFormula) (k : ℕ) (E : SelectedTape.Algorithm)
    (A : ETape.Algorithm) : Prop :=
  letI : Fintype (EXP Φ k).output.Tape := (EXP Φ k).tapeFintype
  ∃ (s : ℕ) (π : (Fin (A.tapeLen (EncodedCNF.encode Φ.val).length) → Bool) →
      (EXP Φ k).output.Tape × (Fin s → Bool)),
    (∀ b, (Paper2.HeaderStrip.selectedClassifier E).tapeLength (headerWordSq D B Φ k b) = s) ∧
    (∀ P : (EXP Φ k).output.Tape × (Fin s → Bool) → Prop,
      (uniformTape (A.tapeLen (EncodedCNF.encode Φ.val).length)).prob (fun t => P (π t)) =
        ((EXP Φ k).tapeLaw.prod (uniformTape s)).prob P) ∧
    ∀ t, A.output (EncodedCNF.encode Φ.val) (List.ofFn t) =
      (Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ k (π t).1)
        (List.ofFn (π t).2)

set_option maxHeartbeats 2000000 in
/-- **Route B, segment 4.** Error `≤ 1/3` (in fact `≥ 99/100` / `≤ 29/1000`) for every effective
decider realising the route-B identity at `k = kOf N`, sparse valid `Φ`, `N ≥ N₀`. -/
theorem decider_error_join_sq (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    ∃ N₀ : ℕ, ∀ Φ : ValidFormula, Φ.val.clauses.length ≤ cs * Φ.val.variables →
      N₀ ≤ Φ.val.variables → ∀ (E : SelectedTape.Algorithm) (A : ETape.Algorithm),
      EstimatesGrowingSelSq E c → JoinRealisesSq D B Φ (kOf Φ.val.variables) E A →
      (EncodedCNF.encode Φ.val ∈ EncodedCNF.Language →
        1 - 1 / 3 ≤ A.prob (EncodedCNF.encode Φ.val) (· = [true])) ∧
      (EncodedCNF.encode Φ.val ∉ EncodedCNF.Language →
        A.prob (EncodedCNF.encode Φ.val) (· = [true]) ≤ 1 / 3) := by
  obtain ⟨N₀, hN₀⟩ := classifier_per_tape_sq D B cs c hc0 hc
  refine ⟨max N₀ 36, fun Φ hsp hN E A hE hJ => ?_⟩
  have hN0 : N₀ ≤ Φ.val.variables := le_trans (le_max_left _ _) hN
  have h36 : 36 ≤ Φ.val.variables := le_trans (le_max_right _ _) hN
  have hk1 : 1 ≤ kOf Φ.val.variables := Paper2.Unit4Shell.AsymptoticsExplicit.kOf_pos _ h36
  letI : Fintype (EXP Φ (kOf Φ.val.variables)).output.Tape :=
    (EXP Φ (kOf Φ.val.variables)).tapeFintype
  obtain ⟨s, π, hs, hpush, hout⟩ := hJ
  have hper := hN₀ Φ hsp hN0 E hE
  -- the decider law is the two-stage law
  have key : ∀ Ev : List Bool → Prop,
      A.prob (EncodedCNF.encode Φ.val) Ev =
        ((EXP Φ (kOf Φ.val.variables)).tapeLaw.prod (uniformTape s)).prob
          (fun x => Ev ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) x.1) (List.ofFn x.2))) := by
    intro Ev
    unfold ETape.Algorithm.prob
    have e : (fun t : Fin (A.tapeLen (EncodedCNF.encode Φ.val).length) → Bool =>
        Ev (A.output (EncodedCNF.encode Φ.val) (List.ofFn t))) =
        (fun t => (fun x : (EXP Φ (kOf Φ.val.variables)).output.Tape × (Fin s → Bool) =>
          Ev ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) x.1) (List.ofFn x.2))) (π t)) := by
      funext t; rw [hout t]
    rw [e]
    exact hpush (fun x => Ev ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) x.1) (List.ofFn x.2)))
  -- the second stage is the classifier law
  have perb : ∀ b (Ev : List Bool → Prop),
      (uniformTape s).prob (fun y => Ev ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) b) (List.ofFn y))) =
        (Paper2.HeaderStrip.selectedClassifier E).prob (headerWordSq D B Φ (kOf Φ.val.variables) b) Ev := by
    intro b Ev
    unfold SelectedTape.Algorithm.prob
    exact (Paper2.AModel.uniformTape_prob_ofFn_congr (hs b) (fun w => Ev ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) b) w))).symm
  refine ⟨fun hin => ?_, fun hout' => ?_⟩
  · -- YES: every tape is within budget
    have hyes : ∀ b : (EXP Φ (kOf Φ.val.variables)).output.Tape,
        Workspace.Types.CommComplexity.D ((EXP Φ (kOf Φ.val.variables)).output.table b).matrix ≤
          (EXP Φ (kOf Φ.val.variables)).output.budget :=
      forall_of_output_eq' (TotalFiniteConstructorScratch.experiment_output_eq_select _ _ _ _ _)
        (fun X t => Workspace.Types.CommComplexity.D (X.table t).matrix ≤ X.budget)
        (fun t => AEndpoint.t01_yes D B EncodedCNF.Language AEndpoint.DA2_recommended Φ
          (kOf Φ.val.variables) t hin)
    have hfirst : (EXP Φ (kOf Φ.val.variables)).tapeLaw.prob (fun _ => ¬ True) ≤ 0 := by
      simp only [not_true_eq_false]
      rw [Paper2.FiniteLaw.prob_false]
    have hsecond : ∀ a : (EXP Φ (kOf Φ.val.variables)).output.Tape, True →
        (uniformTape s).prob (fun y => ¬ ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) a) (List.ofFn y) = [true])) ≤ 1 / 100 := by
      intro a _
      have hn := Paper2.Unit4Shell.Amplification.prob_not (uniformTape s) (fun y => (Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) a) (List.ofFn y) = [true])
      have hp := perb a (· = [true])
      have := (hper a).1 (hyes a)
      linarith
    have hrej := FiniteLaw.two_stage_failure_le (EXP Φ (kOf Φ.val.variables)).tapeLaw
      (uniformTape s) (fun _ => True)
      (fun a y => ¬ ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) a) (List.ofFn y) = [true])) 0 (1 / 100) hfirst hsecond
      (by norm_num)
    have hcomp := Paper2.Unit4Shell.Amplification.prob_not ((EXP Φ (kOf Φ.val.variables)).tapeLaw.prod (uniformTape s))
      (fun x => (Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) x.1) (List.ofFn x.2) = [true])
    have hacc := key (· = [true])
    rw [hacc]
    have hrej2 : ((EXP Φ (kOf Φ.val.variables)).tapeLaw.prod (uniformTape s)).prob
        (fun x => ¬ ((Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) x.1) (List.ofFn x.2) = [true])) ≤ 0 + 1 / 100 := hrej
    linarith
  · -- NO: the good event has mass ≥ 981/1000
    have hno := AEndpoint.t01_no D B EncodedCNF.Language AEndpoint.DA2_recommended Φ
      (kOf Φ.val.variables) hk1 hout'
    have hfirst : (EXP Φ (kOf Φ.val.variables)).tapeLaw.prob
        (fun a => ¬ ((EXP Φ (kOf Φ.val.variables)).output.budget + kOf Φ.val.variables ≤
          Workspace.Types.CommComplexity.D
            ((EXP Φ (kOf Φ.val.variables)).output.table a).matrix)) ≤ 19 / 1000 := by
      have hn := Paper2.Unit4Shell.Amplification.prob_not (EXP Φ (kOf Φ.val.variables)).tapeLaw
        (fun a => (EXP Φ (kOf Φ.val.variables)).output.budget + kOf Φ.val.variables ≤
          Workspace.Types.CommComplexity.D ((EXP Φ (kOf Φ.val.variables)).output.table a).matrix)
      linarith
    have hsecond : ∀ a : (EXP Φ (kOf Φ.val.variables)).output.Tape,
        (EXP Φ (kOf Φ.val.variables)).output.budget + kOf Φ.val.variables ≤
          Workspace.Types.CommComplexity.D
            ((EXP Φ (kOf Φ.val.variables)).output.table a).matrix →
        (uniformTape s).prob (fun y => (Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) a) (List.ofFn y) = [true]) ≤ 1 / 100 := by
      intro a ha
      have hp := perb a (· = [true])
      have := (hper a).2 ha
      linarith
    have hacc := FiniteLaw.two_stage_failure_le (EXP Φ (kOf Φ.val.variables)).tapeLaw
      (uniformTape s)
      (fun a => (EXP Φ (kOf Φ.val.variables)).output.budget + kOf Φ.val.variables ≤
          Workspace.Types.CommComplexity.D ((EXP Φ (kOf Φ.val.variables)).output.table a).matrix)
      (fun a y => (Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) a) (List.ofFn y) = [true]) (19 / 1000) (1 / 100) hfirst hsecond
      (by norm_num)
    rw [key (· = [true])]
    have hacc2 : ((EXP Φ (kOf Φ.val.variables)).tapeLaw.prod (uniformTape s)).prob
        (fun x => (Paper2.HeaderStrip.selectedClassifier E).output (headerWordSq D B Φ (kOf Φ.val.variables) x.1) (List.ofFn x.2) = [true]) ≤ 19 / 1000 + 1 / 100 := hacc
    linarith

/-- **Route-B segment-3 assembly statement** (the remaining premise): D-A6 clock, correct below
the cutoff, route-B identity at `kOf N` from the cutoff on. -/
def DeciderAssemblyJoinSq (E : SelectedTape.Algorithm) (cs N₁ : ℕ) (A : ETape.Algorithm) :
    Prop :=
  (∀ ε : ℝ, 0 < ε → ∃ C d N₀ : ℕ, ∀ input, AModel.WellFormedCNF input →
      AModel.cnfClauseCount input ≤ cs * EncodedETHTail.variableCount input →
      N₀ ≤ EncodedETHTail.variableCount input →
      A.time input ≤ C * ⌈(2 : ℝ) ^ (ε * EncodedETHTail.variableCount input)⌉₊ *
        (input.length + 1) ^ d) ∧
  (∀ Φ : ValidFormula, Φ.val.clauses.length ≤ cs * Φ.val.variables → Φ.val.variables < N₁ →
      (EncodedCNF.encode Φ.val ∈ EncodedCNF.Language →
        1 - 1 / 3 ≤ A.prob (EncodedCNF.encode Φ.val) (· = [true])) ∧
      (EncodedCNF.encode Φ.val ∉ EncodedCNF.Language →
        A.prob (EncodedCNF.encode Φ.val) (· = [true]) ≤ 1 / 3)) ∧
  (∀ Φ : ValidFormula, Φ.val.clauses.length ≤ cs * Φ.val.variables → N₁ ≤ Φ.val.variables →
      JoinRealisesSq D B Φ (kOf Φ.val.variables) E A)

theorem sparseDecider_of_join_sq (cs : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12) :
    ∃ N₀ : ℕ, ∀ (E : SelectedTape.Algorithm) (A : ETape.Algorithm),
      EstimatesGrowingSelSq E c → DeciderAssemblyJoinSq D B E cs N₀ A → SparseDeciderR20 cs A := by
  obtain ⟨N₀, hN₀⟩ := decider_error_join_sq D B cs c hc0 hc
  refine ⟨N₀, fun E A hE ⟨htime, hsmall, hlarge⟩ => ⟨fun input hwf hsp => ?_, htime⟩⟩
  obtain ⟨Φ, rfl⟩ := hwf
  rw [ADecider.cnfClauseCount_encode, ADecider.variableCount_encode] at hsp
  by_cases hN : Φ.val.variables < N₀
  · exact hsmall Φ hsp hN
  · exact hN₀ Φ hsp (Nat.le_of_not_lt hN) E A hE (hlarge Φ hsp (Nat.le_of_not_lt hN))

/-- **T24, square sentence, at class level in the R20 carrier, final form** (lock v12
`06-reduction.tex:116-117`: "The conclusion also holds when the inputs are square matrices of
power-of-two side length."). The estimator is required only on square power-of-two words;
remaining premise `hAsm` (square route-B assembly), NOT an implementation. -/
theorem T24_square_class_effective_final (c : ℝ) (hc0 : 0 ≤ c) (hc : c < 1 / 12)
    (hAsm : ∀ E : SelectedTape.Algorithm, EstimatesGrowingSelSq E c →
      ∀ cs N₁ : ℕ, ∃ A : ETape.Algorithm, DeciderAssemblyJoinSq D B E cs N₁ A)
    (hE : ∃ E : SelectedTape.Algorithm, EstimatesGrowingSelSq E c) :
    ¬ RandomizedSparseETH_R20 ∧ ¬ Paper2.AEth.RandomizedSparseETH_effective ∧
      ¬ Paper2.AModel.RandomizedSparseETH ∧
      ¬ Paper2.Unit4Shell.Definitions.RandomizedSparseETH EncodedCNF.Language
        Paper2.AModel.WellFormedCNF EncodedETHTail.variableCount Paper2.AModel.cnfClauseCount
        (1 / 3) true := by
  have h : ¬ RandomizedSparseETH_R20 := by
    rw [not_R20_iff]
    intro cs
    obtain ⟨E, hEe⟩ := hE
    obtain ⟨N₀, hN₀⟩ := sparseDecider_of_join_sq D B cs c hc0 hc
    obtain ⟨A, hA⟩ := hAsm E hEe cs N₀
    exact ⟨A, hN₀ E A hEe hA⟩
  exact ⟨h, not_old_of_not_R20 h, not_prefix_of_not_R20 h, not_draft_of_not_R20 h⟩

end Paper2.AEth2

