/-- The printed values (exact unary contents of the output cells of the final bank). -/
theorem outputs (n a am bd b6 s w L Q : ℕ) :
    B19 n a am bd b6 s w L Q (Sum.inr 0 : AK) = u ((a) * (am)) ∧
      B19 n a am bd b6 s w L Q (Sum.inr 8 : AK) = u ((65536 * s) * (max (max (a * am) (a * (bd * n))) (b6 * am))) ∧
      B19 n a am bd b6 s w L Q (Sum.inr 11 : AK) = u ((65536 * s * (max (max (a * am) (a * (bd * n))) (b6 * am))) * (16 * w)) ∧
      B19 n a am bd b6 s w L Q (Sum.inr 12 : AK) = u (1) ∧
      B19 n a am bd b6 s w L Q (Sum.inr 13 : AK) = u (2 ^ (L)) ∧
      B19 n a am bd b6 s w L Q (Sum.inr 16 : AK) = u (2 ^ (10 * L)) ∧
      B19 n a am bd b6 s w L Q (Sum.inr 18 : AK) = u ((320) * (Q)) := by
  exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

theorem inputs_kept (n a am bd b6 s w L Q : ℕ) (i : Fin 9) : B19 n a am bd b6 s w L Q (Sum.inl i) = B0 n a am bd b6 s w L Q (Sum.inl i) := by
  rfl

end

