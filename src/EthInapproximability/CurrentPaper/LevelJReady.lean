import EthInapproximability.CurrentPaper.LevelJClean
import EthInapproximability.CurrentPaper.WeightedLevel0Ready

/-! Lane owner:b-weighted-level-8, unit 2, segment 2d, piece 4 (GENERATED by `gen_levelj_ready.py`
from the frozen owner-4 `WeightedLevel0Target.lean` and `WeightedLevel0Ready.lean`, shas pinned
in RECEIPT): owner-4's writer target and `MatrixTableWriter.ready` frame at an ARBITRARY level.

ONE fixed program `readyJProgram` on owner-4's `GStack`: the lifted `LevelJClean.cleanJProgram`
; owner-4's `pBCD` (charged copies of the rows/cols words from masters `nat 3 0/1` into the
writer's `rows`/`cols` cells, charged clear of the two sources), reused by exact name.
Start bank `G0J (C1j ...) = Sum.elim (C1j ...) blank`. Exit bank owner-4's `G4 (levelRowsBankJ ...)`
(`G1..G4` reused by exact name: they are generic in the bank). `ready_writer_j`: every writer
cell except 22 is the admitted `actualWriterStart G c b y lv Mx` stack; `ready_writer22_j`:
writer 22 blank. -/

namespace EthInapproximability.CurrentPaper.LevelJReady

open Turing BitMachineEncoding BitMachineStackEmbedding
open EthInapproximability.ParameterizedNP.GuardedSourceGraph
open WeightedLevel0Rows WeightedLevel0Persist WeightedLevel0Clean WeightedLevel0Target
open WeightedLevel0Ready LevelJRows LevelJPersist LevelJClean

noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 8192
set_option synthInstance.maxSize 200000
set_option synthInstance.maxHeartbeats 2000000

variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

/-- The writer bank of `actualWriterStart` at level `i` with writer 22 blanked. -/
def targetWJ (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (k : Fin 64) : List Bool :=
  if k = 22 then [] else
    MatrixWeightedOrderPreparation.sourceBank
      (MatrixWeightedEntryController.persistentBank
        (ProtectedFullBankBridgeScratch.actualD G c b
          y lv Mx))
      (Fintype.card V)
      (Iteration.s G c b
          y lv Mx - 3)
      (4 * Iteration.s G c b
          y lv Mx) k

/-- Every writer cell of the cleaned level-`i` exit bank is the literal target. -/
theorem clean_writer_target_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b y lv Mx mS F Q P) (k : Fin 64) :
    BitMachineClearBank.cleared clearCells (levelRowsBankJ G c b y lv Mx mS F Q P) (wc k) =
      targetWJ G c b y lv Mx k := by
  obtain ⟨h1, h3, h4, h6, h15, h16, h17, h18, h21, h26, h27, h28, h29, h47, h48, h49, h50, h51,
    h52, h53, h7, h8, h9, _, _⟩ := hf
  by_cases hk : k ∈ keepW
  · rw [clean_keep _ k hk]
    unfold targetWJ
    rw [if_neg (by rintro rfl; revert hk; decide)]
    simp only [keepW, Finset.mem_insert, Finset.mem_singleton] at hk
    rcases hk with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [sb_other _ _ _ _ 1 (by decide)]; exact h1
    · rw [sb_other _ _ _ _ 3 (by decide)]; exact h3
    · rw [sb_other _ _ _ _ 4 (by decide)]; exact h4
    · rw [sb_other _ _ _ _ 6 (by decide)]; exact h6
    · rw [sb_slot7]; exact h7
    · rw [sb_slot8]; exact h8
    · rw [sb_slot9]; exact h9
    · rw [sb_other _ _ _ _ 15 (by decide)]; exact h15
    · rw [sb_other _ _ _ _ 16 (by decide)]; exact h16
    · rw [sb_other _ _ _ _ 17 (by decide)]; exact h17
    · rw [sb_other _ _ _ _ 18 (by decide)]; exact h18
    · rw [sb_other _ _ _ _ 21 (by decide)]; exact h21
    · rw [sb_other _ _ _ _ 26 (by decide)]; exact h26
    · rw [sb_other _ _ _ _ 27 (by decide)]; exact h27
    · rw [sb_other _ _ _ _ 28 (by decide)]; exact h28
    · rw [sb_other _ _ _ _ 29 (by decide)]; exact h29
    · rw [sb_other _ _ _ _ 47 (by decide)]; exact h47
    · rw [sb_other _ _ _ _ 48 (by decide)]; exact h48
    · rw [sb_other _ _ _ _ 49 (by decide)]; exact h49
    · rw [sb_other _ _ _ _ 50 (by decide)]; exact h50
    · rw [sb_other _ _ _ _ 51 (by decide)]; exact h51
    · rw [sb_other _ _ _ _ 52 (by decide)]; exact h52
    · rw [sb_other _ _ _ _ 53 (by decide)]; exact h53
  · rw [clean_writer _ k hk]
    unfold targetWJ
    split_ifs with h22
    · rfl
    · exact (sb_blank _ _ _ _ k hk h22).symm

/-- The admitted physical-step writer bank, read literally: its `Fin 64` cells
are exactly `targetW` away from writer 22. -/
theorem actualWriterStart_cells_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (k : Fin 64) (h22 : k ≠ 22) :
    (ProtectedFullBankBridgeScratch.actualWriterStart G c b
        y lv Mx).stk (.inl (.inl k)) =
      targetWJ G c b y lv Mx k := by
  unfold targetWJ
  rw [if_neg h22]
  rfl


def liftCleanJ := fun l => stackStmt cEmb (cleanJProgram l)

/-- ONE fixed program: level-`i` composite, clear, rows/cols into the writer frame. -/
def readyJProgram := BitMachineRawSequence.program liftCleanJ pBCD
  (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)
  ((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none))
  ((none : Option Bool), ((none : Option Bool), ((), none)))

/-- Global start bank: `S` on the combined bank, the writer index/extra cells blank. -/
def G0J (S : CStack → List Bool) : GStack → List Bool := Sum.elim S (fun _ => [])

theorem bank_cEmbJ (S0 S : CStack → List Bool) :
    bank cEmb (G0J S0) S = Sum.elim S (fun _ => []) := by
  funext x
  rcases x with x | y
  · exact bank_at cEmb (G0J S0) S x
  · rw [bank_outside _ _ _ _ (by rintro ⟨k, hk⟩; cases hk)]
    rfl

/-- The clock of `cleanJProgram` (literally `level_clean_j`'s). -/
def cleanBoundJ (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix)
    (mS : WeightedRawWords.Aux → List Bool) : ℕ :=
  boundJ G c b y lv Mx +
    ((∑ k : Fin nClear, (C1j G c b y lv Mx mS (clearCells k)).length) +
      nClear * (BitMachineStackGrowth.perStep p2 * boundJ G c b y lv Mx) + nClear + 2) + 1

theorem level_ready_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (hV : mS (.w 7) = List.replicate (Fintype.card V) true) (hN : ∀ m, mS (.nat 3 m) = []) :
    ∃ F : ETHBinsJoinedScratch.Stack → List Bool,
    ∃ Q : WeightedGraphQJoined.Stack → List Bool,
    ∃ P : ChosenPrimeRaw.Stack → List Bool,
    ∃ t ≤ cleanBoundJ G c b y lv Mx mS +
        ((2 * ProtectedFullBankBridgeScratch.actualRows G c b
            y lv Mx + 2) +
          ((2 * ProtectedFullBankBridgeScratch.actualCols G c b
            y lv Mx + 2) +
            (ProtectedFullBankBridgeScratch.actualRows G c b
              y lv Mx +
             ProtectedFullBankBridgeScratch.actualCols G c b
              y lv Mx + 4) + 1) + 1) + 1,
      ((advance (readyJProgram))^[t])
        ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)))))))),
          (((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))),
          G0J (C1j G c b y lv Mx mS)⟩ =
        ⟨none, (((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))),
          G4 (levelRowsBankJ G c b y lv Mx mS F Q P)⟩ ∧
      levelFactsJ G c b y lv Mx mS F Q P := by
  obtain ⟨F, Q, P, t1, ht1, h1, hf⟩ := level_clean_j G c b y lv Mx mS hV hN
  have hf' := hf
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hR, hC⟩ := hf'
  -- phase A: the lifted clean program
  have rA := WeightedRawWords.region_run cEmb cleanJProgram _ _ t1 h1
    (G0J (C1j G c b y lv Mx mS)) (fun k => rfl)
  rw [bank_cEmbJ] at rA
  -- phase B: copy the rows word into the writer's rows cell
  have tB : G1 (levelRowsBankJ G c b y lv Mx mS F Q P) (iR 2) = [] := rfl
  have sB := MatrixStage4ScalarPreparationOps.copy_run iR (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) tB
  have lB : (G1 (levelRowsBankJ G c b y lv Mx mS F Q P) (iR 0)).length =
      ProtectedFullBankBridgeScratch.actualRows G c b
        y lv Mx := by
    show (G1 (levelRowsBankJ G c b y lv Mx mS F Q P) srcR).length = _
    rw [G1_srcR, hR, List.length_replicate]
  rw [lB] at sB
  -- phase C: copy the cols word into the writer's cols cell
  have tC : G2 (levelRowsBankJ G c b y lv Mx mS F Q P) (iC 2) = [] := by
    show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ tmpI = []
    rw [Function.update_of_ne (by intro h; cases h)]
    rfl
  have sC := MatrixStage4ScalarPreparationOps.copy_run iC (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) tC
  have lC : (G2 (levelRowsBankJ G c b y lv Mx mS F Q P) (iC 0)).length =
      ProtectedFullBankBridgeScratch.actualCols G c b
        y lv Mx := by
    show (Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ srcC).length = _
    rw [Function.update_of_ne (by intro h; cases h), G1_srcC, hC, List.length_replicate]
  rw [lC] at sC
  -- phase D: clear the two master sources
  have sD := WeightedRawWords.clear_run cells2 cells2_inj (G3 (levelRowsBankJ G c b y lv Mx mS F Q P))
  have lD : (∑ i, (G3 (levelRowsBankJ G c b y lv Mx mS F Q P) (cells2 i)).length) =
      ProtectedFullBankBridgeScratch.actualRows G c b
        y lv Mx +
      ProtectedFullBankBridgeScratch.actualCols G c b
        y lv Mx := by
    rw [Fin.sum_univ_two]
    have e0 : G3 (levelRowsBankJ G c b y lv Mx mS F Q P) (cells2 0) =
        G1 (levelRowsBankJ G c b y lv Mx mS F Q P) srcR := by
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ srcR = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ srcR = _
      rw [Function.update_of_ne (by intro h; cases h)]
    have e1 : G3 (levelRowsBankJ G c b y lv Mx mS F Q P) (cells2 1) =
        G1 (levelRowsBankJ G c b y lv Mx mS F Q P) srcC := by
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ srcC = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ srcC = _
      rw [Function.update_of_ne (by intro h; cases h)]
    rw [e0, e1, G1_srcR, G1_srcC, hR, hC, List.length_replicate, List.length_replicate]
  rw [lD] at sD
  -- compose (three charged handoffs)
  obtain ⟨v3, hv3, q3⟩ := BitMachineRawSequence.runs copyC clear2 _ _ _ _ _ _
    (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) (G3 (levelRowsBankJ G c b y lv Mx mS F Q P))
    (G4 (levelRowsBankJ G c b y lv Mx mS F Q P)) _ _ sC sD
  obtain ⟨v2, hv2, q2⟩ := BitMachineRawSequence.runs copyR pCD _ _ _ _ _ _
    (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) (G2 (levelRowsBankJ G c b y lv Mx mS F Q P))
    (G4 (levelRowsBankJ G c b y lv Mx mS F Q P)) _ _ sB q3
  obtain ⟨v1, hv1, q1⟩ := BitMachineRawSequence.runs liftCleanJ pBCD _ _ _ _ _ _
    (G0J (C1j G c b y lv Mx mS)) (G1 (levelRowsBankJ G c b y lv Mx mS F Q P))
    (G4 (levelRowsBankJ G c b y lv Mx mS F Q P)) _ _ rA q2
  refine ⟨F, Q, P, v1, ?_, q1, hf⟩
  have ht1' : t1 ≤ cleanBoundJ G c b y lv Mx mS := ht1
  omega

/-- The writer frame: every writer-stack cell except writer 22 is literally the
admitted level-`i` `actualWriterStart` stack. -/
theorem ready_writer_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b y lv Mx mS F Q P) (w : MatrixWeightedOrderWriter.Stack)
    (hw : w ≠ .inl (.inl 22)) :
    G4 (levelRowsBankJ G c b y lv Mx mS F Q P) (wEmb w) =
      (ProtectedFullBankBridgeScratch.actualWriterStart G c b
        y lv Mx).stk w := by
  have hf' := hf
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hR, hC⟩ := hf'
  have out4 : ∀ x : GStack, x ≠ srcR → x ≠ srcC →
      G4 (levelRowsBankJ G c b y lv Mx mS F Q P) x = G3 (levelRowsBankJ G c b y lv Mx mS F Q P) x := by
    intro x h0 h1
    apply BitMachineClearBank.cleared_foreign
    intro i hi
    fin_cases i
    · exact h0 hi.symm
    · exact h1 hi.symm
  rcases w with (k | i) | e
  · have hk : k ≠ 22 := fun h => hw (by rw [h])
    have hx : wEmb (.inl (.inl k)) = Sum.inl (wc k) := rfl
    rw [hx, out4 _ (by intro h; exact wc_ne_mc k _ (Sum.inl.inj h))
      (by intro h; exact wc_ne_mc k _ (Sum.inl.inj h))]
    show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inl (wc k)) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inl (wc k)) = _
    rw [Function.update_of_ne (by intro h; cases h)]
    show BitMachineClearBank.cleared clearCells (levelRowsBankJ G c b y lv Mx mS F Q P) (wc k) = _
    rw [clean_writer_target_j G c b y lv Mx mS F Q P hf k, actualWriterStart_cells_j G c b y lv Mx k hk]
  · have hx : wEmb (.inl (.inr i)) = Sum.inr (Sum.inl i) := rfl
    rw [hx, out4 _ (by intro h; cases h) (by intro h; cases h)]
    have e3 : G3 (levelRowsBankJ G c b y lv Mx mS F Q P) (Sum.inr (Sum.inl i)) = [] := by
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inr (Sum.inl i)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inr (Sum.inl i)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    rw [e3]
    fin_cases i <;> rfl
  · have hx : wEmb (.inr e) = Sum.inr (Sum.inr e) := rfl
    rw [hx, out4 _ (by intro h; cases h) (by intro h; cases h)]
    cases e with
    | rows =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ dstR = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ dstR = _
      rw [Function.update_self]
      show G1 (levelRowsBankJ G c b y lv Mx mS F Q P) srcR ++ [] = _
      rw [G1_srcR, hR, List.append_nil]
      rfl
    | cols =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ dstC = _
      rw [Function.update_self]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ srcC ++
        Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ dstC = _
      rw [Function.update_of_ne (by intro h; cases h), Function.update_of_ne (by intro h; cases h),
        G1_srcC, hC]
      show List.replicate _ true ++ [] = _
      rw [List.append_nil]
      rfl
    | rowsLeft =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inr (Sum.inr .rowsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inr (Sum.inr .rowsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | colsLeft =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inr (Sum.inr .colsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inr (Sum.inr .colsLeft)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | temp =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inr (Sum.inr .temp)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inr (Sum.inr .temp)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | buffer =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inr (Sum.inr .buffer)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inr (Sum.inr .buffer)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl
    | output =>
      show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inr (Sum.inr .output)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inr (Sum.inr .output)) = _
      rw [Function.update_of_ne (by intro h; cases h)]
      rfl

/-- Writer 22 is blank at the exit: the named premise `d.rawBits` is NOT written here. -/
theorem ready_writer22_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool) :
    G4 (levelRowsBankJ G c b y lv Mx mS F Q P) (wEmb (.inl (.inl 22))) = [] := by
  show BitMachineClearBank.cleared cells2 (G3 (levelRowsBankJ G c b y lv Mx mS F Q P)) (Sum.inl (wc 22)) = []
  rw [BitMachineClearBank.cleared_foreign _ _ _ (by
    intro i hi
    fin_cases i
    · exact wc_ne_mc 22 _ (Sum.inl.inj hi).symm
    · exact wc_ne_mc 22 _ (Sum.inl.inj hi).symm)]
  show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inl (wc 22)) = _
  rw [Function.update_of_ne (by intro h; cases h)]
  show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inl (wc 22)) = _
  rw [Function.update_of_ne (by intro h; cases h)]
  exact clean_writer _ 22 (by decide)

#print axioms clean_writer_target_j
#print axioms actualWriterStart_cells_j
#print axioms level_ready_j
#print axioms ready_writer_j
#print axioms ready_writer22_j

end
