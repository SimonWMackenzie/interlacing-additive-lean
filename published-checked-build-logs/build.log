    dsimp [φ, generatedFeatureValue]
    split_ifs
    · exact Or.inr rfl
    · exact Or.inl rfl
  obtain ⟨encOut, hcompBound⟩ :=
    compressSourceFuel_denominator n φ hn hφ extended.size extended stageOut hcomp encExtended
  have hnM : n ≤ M := by exact hM (q + 1) hq
  have hprevSize := sequentialMaterialized_size_le_features_all D alphabet q prev hprev
  have hprevM : prev.size ≤ M := hprevSize.trans (hM q (by omega))
  have hfuel : extended.size ≤ alphabet.size * M :=
