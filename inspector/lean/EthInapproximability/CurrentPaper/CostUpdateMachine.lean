/-- ONE fixed program: the fourteen stages in sequence. -/
def costProgram := P1
def costStart := l1
def costCtrl := c1

/-- The exit value of cell 5, as produced (before simplification). -/
def yRaw (lam b c s e y : ℕ) : ℕ := (Nat.clog 2 (((b * c + 0) * s + 0) * (1280 + 0) + 0) + (Nat.clog 2 ((s * e + 0) * (12 + 0) + 0) + (((Nat.clog 2 lam + 0) * (10000 + 0) + 0) * (Nat.clog 2 lam + 0) + ((lam * (2256 + 0) + 0) * lam + (1 + y)))))

/-- The explicit clock of `costProgram` (the nested sum of the stage clocks). -/
