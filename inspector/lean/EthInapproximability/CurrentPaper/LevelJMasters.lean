/-- A master cell outside the row program's image is untouched by phases 2–4. -/
theorem l_master_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (a : WeightedRawWords.Aux) (h7 : a ≠ .w 7) (hn : ∀ m, a ≠ .nat 3 m) :
    levelRowsBankJ G c b y lv Mx mS F Q P (mc a) = mS a := by
  unfold levelRowsBankJ
  rw [bank_outside _ _ _ _ (by
    rintro ⟨j, hj⟩
    change rowCell (rowEquiv j) = mc a at hj
    rcases hr : rowEquiv j with z | (i | m)
    · rw [hr] at hj
      exact h7 (Sum.inr.inj (Sum.inr.inj hj)).symm
    · rw [hr] at hj
      exact wc_ne_mc _ _ hj
    · rw [hr] at hj
      exact hn m.val (Sum.inr.inj (Sum.inr.inj hj)).symm)]
  have hn9 : ¬ ∃ j, cells9 j = mc a := by
    rintro ⟨j, hj⟩
    exact wc_ne_mc _ _ hj
  show (if ∃ j, cells9 j = mc a then [] else C2j G c b y lv Mx mS F Q P (mc a)) = _
  rw [if_neg hn9]
  show bank levelEmb (C1j G c b y lv Mx mS) (Zj G c b y lv Mx F Q P) (Sum.inr (Sum.inr a)) = _
  rw [bank_outside _ _ _ _ (by
    rintro ⟨k, hk⟩
    rcases k with k | k <;> cases hk)]
  show bank rawEmb _ _ (rawEmb (Sum.inr a)) = _
  rw [bank_at]
  rfl

/-- The master cells after `readyProgram` for every master other than `N`,
`w 7`, `nat 3 _`. -/
theorem ready_master_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (a : WeightedRawWords.Aux) (hN : a ≠ .N) (h7 : a ≠ .w 7) (hn : ∀ m, a ≠ .nat 3 m) :
    G4 (levelRowsBankJ G c b y lv Mx mS F Q P) (Sum.inl (mc a)) = mS a := by
  show BitMachineClearBank.cleared cells2 (G3 (levelRowsBankJ G c b y lv Mx mS F Q P)) (Sum.inl (mc a)) = _
  rw [BitMachineClearBank.cleared_foreign _ _ _ (by
    intro i hi
    fin_cases i
    · exact hn 0 (Sum.inr.inj (Sum.inr.inj (Sum.inl.inj hi))).symm
    · exact hn 1 (Sum.inr.inj (Sum.inr.inj (Sum.inl.inj hi))).symm)]
  show Function.update (G2 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstC _ (Sum.inl (mc a)) = _
  rw [Function.update_of_ne (by intro h; cases h)]
  show Function.update (G1 (levelRowsBankJ G c b y lv Mx mS F Q P)) dstR _ (Sum.inl (mc a)) = _
  rw [Function.update_of_ne (by intro h; cases h)]
  show BitMachineClearBank.cleared clearCells (levelRowsBankJ G c b y lv Mx mS F Q P) (mc a) = _
  rw [clean_master _ a hN, l_master_j G c b y lv Mx mS F Q P a h7 hn]

theorem writer_start_22_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) :
    (ProtectedFullBankBridgeScratch.actualWriterStart G c b
        y lv Mx).stk (.inl (.inl 22)) =
      (ProtectedFullBankBridgeScratch.actualD G c b
        y lv Mx).rawBits := by
  show MatrixWeightedOrderPreparation.sourceBank _ _ _ _ 22 = _
  rw [sb_other _ _ _ _ 22 (by decide), pb22]

theorem level_writer_run_j (G : EndpointGraph V E) (c b y lv : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b y lv Mx mS F Q P) (S : GStack → List Bool)
    (hS : ∀ w, w ≠ .inl (.inl 22) → S (wEmb w) = G4 (levelRowsBankJ G c b y lv Mx mS F Q P) (wEmb w))
    (h22 : S (wEmb (.inl (.inl 22))) =
      (ProtectedFullBankBridgeScratch.actualD G c b
        y lv Mx).rawBits) :
    ∃ t ≤ ProtectedFullBankBridgeScratch.actualWriterBound G c b
        y lv Mx,
      ∃ w,
        ((advance writerG)^[t])
          (⟨some (BitMachineRawSequence.leftLabel MatrixWeightedOrderPreparation.start),
            (MatrixWeightedOrderPreparation.initial, MatrixWeightedOrderWriter.writerInitial),
            S⟩ : TM2.Cfg (fun _ : GStack => Bool) MatrixWeightedOrderWriter.Label
              MatrixWeightedOrderWriter.Control) =
          ⟨none, (MatrixWeightedOrderPreparation.initial, w),
            bank wEmb S (MatrixTableWriter.ready
              (MatrixWeightedEntryController.persistentBank
                (ProtectedFullBankBridgeScratch.actualD G c b
                  y lv Mx))
              (ProtectedFullBankBridgeScratch.actualRows G c b
                y lv Mx)
              (ProtectedFullBankBridgeScratch.actualCols G c b
                y lv Mx)
              0 0 0 0 []
              (MatrixMaterialization.rowMajor
                (ProtectedFullBankBridgeScratch.actualF G c b
                  y lv Mx))).contents⟩ := by
  obtain ⟨tw, htw, w, hw⟩ := PostProtectedWriterRunScratch.actual_writer_source_run
    G c b
    y lv Mx
  have hrun : MatrixWeightedOrderWriter.run tw
      (ProtectedFullBankBridgeScratch.actualWriterStart G c b
        y lv Mx) =
      MatrixWeightedOrderWriter.cfg none (MatrixWeightedOrderPreparation.initial, w)
        (MatrixTableWriter.ready
          (MatrixWeightedEntryController.persistentBank
            (ProtectedFullBankBridgeScratch.actualD G c b
              y lv Mx))
          (ProtectedFullBankBridgeScratch.actualRows G c b
            y lv Mx)
          (ProtectedFullBankBridgeScratch.actualCols G c b
            y lv Mx)
          0 0 0 0 []
          (MatrixMaterialization.rowMajor
            (ProtectedFullBankBridgeScratch.actualF G c b
              y lv Mx))).contents := hw
  have hG : ∀ k, (ProtectedFullBankBridgeScratch.actualWriterStart G c
      b
      y lv Mx).stk k = S (wEmb k) := by
    intro k
    by_cases hk : k = .inl (.inl 22)
    · subst hk
      rw [writer_start_22_j, h22]
    · rw [hS k hk, ready_writer_j G c b y lv Mx mS F Q P hf k hk]
  have r := WeightedRawWords.region_run wEmb MatrixWeightedOrderWriter.program _ _ tw hrun S hG
  exact ⟨tw, htw, w, r⟩

