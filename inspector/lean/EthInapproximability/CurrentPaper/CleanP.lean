variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

/-- The fresh region after the round, without the previous output word. -/
def DJc (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) : Fin 57 → List Bool :=
  Function.update (Function.update blank57 0
      (List.replicate (EffectiveIteration.nextRows ((Pj G c b yb j Mx))) true)) 1
    (List.replicate (EffectiveIteration.nextColumns ((Pj G c b yb j Mx)) (Fintype.card V)) true)

theorem DJc_spare (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (i : Fin 57) (h0 : i ≠ 0) (h1 : i ≠ 1) :
    DJc G c b yb j Mx i = [] := by
  unfold DJc
  rw [Function.update_of_ne h1, Function.update_of_ne h0]
  rfl

theorem cleared55 (S : HStack → List Bool) (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mw : List Bool) :
    BitMachineClearBank.cleared cell55 (ext4 S (DJ G c b yb j Mx mw)) = ext4 S (DJc G c b yb j Mx) := by
  funext y
  unfold BitMachineClearBank.cleared
  by_cases hy : y = outCell
  · subst hy
    rw [if_pos ⟨0, rfl⟩]
    exact (DJc_spare G c b yb j Mx 55 (by decide) (by decide)).symm
  · have hn : ¬ ∃ i, cell55 i = y := by
      rintro ⟨i, hi⟩
      exact hy hi.symm
    rw [if_neg hn]
    rcases y with y | i
    · rfl
    · show DJ G c b yb j Mx mw i = DJc G c b yb j Mx i
      have hi : i ≠ 55 := fun e => hy (by rw [e]; rfl)
      unfold DJ DJc Dmw
      by_cases h1 : i = 1
      · subst h1
        rw [Function.update_self, Function.update_self]
      · rw [Function.update_of_ne h1, Function.update_of_ne h1]
        by_cases h0 : i = 0
        · subst h0
          rw [Function.update_self, Function.update_self]
        · rw [Function.update_of_ne h0, Function.update_of_ne h0, Function.update_of_ne hi]

section Clean

variable [Fintype BStack]

/-- ONE fixed program: the level-`j` round ; clear of the previous output word ; copy of the
new output word ; clear of the bridge region. -/
def clean4JProgram {LW VW : Type} (W : LW → TM2.Stmt (fun _ : H4 => Bool) LW VW)
    (w₀ : LW) (v₀ : VW) :=
  BitMachineRawSequence.program (round4JProgram W w₀ v₀)
    (BitMachineRawSequence.program clear55
      (BitMachineRawSequence.program copyOutP clearB4 0 none ((), none))
      (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan) ((), none) (none, ((), none)))
    (BitMachineRawSequence.leftLabel (0 : Fin (1 + 2)))
    (((((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))), ctrl27), (v₀, (costCtrl, (NextDimsMachineTN.dimsCtrl, bridgeCtrl))))
    (((), none), (none, ((), none)))

theorem level_dims_clean_j [Fintype MatrixTableInterlaceProtectedBridge.Label]
    (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (hP : Pj G c b yb j Mx = EffectiveIteration.runParameters G c b (Iteration.seedState b) j) (hb : 1 ≤ b) (hc : 1 ≤ c)
    (mS : WeightedRawWords.Aux → List Bool)
    (hV : mS (.w 7) = List.replicate (Fintype.card V) true) (hN : ∀ m, mS (.nat 3 m) = [])
    (hmC : mS .C = List.replicate c true) (hmB : mS .B = List.replicate b true)
    (hmY : mS .Y = List.replicate (yb + j) true)
    (hmE : mS .E = List.replicate (Fintype.card E) true) (mw : List Bool)
    {LW VW : Type} (W : LW → TM2.Stmt (fun _ : H4 => Bool) LW VW) (w₀ : LW) (v₀ : VW) (T22 : ℕ)
    (hW : Writer22SpecJ W w₀ v₀ T22 G c b yb j Mx mS mw) :
    ∃ F : ETHBinsJoinedScratch.Stack → List Bool,
    ∃ Q : WeightedGraphQJoined.Stack → List Bool,
    ∃ P : ChosenPrimeRaw.Stack → List Bool,
    ∃ t ≤ (prepBoundJ G c b (yb) j (Mx) mS +
        (T22 + (costBound (Parameters.scale ((Pj G c b yb j Mx))) b c (Parameters.bins ((Pj G c b yb j Mx)))
            (Fintype.card E) ((Pj G c b yb j Mx)).cost +
          (NextDimsMachineTN.dimsBound (dxJ G c b yb j Mx) +
            ProtectedFullBankBridgeScratch.actualPhysicalBudget G c b (yb) j (Mx) + 1)
              + 1) + 1) + 1) +
        ((mw.length + 1 + 2) +
          ((2 * (ProtectedFullBankBridgeScratch.actualPhysicalOutput G c b (yb) j (Mx)).length + 2) +
            ((∑ i : Fin Level0CleanRun.nB,
                (((ProtectedFullBankBridgeScratch.actualPhysicalStart G c b (yb) j (Mx)).stk
                    ((Fintype.equivFin BStack).symm i)).length +
                  BitMachineStackGrowth.perStep bridgeH *
                    ProtectedFullBankBridgeScratch.actualPhysicalBudget G c b (yb) j (Mx)))
              + Level0CleanRun.nB + 2) + 1) + 1) + 1,
      ((advance (clean4JProgram W w₀ v₀))^[t])
          ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan))))))))))),
            ((((((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))), ctrl27), (v₀, (costCtrl, (NextDimsMachineTN.dimsCtrl, bridgeCtrl)))), (((), none), (none, ((), none)))),
            ext4 (H0J (C1j G c b (yb) j (Mx) mS)) (Dmw mw)⟩ =
        ⟨none, ((((((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), ((none : Option Bool), ((none : Option Bool), ((), none)))), ctrl27), (v₀, (costCtrl, (NextDimsMachineTN.dimsCtrl, bridgeCtrl)))), (((), none), (none, ((), none)))),
          Function.update (ext4 (Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P)) (DJc G c b yb j Mx)) outCell
            (ProtectedFullBankBridgeScratch.actualPhysicalOutput G c b (yb) j (Mx))⟩ ∧
      levelFactsJ G c b (yb) j (Mx) mS F Q P ∧
      Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell .C) = ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 0 ∧
      Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell .B) = ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 1 ∧
      Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell .Y) = ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 2 ∧
      DJc G c b yb j Mx 0 = ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 3 ∧
      DJc G c b yb j Mx 1 = ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 4 ∧
      Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell .E) = ETHParameterScaleMachineInput.words
        (EffectiveIteration.runParameters G c b (Iteration.seedState b) (j + 1)) 5 := by
  obtain ⟨F, Q, P, t, ht, z, hrun, hout, hf, mC, mB, mY, mR, mCo, mE, _, hgrow⟩ :=
    level_dims_round_j G c b yb j Mx hP hb hc mS hV hN hmC hmB hmY hmE mw W w₀ v₀ T22 hW
  set X0 : H4 → List Bool := ext4 (bank pEmb (S2J G c b yb j Mx mS F Q P) z.stk) (DJ G c b yb j Mx mw) with hX0
  -- clear the previous output word
  have hc55 := WeightedRawWords.clear_run cell55 cell55_inj X0
  rw [hX0, cleared55] at hc55
  have hlen55 : (∑ i : Fin 1, (X0 (cell55 i)).length) = mw.length := by
    rw [Fin.sum_univ_one]
    show (DJ G c b yb j Mx mw 55).length = _
    rw [DJ_out]
  set X : H4 → List Bool := ext4 (bank pEmb (S2J G c b yb j Mx mS F Q P) z.stk) (DJc G c b yb j Mx) with hX
  have hX0' : X srcOut = ProtectedFullBankBridgeScratch.actualPhysicalOutput G c b
      (yb) j (Mx) := by
    show bank pEmb (S2J G c b yb j Mx mS F Q P) z.stk (pEmb (.inr MatrixTableInterlaceOuterJoin.secondOutput)) = _
    rw [bank_at]
    exact hout
  have hXt : X (outSlots 2) = [] := DJc_spare G c b yb j Mx 56 (by decide) (by decide)
  have hcp := MatrixStage4ScalarPreparationOps.copy_run outSlots X hXt
  have e0 : outSlots 0 = srcOut := rfl
  have e1 : outSlots 1 = outCell := rfl
  have hXo : X outCell = [] := DJc_spare G c b yb j Mx 55 (by decide) (by decide)
  rw [e0, e1, hX0', hXo, List.append_nil] at hcp
  set X1 := Function.update X outCell
    (ProtectedFullBankBridgeScratch.actualPhysicalOutput G c b (yb) j (Mx)) with hX1
  have hcl := WeightedRawWords.clear_run bridgeCells4 bridgeCells4_inj X1
  have hfinal : BitMachineClearBank.cleared bridgeCells4 X1 =
      Function.update (ext4 (Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P)) (DJc G c b yb j Mx)) outCell
        (ProtectedFullBankBridgeScratch.actualPhysicalOutput G c b (yb) j (Mx)) := by
    funext y
    unfold BitMachineClearBank.cleared
    rcases y with (h | h) | i
    · by_cases hb' : ∃ y', pEmb y' = h
      · obtain ⟨y', rfl⟩ := hb'
        have hin : ∃ i, bridgeCells4 i = (.inl (.inl (pEmb y')) : H4) :=
          ⟨(Fintype.equivFin BStack) y', by simp [bridgeCells4]⟩
        rw [if_pos hin, Function.update_of_ne (by intro e; cases e)]
        show [] = Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (pEmb y')
        simp only [Level0CleanRun.blankBridge]
        rw [if_pos ⟨y', rfl⟩]
      · have hin : ¬ ∃ i, bridgeCells4 i = (.inl (.inl h) : H4) := by
          rintro ⟨i, hi⟩
          exact hb' ⟨_, Sum.inl.inj (Sum.inl.inj hi)⟩
        rw [if_neg hin, hX1, Function.update_of_ne (by intro e; cases e),
          Function.update_of_ne (by intro e; cases e)]
        show bank pEmb (S2J G c b yb j Mx mS F Q P) z.stk h = Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) h
        rw [bank_outside _ _ _ _ hb']
        simp only [Level0CleanRun.blankBridge]
        rw [if_neg hb']
    · have hin : ¬ ∃ i, bridgeCells4 i = (.inl (.inr h) : H4) := by
        rintro ⟨i, hi⟩
        cases hi
      rw [if_neg hin, hX1, Function.update_of_ne (by intro e; cases e),
        Function.update_of_ne (by intro e; cases e)]
      rfl
    · have hin : ¬ ∃ j', bridgeCells4 j' = (.inr i : H4) := by
        rintro ⟨j', hj⟩
        cases hj
      rw [if_neg hin, hX1]
      by_cases hi : (Sum.inr i : H4) = outCell
      · rw [hi, Function.update_self, Function.update_self]
      · rw [Function.update_of_ne hi, Function.update_of_ne hi]
        rfl
  rw [hfinal] at hcl
  have hsum : (∑ i : Fin Level0CleanRun.nB, (X1 (bridgeCells4 i)).length) ≤
      ∑ i : Fin Level0CleanRun.nB,
        (((ProtectedFullBankBridgeScratch.actualPhysicalStart G c b (yb) j (Mx)).stk
            ((Fintype.equivFin BStack).symm i)).length +
          BitMachineStackGrowth.perStep bridgeH *
            ProtectedFullBankBridgeScratch.actualPhysicalBudget G c b (yb) j (Mx)) := by
    apply Finset.sum_le_sum
    intro i _
    rw [hX1, Function.update_of_ne (by intro e; cases e)]
    show (bank pEmb (S2J G c b yb j Mx mS F Q P) z.stk (pEmb ((Fintype.equivFin BStack).symm i))).length ≤ _
    rw [bank_at]
    exact hgrow _
  obtain ⟨t3, ht3, q3⟩ := BitMachineRawSequence.runs copyOutP clearB4
    BitMachineCopy.Label.scan 0 none none ((), none) ((), none) X X1 _ _ _ hcp hcl
  obtain ⟨t2, ht2, q2⟩ := BitMachineRawSequence.runs clear55 _
    _ _ _ _ _ _ X0 X _ _ _ hc55 q3
  obtain ⟨u, hu, q1⟩ := BitMachineRawSequence.runs (round4JProgram W w₀ v₀) _
    _ _ _ _ _ _ _ _ _ _ _ hrun q2
  have hbb : ∀ a : WeightedRawWords.Aux,
      Level0CleanRun.blankBridge (S2J G c b yb j Mx mS F Q P) (mcell a) = S2J G c b yb j Mx mS F Q P (mcell a) := by
    intro a
    simp only [Level0CleanRun.blankBridge]
    rw [if_neg (mcell_outside a)]
  have hDc0 : DJc G c b yb j Mx 0 = DJ G c b yb j Mx mw 0 := by
    unfold DJc DJ
    rw [Function.update_of_ne (show (0 : Fin 57) ≠ 1 by decide), Function.update_self,
      Function.update_of_ne (show (0 : Fin 57) ≠ 1 by decide), Function.update_self]
  have hDc1 : DJc G c b yb j Mx 1 = DJ G c b yb j Mx mw 1 := by
    unfold DJc DJ
    rw [Function.update_self, Function.update_self]
  rw [bank_master] at mC mB mY mE
  refine ⟨F, Q, P, u, ?_, q1, hf, by rw [hbb]; exact mC, by rw [hbb]; exact mB,
    by rw [hbb]; exact mY, hDc0.trans mR, hDc1.trans mCo, by rw [hbb]; exact mE⟩
  rw [hlen55] at ht2
  unfold Level0CleanRun.nB at hsum ht3 ⊢
  omega

