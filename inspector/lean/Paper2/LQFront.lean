import Paper2.LIdent
import Paper2.QSched

/-! Unit 3, segment (2), second part: the joined count front L -> Q (generated by gen_lqfront.py).

Bank `J1 = LK ⊕ (QK ⊕ Fin 1)` (the `LProducer` bank, the `QProducer` bank, one copy scratch). ONE fixed program
`front a b Δ` (six parts, production `BitMachineRawSequence` handoffs): the owner-10 `LProducer.lProg` lifted to the
LK region by `stackStmt`; four admitted `copyProgram` handoffs (unary n, unary L = clog₂ n from the first log region's
output cell, unary s, unary w, each appended into a blank QK input cell; sources kept); this lane's `QProducer.qProg a b Δ`
lifted to the QK region. Start bank: unary n in LK cell 0 and unary m in QK cell 1; everything else blank. -/

set_option maxHeartbeats 32000000
set_option maxRecDepth 16384
set_option linter.unusedSimpArgs false

namespace Paper2.CountFront

noncomputable section

open Turing
open EthInapproximability.CurrentPaper
open EthInapproximability.CurrentPaper.BitMachineEncoding
open EthInapproximability.CurrentPaper.BitMachineStackEmbedding
open BitMachineRawSequence (leftLabel)

abbrev LK := LProducer.LK
abbrev QK := QProducer.QK
abbrev J1 := LK ⊕ (QK ⊕ Fin 1)

def lc (x : LK) : J1 := .inl x
def qc (x : QK) : J1 := .inr (.inl x)
def sc : J1 := .inr (.inr 0)

def ιA : LK ↪ J1 := ⟨Sum.inl, fun _ _ h => Sum.inl_injective h⟩
def ιB : QK ↪ J1 := ⟨fun x => .inr (.inl x), fun a b h => by simpa using h⟩

def e1 : Fin 3 ↪ J1 := ⟨![lc LProducer.nC, qc (.inl 0), sc], by
  intro i j h; fin_cases i <;> fin_cases j <;> simp_all [lc, qc, sc]⟩
def e2 : Fin 3 ↪ J1 := ⟨![lc (LProducer.outR 0), qc (.inl 2), sc], by
  intro i j h; fin_cases i <;> fin_cases j <;> simp_all [lc, qc, sc]⟩
def e3 : Fin 3 ↪ J1 := ⟨![lc LProducer.sC, qc (.inl 3), sc], by
  intro i j h; fin_cases i <;> fin_cases j <;> simp_all [lc, qc, sc]⟩
def e4 : Fin 3 ↪ J1 := ⟨![lc LProducer.wC, qc (.inl 4), sc], by
  intro i j h; fin_cases i <;> fin_cases j <;> simp_all [lc, qc, sc]⟩

def pL := fun l => stackStmt ιA (LProducer.lProg l)
def pQ (a b Δ : ℕ) := fun l => stackStmt ιB (QProducer.qProg a b Δ l)
def cp (e : Fin 3 ↪ J1) := MatrixStage4ScalarPreparationOps.copyProgram e
abbrev oc := (none : Option Bool)

def f1 := BitMachineRawSequence.program pL (cp e1) BitMachineCopy.Label.scan LProducer.lCtl oc
def g1 := (LProducer.lCtl, oc)
def f2 := BitMachineRawSequence.program f1 (cp e2) BitMachineCopy.Label.scan g1 oc
def g2 := (g1, oc)
def f3 := BitMachineRawSequence.program f2 (cp e3) BitMachineCopy.Label.scan g2 oc
def g3 := (g2, oc)
def f4 := BitMachineRawSequence.program f3 (cp e4) BitMachineCopy.Label.scan g3 oc
def g4 := (g3, oc)
/-- The joined L -> Q count front: ONE fixed program (machine constants `a b Δ`). -/
def front (a b Δ : ℕ) := BitMachineRawSequence.program f4 (pQ a b Δ) (QProducer.qStart a b Δ) g4 QProducer.qCtl
def frontCtl := (g4, QProducer.qCtl)
def labelOfP {L σ : Type*} {K : Type*} (_P : L → TM2.Stmt (fun _ : K => Bool) L σ) (l : L) : L := l
def frontStart (a b Δ : ℕ) := labelOfP (front a b Δ)
  (leftLabel (leftLabel (leftLabel (leftLabel (leftLabel LProducer.lStart)))))

/-- Start bank: unary `n` in LK cell 0, unary `m` in QK cell 1, everything else blank. -/
def J0 (n m : ℕ) : J1 → List Bool :=
  Sum.elim (LProducer.L0 n) (Sum.elim (Function.update (fun _ => []) (.inl 1) (QProducer.u m)) (fun _ => []))

/-- The exact exit facts of `LProducer.l_run` (copied literally). -/
def LFacts (n : ℕ) (F : LK → List Bool) : Prop :=
  let L := Nat.clog 2 n
  let e := Nat.clog 2 (L + 1)
  F LProducer.nC = LProducer.u n ∧ F LProducer.c1 = LProducer.u (L + 1) ∧
  F LProducer.oe = LProducer.u (32 + (e + (e + L))) ∧ F LProducer.ep = LProducer.u (6 + e) ∧
  F LProducer.es = LProducer.u (16 + e) ∧ F LProducer.dp = LProducer.u e ∧ F LProducer.dd = LProducer.u (e * e) ∧
  F LProducer.pC = LProducer.u (2 ^ (6 + e)) ∧
  F LProducer.sC = LProducer.u (2 ^ (16 + e)) ∧ F LProducer.q2C = LProducer.u (2 ^ (32 + (e + (e + L)))) ∧
  F LProducer.wC = LProducer.u (2 ^ (e * e)) ∧
  F LProducer.q1C = LProducer.u (2 ^ (16 + e) - 2) ∧ F LProducer.z = [] ∧ F LProducer.x1 = [] ∧
  F LProducer.x2 = [] ∧ F LProducer.x3 = [] ∧
  ∃ g0 g1 : ETHParameterScaleMachineLogCopy.logMachine.Config,
    (∀ y, F (.inr (0, y)) = (ETHParameterScaleMachineLogCopy.afterLog (LProducer.u n) g0).stk y) ∧
    (∀ y, F (.inr (1, y)) = (ETHParameterScaleMachineLogCopy.afterLog (LProducer.u (L + 1)) g1).stk y) ∧
    (ETHParameterScaleMachineLogCopy.afterLog (LProducer.u n) g0).stk
      (ETHParameterScaleMachineLogCopy.logStack
        ETHParameterScaleMachineLogCopy.logMachine.output) = LProducer.u L ∧
    (ETHParameterScaleMachineLogCopy.afterLog (LProducer.u (L + 1)) g1).stk
      (ETHParameterScaleMachineLogCopy.logStack
        ETHParameterScaleMachineLogCopy.logMachine.output) = LProducer.u e

/-- The exact exit facts of `QProducer.q_run` (copied literally), with the log configuration named. -/
def QFacts (a b Δ n m L s w : ℕ) (F : QK → List Bool) : Prop :=
  ∃ c : ETHParameterScaleMachineLogCopy.logMachine.Config,
      F (.inl 0) = QProducer.u n ∧ F (.inl 1) = QProducer.u m ∧ F (.inl 2) = QProducer.u L ∧ F (.inl 3) = QProducer.u s ∧
      F (.inl 4) = QProducer.u w ∧ F (.inl 5) = QProducer.u 24 ∧ F (.inl 6) = QProducer.u (2 ^ 24) ∧ F (.inl 7) = QProducer.u (L * w) ∧
      F (.inl 8) = QProducer.u (L * w * s) ∧ F (.inl 9) = QProducer.u (L * w * s * 2 ^ 24) ∧ F (.inl 10) = QProducer.u 5 ∧
      F (.inl 11) = QProducer.u (QProducer.C0 L s w) ∧ F (.inl 12) = QProducer.u (2 * b * Δ) ∧ F (.inl 13) = QProducer.u ((QProducer.C0 L s w) * (2 * b * Δ)) ∧
      F (.inl 14) = [] ∧ F (.inl 15) = QProducer.u a ∧ F (.inl 16) = QProducer.u (a * m) ∧
      F (.inl 17) = QProducer.u ((a * m + QProducer.C0 L s w * (2 * b * Δ) * n - 1) % (a * m)) ∧ F (.inl 18) = QProducer.u (QProducer.A2 a b Δ n m L s w) ∧ F (.inl 19) = QProducer.u (6144 * b) ∧
      F (.inl 20) = [] ∧ F (.inl 21) = QProducer.u ((a - 1 + QProducer.C0 L s w * (6144 * b)) % a) ∧ F (.inl 22) = QProducer.u (QProducer.A3 a b L s w) ∧
      F (.inl 23) = QProducer.u (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) ∧ F (.inl 24) = QProducer.u (2 ^ Nat.clog 2 (max (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) (QProducer.A3 a b L s w))) ∧
      F (.inl 25) = [] ∧ F (.inl 26) = [] ∧ F (.inl 27) = [] ∧ F (.inl 28) = [] ∧
      (∀ y : QProducer.LS, F (.inr y) = (ETHParameterScaleMachineLogCopy.afterLog (QProducer.u (max (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) (QProducer.A3 a b L s w))) c).stk y) ∧
      (ETHParameterScaleMachineLogCopy.afterLog (QProducer.u (max (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) (QProducer.A3 a b L s w))) c).stk
          (ETHParameterScaleMachineLogCopy.logStack
            ETHParameterScaleMachineLogCopy.logMachine.output) = QProducer.u (Nat.clog 2 (max (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) (QProducer.A3 a b L s w))) ∧
      (ETHParameterScaleMachineLogCopy.afterLog (QProducer.u (max (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) (QProducer.A3 a b L s w))) c).stk (.inl 0) = QProducer.u (max (max (QProducer.C0 L s w) (QProducer.A2 a b Δ n m L s w)) (QProducer.A3 a b L s w))

theorem lq_run (a b Δ n m : ℕ) :
    ∃ t ≤ LProducer.lBd n + (2 * n + 2) + (2 * (Nat.clog 2 n) + 2) + (2 * (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) + 2) + (2 * (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) + 2) +
        QProducer.qBd a b Δ n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) + 5,
      ∃ vc, ∃ FL : LK → List Bool, ∃ FQ : QK → List Bool,
      ((advance (front a b Δ))^[t])
          (⟨some (frontStart a b Δ), frontCtl, J0 n m⟩ : TM2.Cfg (fun _ : J1 => Bool) _ _) =
        ⟨none, vc, Sum.elim FL (Sum.elim FQ (fun _ => []))⟩ ∧
      LFacts n FL ∧ QFacts a b Δ n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) FQ := by
  obtain ⟨t1, ht1, vc1, F1, hrun1, hL⟩ := LProducer.l_run n
  have hLF : LFacts n F1 := hL
  obtain ⟨hn, -, -, -, -, -, -, -, hs, -, hw, -, -, -, -, -, g0, g1', hr0, -, hout0, -⟩ := hL
  have hLc : F1 (LProducer.outR 0) = LProducer.u (Nat.clog 2 n) := (hr0 _).trans hout0
  have hn' : F1 (.inl 0) = List.replicate n true := hn
  have hLc' : F1 (.inr (0, ETHParameterScaleMachineLogCopy.logStack
      ETHParameterScaleMachineLogCopy.logMachine.output)) = List.replicate (Nat.clog 2 n) true := hLc
  have hs' : F1 (.inl 8) = List.replicate (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) true := hs
  have hw' : F1 (.inl 10) = List.replicate (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) true := hw
  have hA := BitMachineStackRun.run ιA (J0 n m) LProducer.lProg
    (⟨some LProducer.lStart, LProducer.lCtl, LProducer.L0 n⟩ : TM2.Cfg (fun _ : LK => Bool) _ _) t1
  rw [hrun1] at hA
  have hA0 : stackCfg ιA (J0 n m)
      (⟨some LProducer.lStart, LProducer.lCtl, LProducer.L0 n⟩ : TM2.Cfg (fun _ : LK => Bool) _ _) =
      ⟨some LProducer.lStart, LProducer.lCtl, J0 n m⟩ := by
    simp only [stackCfg]
    rw [bank_eq_self ιA (J0 n m) (LProducer.L0 n) (fun _ => rfl)]
  rw [hA0] at hA
  obtain ⟨B1, hB1⟩ : ∃ B, B = bank ιA (J0 n m) F1 := ⟨_, rfl⟩
  have hA' : ((advance pL)^[t1])
      (⟨some LProducer.lStart, LProducer.lCtl, J0 n m⟩ : TM2.Cfg (fun _ : J1 => Bool) _ _) =
      ⟨none, vc1, B1⟩ := by rw [hB1]; exact hA
  have b_l : ∀ x, B1 (.inl x) = F1 x := fun x => by rw [hB1]; exact bank_at ιA (J0 n m) F1 x
  have b_r : ∀ y, B1 (.inr y) = J0 n m (.inr y) := fun y => by
    rw [hB1]; exact bank_outside ιA _ _ _ (by rintro ⟨k, hk⟩; cases hk)
  have h1 := MatrixStage4ScalarPreparationOps.copy_run e1 B1 (by simp [e1, sc, b_r, J0])
  have l1 : (B1 (e1 0)).length = n := by
    simp [e1, lc, b_l, hn', LProducer.nC, LProducer.c]
  rw [l1] at h1
  obtain ⟨B2, hB2⟩ : ∃ B, B = Function.update B1 (e1 1) (B1 (e1 0) ++ B1 (e1 1)) := ⟨_, rfl⟩
  rw [← hB2] at h1
  have h2 := MatrixStage4ScalarPreparationOps.copy_run e2 B2 (by simp [hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_r, J0])
  have l2 : (B2 (e2 0)).length = (Nat.clog 2 n) := by
    simp [hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_l, hLc']
  rw [l2] at h2
  obtain ⟨B3, hB3⟩ : ∃ B, B = Function.update B2 (e2 1) (B2 (e2 0) ++ B2 (e2 1)) := ⟨_, rfl⟩
  rw [← hB3] at h2
  have h3 := MatrixStage4ScalarPreparationOps.copy_run e3 B3 (by simp [hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_r, J0])
  have l3 : (B3 (e3 0)).length = (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) := by
    simp [hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_l, hs']
  rw [l3] at h3
  obtain ⟨B4, hB4⟩ : ∃ B, B = Function.update B3 (e3 1) (B3 (e3 0) ++ B3 (e3 1)) := ⟨_, rfl⟩
  rw [← hB4] at h3
  have h4 := MatrixStage4ScalarPreparationOps.copy_run e4 B4 (by simp [hB4, hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_r, J0])
  have l4 : (B4 (e4 0)).length = (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) := by
    simp [hB4, hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_l, hw']
  rw [l4] at h4
  obtain ⟨B5, hB5⟩ : ∃ B, B = Function.update B4 (e4 1) (B4 (e4 0) ++ B4 (e4 1)) := ⟨_, rfl⟩
  rw [← hB5] at h4
  have hQ0 : bank ιB B5 (QProducer.Q0 n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1))))) = B5 := by
    apply bank_eq_self
    intro k
    rcases k with i | y
    · fin_cases i <;>
        simp [hB5, hB4, hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_l, b_r, J0, QProducer.Q0, hn', hLc', hs', hw', LProducer.u,
          QProducer.u]
    · simp [hB5, hB4, hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_r, J0, QProducer.Q0, Function.update_apply]
  obtain ⟨t6, ht6, vc6, c6, F6, hrun6, hQ⟩ := QProducer.q_run a b Δ n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1))))
  have hB := BitMachineStackRun.run ιB B5 (QProducer.qProg a b Δ)
    (⟨some (QProducer.qStart a b Δ), QProducer.qCtl, QProducer.Q0 n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1))))⟩ :
      TM2.Cfg (fun _ : QK => Bool) _ _) t6
  rw [hrun6] at hB
  have hB0 : stackCfg ιB B5
      (⟨some (QProducer.qStart a b Δ), QProducer.qCtl, QProducer.Q0 n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1))))⟩ :
        TM2.Cfg (fun _ : QK => Bool) _ _) = ⟨some (QProducer.qStart a b Δ), QProducer.qCtl, B5⟩ := by
    simp only [stackCfg]
    rw [hQ0]
  rw [hB0] at hB
  have hB' : ((advance (pQ a b Δ))^[t6])
      (⟨some (QProducer.qStart a b Δ), QProducer.qCtl, B5⟩ : TM2.Cfg (fun _ : J1 => Bool) _ _) =
      ⟨none, vc6, bank ιB B5 F6⟩ := hB
  obtain ⟨a2, ha2, R2⟩ := BitMachineRawSequence.runs pL (cp e1) LProducer.lStart BitMachineCopy.Label.scan
    LProducer.lCtl _ oc _ _ _ _ t1 (2 * n + 2) hA' h1
  obtain ⟨a3, ha3, R3⟩ := BitMachineRawSequence.runs f1 (cp e2) (leftLabel LProducer.lStart)
    BitMachineCopy.Label.scan g1 _ oc _ _ _ _ a2 (2 * (Nat.clog 2 n) + 2) R2 h2
  obtain ⟨a4, ha4, R4⟩ := BitMachineRawSequence.runs f2 (cp e3) (leftLabel (leftLabel LProducer.lStart))
    BitMachineCopy.Label.scan g2 _ oc _ _ _ _ a3 (2 * (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) + 2) R3 h3
  obtain ⟨a5, ha5, R5⟩ := BitMachineRawSequence.runs f3 (cp e4)
    (leftLabel (leftLabel (leftLabel LProducer.lStart))) BitMachineCopy.Label.scan g3 _ oc _ _ _ _ a4
    (2 * (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) + 2) R4 h4
  obtain ⟨a6, ha6, R6⟩ := BitMachineRawSequence.runs f4 (pQ a b Δ)
    (leftLabel (leftLabel (leftLabel (leftLabel LProducer.lStart)))) (QProducer.qStart a b Δ) g4 _
    QProducer.qCtl _ _ _ _ a5 t6 R5 hB'
  have hfin : bank ιB B5 F6 = Sum.elim F1 (Sum.elim F6 (fun _ => [])) := by
    funext x
    rcases x with x | (y | f)
    · rw [bank_outside ιB _ _ _ (by rintro ⟨k, hk⟩; cases hk)]
      simp [hB5, hB4, hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_l]
    · exact bank_at ιB B5 F6 y
    · rw [bank_outside ιB _ _ _ (by rintro ⟨k, hk⟩; cases hk)]
      have hf : f = 0 := Subsingleton.elim _ _
      subst hf
      simp [hB5, hB4, hB3, hB2, Function.update_apply, e1, e2, e3, e4, lc, qc, sc, ιB, LProducer.outR, LProducer.nC, LProducer.sC, LProducer.wC, LProducer.c, b_r, J0]
  rw [hfin] at R6
  refine ⟨a6, ?_, _, F1, F6, R6, hLF, c6, hQ⟩
  generalize LProducer.lBd n = LB at *
  generalize QProducer.qBd a b Δ n m (Nat.clog 2 n) (2 ^ (16 + (Nat.clog 2 ((Nat.clog 2 n) + 1)))) (2 ^ ((Nat.clog 2 ((Nat.clog 2 n) + 1)) * (Nat.clog 2 ((Nat.clog 2 n) + 1)))) = QB at *
  omega

end

#print axioms lq_run

end Paper2.CountFront
