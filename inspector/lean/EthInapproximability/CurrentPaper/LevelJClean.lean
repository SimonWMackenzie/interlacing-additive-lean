import EthInapproximability.CurrentPaper.LevelJPersist
import EthInapproximability.CurrentPaper.WeightedLevel0Clean

/-! Lane owner:b-weighted-level-8, unit 2, segment 2d, piece 3 (GENERATED by `gen_levelj_clean.py`):
owner-4's `level0_clean` at an ARBITRARY level: ONE fixed program `cleanJProgram` = owner-3 `p2`
; one charged handoff ; owner-4's charged clear `WeightedRawWords.clearProgram clearCells` of
every non-persistent cell (the scalar region outside `keepS`, the `save` region, master `N`),
started from the installed-words bank `C1j`. Exit bank EXACT:
`cleared clearCells (levelRowsBankJ …)`, with `levelFactsJ` for the same scratch `F, Q, P`.
Unlike level 0 (where the start bank is blank on the cleared cells), the installed words sit in
cleared cells at the start, so the clear is charged through `run_growth` of the SAME `p2` run
PLUS the start-bank lengths `∑ (C1j … (clearCells i)).length` (explicit in the clock).
`boundJ` is the literal clock of `LevelJRows.level_rows_j`. -/

namespace EthInapproximability.CurrentPaper.LevelJClean

open Turing BitMachineEncoding BitMachineStackEmbedding
open EthInapproximability.ParameterizedNP.GuardedSourceGraph
open WeightedLevel0Rows WeightedLevel0Persist WeightedLevel0Clean LevelJRows LevelJPersist

noncomputable section

set_option maxHeartbeats 8000000
set_option maxRecDepth 8192
set_option synthInstance.maxSize 200000
set_option synthInstance.maxHeartbeats 2000000

variable {V E : Type} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]

/-- The clock of `level_rows_j` (literal copy). -/
def boundJ (G : EndpointGraph V E) (c b y i : ℕ) (Mx : Iteration.Matrix) : ℕ :=
  (WeightedLevelFields15.publicBound15 (Iteration.stepParameters G c b y i Mx) (EncodedETHSource.serializeGraph G) (Fintype.card E) WeightedRawWords.noW (Parameters.firstExponent (Iteration.stepParameters G c b y i Mx)) (Parameters.bins (Iteration.stepParameters G c b y i Mx)) (ParameterizedNP.GuardedSourceSlab.q2 G (Parameters.bins (Iteration.stepParameters G c b y i Mx))) (PrimeSampler.size (ParameterizedNP.GuardedSourceSlab.q2 G (Parameters.bins (Iteration.stepParameters G c b y i Mx))) (Parameters.balanceOrder (Iteration.stepParameters G c b y i Mx)) (Construction.qOne (Parameters.firstExponent (Iteration.stepParameters G c b y i Mx)) * (Iteration.stepParameters G c b y i Mx).rows)) (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).binBase (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).rawWidth (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).s) +
        (9 * (BitMachineStackGrowth.perStep WeightedLevelFields15.program * (WeightedLevelFields15.publicBound15 (Iteration.stepParameters G c b y i Mx) (EncodedETHSource.serializeGraph G) (Fintype.card E) WeightedRawWords.noW (Parameters.firstExponent (Iteration.stepParameters G c b y i Mx)) (Parameters.bins (Iteration.stepParameters G c b y i Mx)) (ParameterizedNP.GuardedSourceSlab.q2 G (Parameters.bins (Iteration.stepParameters G c b y i Mx))) (PrimeSampler.size (ParameterizedNP.GuardedSourceSlab.q2 G (Parameters.bins (Iteration.stepParameters G c b y i Mx))) (Parameters.balanceOrder (Iteration.stepParameters G c b y i Mx)) (Construction.qOne (Parameters.firstExponent (Iteration.stepParameters G c b y i Mx)) * (Iteration.stepParameters G c b y i Mx).rows)) (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).binBase (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).rawWidth (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).s)) + 9 + 2) +
        WeightedRowFields.rowTime (Fintype.card V) (4 * Iteration.s G c b y i Mx) (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).nb (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).stagePrefixRows (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).rx (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).binBase (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).rawWidth (ProtectedFullBankBridgeScratch.actualD G c b y i Mx).uniform + 2

/-- The fixed program: `p2` ; one charged handoff ; the clear. -/
def cleanJProgram :=
  BitMachineRawSequence.program p2 (WeightedRawWords.clearProgram clearCells)
    (0 : Fin (nClear + 2)) (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)) ((), none)

theorem level_clean_j (G : EndpointGraph V E) (c b y i : ℕ) (Mx : Iteration.Matrix)
    (mS : WeightedRawWords.Aux → List Bool)
    (hV : mS (.w 7) = List.replicate (Fintype.card V) true) (hN : ∀ m, mS (.nat 3 m) = []) :
    ∃ F : ETHBinsJoinedScratch.Stack → List Bool,
    ∃ Q : WeightedGraphQJoined.Stack → List Bool,
    ∃ P : ChosenPrimeRaw.Stack → List Bool,
    ∃ t ≤ boundJ G c b y i Mx +
        ((∑ k : Fin nClear, (C1j G c b y i Mx mS (clearCells k)).length) +
          nClear * (BitMachineStackGrowth.perStep p2 * boundJ G c b y i Mx) + nClear + 2) + 1,
      ((advance cleanJProgram)^[t])
        ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan))))))), ((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)), C1j G c b y i Mx mS⟩ =
        ⟨none, ((WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), ((), none)),
          BitMachineClearBank.cleared clearCells (levelRowsBankJ G c b y i Mx mS F Q P)⟩ ∧
      levelFactsJ G c b y i Mx mS F Q P := by
  obtain ⟨F, Q, P, t0, ht0, hrun, hfacts⟩ := level_rows_persist_j G c b y i Mx mS hV hN
  have ht0' : t0 ≤ boundJ G c b y i Mx := ht0
  have grow : ∀ k, (levelRowsBankJ G c b y i Mx mS F Q P (clearCells k)).length ≤
      (C1j G c b y i Mx mS (clearCells k)).length +
        BitMachineStackGrowth.perStep p2 * boundJ G c b y i Mx := by
    intro k
    have h := BitMachineStackGrowth.run_growth p2
      ⟨some (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel (BitMachineRawSequence.leftLabel BitMachineCopy.Label.scan)))))), (WeightedLevelFields15.initialControl, (((), none), WeightedRowFields.rowInit)), C1j G c b y i Mx mS⟩ t0 (clearCells k)
    rw [hrun] at h
    dsimp only at h
    have hm := Nat.mul_le_mul_left (BitMachineStackGrowth.perStep p2) ht0'
    omega
  have hsum : (∑ k, (levelRowsBankJ G c b y i Mx mS F Q P (clearCells k)).length) ≤
      (∑ k : Fin nClear, (C1j G c b y i Mx mS (clearCells k)).length) +
        nClear * (BitMachineStackGrowth.perStep p2 * boundJ G c b y i Mx) := by
    calc (∑ k, (levelRowsBankJ G c b y i Mx mS F Q P (clearCells k)).length)
        ≤ ∑ k : Fin nClear, ((C1j G c b y i Mx mS (clearCells k)).length +
            BitMachineStackGrowth.perStep p2 * boundJ G c b y i Mx) :=
          Finset.sum_le_sum (fun k _ => grow k)
      _ = _ := by
          rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
            smul_eq_mul]
  have s2 := WeightedRawWords.clear_run clearCells clearCells_inj
    (levelRowsBankJ G c b y i Mx mS F Q P)
  obtain ⟨v, hv, q⟩ := BitMachineRawSequence.runs p2
    (WeightedRawWords.clearProgram clearCells) _ _ _ _ _ _
    (C1j G c b y i Mx mS) (levelRowsBankJ G c b y i Mx mS F Q P)
    (BitMachineClearBank.cleared clearCells (levelRowsBankJ G c b y i Mx mS F Q P)) _ _ hrun s2
  refine ⟨F, Q, P, v, ?_, q, hfacts⟩
  generalize (∑ k, (levelRowsBankJ G c b y i Mx mS F Q P (clearCells k)).length) = S at hsum hv
  generalize (∑ k : Fin nClear, (C1j G c b y i Mx mS (clearCells k)).length) = S0 at hsum ⊢
  generalize nClear * (BitMachineStackGrowth.perStep p2 * boundJ G c b y i Mx) = X at hsum ⊢
  omega

#print axioms level_clean_j

end
end EthInapproximability.CurrentPaper.LevelJClean
