/-- A bank all of whose cells are unary words. -/
def uBank (v : LStack → ℕ) : LStack → List Bool := fun i => List.replicate (v i) true

theorem uBank_update (v : LStack → ℕ) (c : LStack) (n : ℕ) :
    Function.update (uBank v) c (List.replicate n true) = uBank (Function.update v c n) := by
  funext i
  by_cases h : i = c
  · subst h; simp [uBank]
  · simp [uBank, h]

theorem copyE_stage (ι : Fin 3 ↪ LStack) (v : LStack → ℕ) (r : ℕ)
    (hr : v (ι 0) = r) (h1 : v (ι 1) = 0) (h2 : v (ι 2) = 0) :
    ((advance (copyProgram ι))^[2 * r + 2])
      (⟨some .scan, none, uBank v⟩ : TM2.Cfg (fun _ : LStack => Bool)
        BitMachineCopy.Label (Option Bool)) =
      ⟨none, none, uBank (Function.update v (ι 1) r)⟩ := by
  have h := copy_run ι (uBank v) (by simp [uBank, h2])
  rw [show (uBank v (ι 0)).length = r by simp [uBank, hr]] at h
  rw [h, show uBank v (ι 0) ++ uBank v (ι 1) = List.replicate r true by
    simp [uBank, hr, h1], uBank_update]

theorem copyA_stage (ι : Fin 3 ↪ LStack) (v : LStack → ℕ) (r o : ℕ)
    (hr : v (ι 0) = r) (h1 : v (ι 1) = o) (h2 : v (ι 2) = 0) :
    ((advance (copyProgram ι))^[2 * r + 2])
      (⟨some .scan, none, uBank v⟩ : TM2.Cfg (fun _ : LStack => Bool)
        BitMachineCopy.Label (Option Bool)) =
      ⟨none, none, uBank (Function.update v (ι 1) (r + o))⟩ := by
  have h := copy_run ι (uBank v) (by simp [uBank, h2])
  rw [show (uBank v (ι 0)).length = r by simp [uBank, hr]] at h
  rw [h, show uBank v (ι 0) ++ uBank v (ι 1) = List.replicate (r + o) true by
    simp only [uBank, hr, h1, List.replicate_append_replicate], uBank_update]

theorem mul_stage (ι : Fin 6 ↪ LStack) (v : LStack → ℕ) (r w : ℕ)
    (hr : v (ι 0) = r) (hw : v (ι 1) = w) (h2 : v (ι 2) = 0) (h3 : v (ι 3) = 0)
    (h4 : v (ι 4) = 0) (h5 : v (ι 5) = 0) :
    ((advance (multiplyProgram ι))^[MatrixAddressMachine.exactTime r w 0])
      (⟨some .outer, false, uBank v⟩ : TM2.Cfg (fun _ : LStack => Bool)
        MatrixAddressMachine.Label Bool) =
      ⟨none, false, uBank (Function.update v (ι 5) (r * w))⟩ := by
  have h := multiply_run ι (uBank v) r w (by simp [uBank, hr]) (by simp [uBank, hw])
    (by simp [uBank, h2]) (by simp [uBank, h3]) (by simp [uBank, h4])
  rw [h, show uBank v (ι 5) = [] by simp [uBank, h5], List.append_nil, uBank_update]

theorem const_stage (c : LStack) (n : ℕ) (v : LStack → ℕ) (hc : v c = 0) :
    ((advance (SourceClauseFixedUnary.program c n))^[n + 1])
      (⟨some (0 : SourceClauseFixedUnary.Label n), (), uBank v⟩ :
        TM2.Cfg (fun _ : LStack => Bool) (SourceClauseFixedUnary.Label n) Unit) =
      ⟨none, (), uBank (Function.update v c n)⟩ := by
  have h := SourceClauseFixedUnary.run_from c (uBank v) (0 : SourceClauseFixedUnary.Label n)
    n (by simp) (uBank v c)
  have hs : SourceClauseFixedUnary.state c (uBank v) (0 : SourceClauseFixedUnary.Label n)
      (uBank v c) = ⟨some 0, (), uBank v⟩ := by
    simp [SourceClauseFixedUnary.state]
  rw [hs] at h
  rw [h, show uBank v c = [] by simp [uBank, hc], List.append_nil, uBank_update]

def clear1 (c : LStack) := WeightedRawWords.clearProgram (fun _ : Fin 1 => c)

theorem clear_stage (c : LStack) (v : LStack → ℕ) (x : ℕ) (hx : v c = x) :
    ((advance (clear1 c))^[x + 3])
      (⟨some 0, ((), none), uBank v⟩ :
        TM2.Cfg (fun _ : LStack => Bool) (Fin (1 + 2)) (Unit × Option Bool)) =
      ⟨none, ((), none), uBank (Function.update v c 0)⟩ := by
  have h := WeightedRawWords.clear_run (fun _ : Fin 1 => c) (fun a b _ => Subsingleton.elim a b)
    (uBank v)
  have hsum : (∑ i : Fin 1, (uBank v ((fun _ : Fin 1 => c) i)).length) + 1 + 2 = x + 3 := by
    simp [uBank, hx]
  rw [hsum] at h
  rw [clear1, h]
  congr 2
  funext j
  unfold BitMachineClearBank.cleared
  by_cases hj : c = j
  · subst hj
    simp [uBank]
  · have hne : ¬ ∃ _ : Fin 1, c = j := fun ⟨_, h⟩ => hj h
    rw [if_neg hne]
    simp [uBank, Ne.symm hj]

