/-- Start bank: the nine unary inputs, every new cell blank. -/
def B0 (n a am bd b6 s w L Q : ℕ) : AK → List Bool :=
  Sum.elim ![u n, u a, u am, u bd, u b6, u s, u w, u L, u Q] (fun _ => [])
def B1 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B0 n a am bd b6 s w L Q) (Sum.inr 0 : AK) (u ((a) * (am)))
def B2 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B1 n a am bd b6 s w L Q) (Sum.inr 1 : AK) (u ((bd) * (n)))
def B3 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B2 n a am bd b6 s w L Q) (Sum.inr 2 : AK) (u ((a) * (bd * n)))
def B4 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B3 n a am bd b6 s w L Q) (Sum.inr 3 : AK) (u ((b6) * (am)))
def B5 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B4 n a am bd b6 s w L Q) (Sum.inr 4 : AK) (u (max (a * am) (a * (bd * n))))
def B6 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B5 n a am bd b6 s w L Q) (Sum.inr 5 : AK) (u (max (max (a * am) (a * (bd * n))) (b6 * am)))
def B7 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B6 n a am bd b6 s w L Q) (Sum.inr 6 : AK) (u (65536))
def B8 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B7 n a am bd b6 s w L Q) (Sum.inr 7 : AK) (u ((65536) * (s)))
def B9 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B8 n a am bd b6 s w L Q) (Sum.inr 8 : AK) (u ((65536 * s) * (max (max (a * am) (a * (bd * n))) (b6 * am))))
def B10 (n a am bd b6 s w L Q : ℕ) : AK → List Bool := Function.update (B9 n a am bd b6 s w L Q) (Sum.inr 9 : AK) (u (16))
