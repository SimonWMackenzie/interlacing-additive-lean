import CurrentAdditive.CylinderConjunctionMachine

/-! The literal comparison-bit fold as one ordinary machine. This consumes
the bits actually generated by the contextual pair tester. -/

namespace CurrentAdditive.CylinderEvalConjunction

open EthInapproximability.CurrentPaper
open EthInapproximability.CurrentPaper.BitMachineEncoding
open CurrentAdditive.CylinderConjunctionMachine

noncomputable def machine : BitMachine.Machine :=
  ofFinite (0 : Fin 2) 1 .scan ((true,none) : Control) program

theorem outputs (bits : List Bool) :
    machine.OutputsWithin bits [conjunction true bits] (bits.length+1) := by
  have hinit : rawInit (0 : Fin 2) .scan ((true,none) : Control) bits=
      cfg (some .scan) (true,none) bits [] := by
    unfold rawInit cfg
    congr 1
  apply outputsWithin_of_raw_run (0 : Fin 2) 1 .scan ((true,none) : Control)
    program bits [conjunction true bits] (bits.length+1) (bits.length+1) le_rfl
  · change (run (bits.length+1) _).l=none
    rw [hinit,run_conjunction]
    rfl
  · change (run (bits.length+1) _).stk 1=[conjunction true bits]
    rw [hinit,run_conjunction]
    rfl

end CurrentAdditive.CylinderEvalConjunction

#print axioms CurrentAdditive.CylinderEvalConjunction.outputs
