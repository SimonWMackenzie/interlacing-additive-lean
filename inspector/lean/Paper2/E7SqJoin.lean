/-- The printed square header word, unfolded to the transport form (definitional). -/
theorem hwOfSq_eq (Φ : ValidFormula) (t' : (Sel D B Φ).Tape) :
    hwOfSq D B Φ t' =
      EncodedCommunication.natField (2 * (Sel D B Φ).budget + kOf Φ.val.variables) ++
        AFront.Projection.matrixWord (SquarePadding.side (Sel D B Φ).rows (Sel D B Φ).cols)
          (SquarePadding.side (Sel D B Φ).rows (Sel D B Φ).cols)
          (MatrixMaterialization.rowMajor
            (Paper2.ASquare.squareFun (Sel D B Φ).rows (Sel D B Φ).cols ((Sel D B Φ).table t').bits)) := by
  simp only [hwOfSq, sqInst, Paper2.HeaderWordRun.headeredWord, Paper2.HeaderWordRun.matrix,
    Paper2.ASquare.squareInstance, EncodedSelectedOutput.selectedInstance,
    EncodedSelectedOutput.instanceOf]

