/-- The dims inputs at level `j`. -/
abbrev dxJ (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) : NextDimsMachineTN.DimIn :=
  NextDimsEmbedTN.dimsIn ((Pj G c b yb j Mx)) (Fintype.card V)
    (Parameters.bins ((Pj G c b yb j Mx)) * EffectiveIteration.familySize ((Pj G c b yb j Mx)))

theorem PJ_fields (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) :
    ((Pj G c b yb j Mx)).edges = Fintype.card E ∧ ((Pj G c b yb j Mx)).nextDepth = b ∧
      ((Pj G c b yb j Mx)).sourceConstant = c := ⟨rfl, rfl, rfl⟩

theorem S2J_wcell (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix) (mS : WeightedRawWords.Aux → List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (k : Fin 64) (hk : k ≠ 22) :
    S2J G c b yb j Mx mS F Q P (wcell k) =
      G4 (levelRowsBankJ G c b (yb) j (Mx) mS F Q P) (Sum.inl (wc k)) := by
  dsimp only [S2J]
  rw [Function.update_of_ne (wcell_ne_mcell k .Y)]
  exact S22J_wcell G c b yb j Mx mS F Q P k hk

/-- The dims machine's start bank shows through `dimsEmb` in the cost-updated level-`j` bank. -/
theorem level_dims_inputs_j (G : EndpointGraph V E) (c b yb j : ℕ) (Mx : Iteration.Matrix)
    (mS : WeightedRawWords.Aux → List Bool)
    (hmC : mS .C = List.replicate c true) (hmB : mS .B = List.replicate b true)
    (hmE : mS .E = List.replicate (Fintype.card E) true) (mw : List Bool)
    (F : ETHBinsJoinedScratch.Stack → List Bool)
    (Q : WeightedGraphQJoined.Stack → List Bool) (P : ChosenPrimeRaw.Stack → List Bool)
    (hf : levelFactsJ G c b (yb) j (Mx) mS F Q P) (y : NextDimsStages.DS 64) :
    ext4 (S2J G c b yb j Mx mS F Q P) (Dmw mw) (dimsEmb y) =
      NextDimsStages.U (NextDimsMachineTN.S0 (dxJ G c b yb j Mx)) y := by
  obtain ⟨w16, w17, w18, w27⟩ := writer_j G c b (yb) j (Mx) mS F Q P hf
  rcases y with ⟨k, hk⟩ | l
  · by_cases h9 : k < 9
    · have hm : dimsEmb (.inl ⟨k, hk⟩) = .inl (.inl (dsrc ⟨k, h9⟩)) := by
        show dimsMap (.inl ⟨k, hk⟩) = _
        simp only [dimsMap, dif_pos h9]
      rw [hm]
      show S2J G c b yb j Mx mS F Q P (dsrc ⟨k, h9⟩) = NextDimsStages.U _ (NextDimsStages.cell ⟨k, hk⟩)
      rw [NextDimsStages.U_cell]
      interval_cases k
      · show S2J G c b yb j Mx mS F Q P (oc oIn) = _
        rw [S0_0]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        dsimp only [S2J]
        rw [Function.update_of_ne (by intro e; cases e), S22J_oIn]
      · show S2J G c b yb j Mx mS F Q P (wcell 28) = _
        rw [S0_1]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        rw [S2J_wcell G c b yb j Mx mS F Q P 28 (by decide)]
        exact writer28_j G c b (yb) j (Mx) mS F Q P hf
      · show S2J G c b yb j Mx mS F Q P (mcell .E) = _
        rw [S0_2]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        dsimp only [S2J]
        rw [Function.update_of_ne (mcell_Y_ne .E (by decide)), (PJ_fields G c b yb j Mx).1,
          S22J_master G c b yb j Mx mS F Q P .E (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
        exact hmE
      · show S2J G c b yb j Mx mS F Q P (wcell 27) = _
        rw [S0_3]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        rw [S2J_wcell G c b yb j Mx mS F Q P 27 (by decide)]
        exact w27
      · show S2J G c b yb j Mx mS F Q P (mcell .B) = _
        rw [S0_4]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        dsimp only [S2J]
        rw [Function.update_of_ne (mcell_Y_ne .B (by decide)), (PJ_fields G c b yb j Mx).2.1,
          S22J_master G c b yb j Mx mS F Q P .B (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
        exact hmB
      · show S2J G c b yb j Mx mS F Q P (mcell .C) = _
        rw [S0_5]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        dsimp only [S2J]
        rw [Function.update_of_ne (mcell_Y_ne .C (by decide)), (PJ_fields G c b yb j Mx).2.2,
          S22J_master G c b yb j Mx mS F Q P .C (by intro h; cases h) (by intro h; cases h) (by intro m h; cases h)]
        exact hmC
      · show S2J G c b yb j Mx mS F Q P (wcell 18) = _
        rw [S0_6]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        rw [S2J_wcell G c b yb j Mx mS F Q P 18 (by decide)]
        exact w18
      · show S2J G c b yb j Mx mS F Q P (wcell 17) = _
        rw [S0_7]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        rw [S2J_wcell G c b yb j Mx mS F Q P 17 (by decide)]
        exact w17
      · show S2J G c b yb j Mx mS F Q P (wcell 16) = _
        rw [S0_8]
        simp only [dxJ, NextDimsEmbedTN.dimsIn]
        rw [S2J_wcell G c b yb j Mx mS F Q P 16 (by decide)]
        exact w16
    · have hm : dimsEmb (.inl ⟨k, hk⟩) = .inr ⟨k - 9, by omega⟩ := by
        show dimsMap (.inl ⟨k, hk⟩) = _
        simp only [dimsMap, dif_neg h9]
      rw [hm]
      have h55 : (⟨k - 9, by omega⟩ : Fin 57) ≠ 55 := by
        intro e
        have := congrArg Fin.val e
        simp only [Fin.val_ofNat] at this
        omega
      show Dmw mw ⟨k - 9, _⟩ = NextDimsStages.U _ (NextDimsStages.cell ⟨k, hk⟩)
      rw [Dmw_other mw _ h55, NextDimsStages.U_cell, S0_tmp _ k hk h9] <;> rfl
  · show ([] : List Bool) = NextDimsStages.U _ (.inr l)
    rw [NextDimsStages.U_log]

